{%- comment -%}
  ms-preorder — förbeställningskortet direkt ovanför paketvalet och köpknappen.

  VARFÖR DET SER UT SÅ HÄR
  Produkten finns inte i lager och kan inte finnas det: varje kudde sys efter
  kundens egen bild. Det är produktens starkaste argument, inte dess svaghet —
  därför säger kortet det rakt ut i stället för att gömma väntetiden i
  finstilt. "Din kudde finns inte än" är sant, och det är också anledningen
  till att den blir hennes.

  NEDRÄKNINGEN
  Räknar mot en RIKTIG deadline: samma tidpunkt för alla besökare, i svensk
  tid, satt av när ordrarna faktiskt går iväg till fabriken (data-veckodag /
  data-timme). Den får aldrig byggas om till en timer som startar om vid varje
  sidladdning — då är deadlinen påhittad, och en påhittad tidsgräns som ska
  pressa fram ett snabbt köp står på svarta listan i marknadsföringslagen
  (bilaga I till direktiv 2005/29/EG, punkt 7). Den är dessutom onödig: en
  äkta veckodeadline visar timmar och sekunder ändå större delen av veckan.

  FÖRUTSÄTTNING SOM MÅSTE HÅLLAS SANN
  Texten lovar att beställningar före deadline går i veckans sömnadsomgång.
  Det stämmer bara så länge ordrarna faktiskt skickas till leverantören en
  gång i veckan vid den tidpunkten. Ändras rutinen ska siffrorna nedan ändras
  samma dag.

  Sömnaden är den visuella idén: kortets kant är en stygnrad och de tre stegen
  sitter på en tråd. Ingen lagerräknare, inga påhittade siffror.

  Parametrar:
    del  'kort' (standard) = hela kortet
         'not'             = den lilla raden under köpknappen
{%- endcomment -%}
{%- liquid
  assign vilken = del | default: 'kort'
  assign stang_veckodag = 0
  assign stang_timme = 23
  assign stang_namn = 'söndag 23.00'
-%}

{%- if vilken == 'not' -%}
  <p class="ms-scope ms-pre__not">
    {% render 'ms-icon', name: 'shield' %}
    <span>Du betalar i dag. Vi syr först när du godkänt ditt utkast.</span>
  </p>

{%- else -%}
  <div class="ms-scope ms-pre">
    <span class="ms-pre__flagga">
      {% render 'ms-icon', name: 'sparkle' %}
      Förbeställning
    </span>

    <p class="ms-pre__rubrik">Din kudde finns inte än.<br>Vi syr den åt dig.</p>
    <p class="ms-pre__ing">
      Inget lager, ingen hylla, ingen slumpad kudde ur en låda. Din börjar
      existera först när du sagt ja till utkastet.
    </p>

    <ms-omgang class="ms-omg"
      data-veckodag="{{ stang_veckodag }}"
      data-timme="{{ stang_timme }}">
      <p class="ms-omg__etikett">
        {% render 'ms-icon', name: 'clock' %}
        Veckans sömnadsomgång stänger om
      </p>
      {%- comment -%}
        Reservtexten är den som syns utan JavaScript — den säger samma sak,
        bara utan sekunder.
      {%- endcomment -%}
      <p class="ms-omg__klocka" data-ms-omg-klocka>{{ stang_namn }}</p>
      <p class="ms-omg__under">
        Beställer du efter det syr vi din kudde i nästa omgång —
        <strong>en vecka senare</strong>.
      </p>
    </ms-omgang>

    <ol class="ms-pre__spar">
      <li class="ms-pre__steg ms-pre__steg--nu">
        <span class="ms-pre__punkt">1</span>
        <span class="ms-pre__namn">Du förbeställer</span>
        <span class="ms-pre__und">i dag</span>
      </li>
      <li class="ms-pre__steg">
        <span class="ms-pre__punkt">2</span>
        <span class="ms-pre__namn">Du godkänner</span>
        <span class="ms-pre__und">innan en enda söm</span>
      </li>
      <li class="ms-pre__steg">
        <span class="ms-pre__punkt">3</span>
        <span class="ms-pre__namn">Vi syr och skickar</span>
        <span class="ms-pre__und">fri frakt</span>
      </li>
    </ol>

    <div class="ms-pre__datum">
      {% render 'ms-delivery-estimate',
         min_days: 8, max_days: 12, cutoff_hour: 0,
         text: 'Hemma hos dig' %}
    </div>
  </div>

  <script>
    /* Nedräkning till nästa riktiga stängning, räknad i svensk tid oavsett
       var besökaren sitter. Samma sluttid för alla — den får aldrig utgå
       från när sidan öppnades. */
    (function () {
      if (window.customElements && customElements.get('ms-omgang')) return;

      class MsOmgang extends HTMLElement {
        connectedCallback() {
          this.klocka = this.querySelector('[data-ms-omg-klocka]');
          if (!this.klocka) return;
          this.veckodag = parseInt(this.dataset.veckodag, 10) || 0;
          this.timme = parseInt(this.dataset.timme, 10) || 23;
          this.rita();
          this.timer = setInterval(() => this.rita(), 1000);
        }

        disconnectedCallback() {
          clearInterval(this.timer);
        }

        /* Besökarens klocka kan stå var som helst i världen. Vi flyttar den
           till svensk tid, räknar fram nästa stängning där, och flyttar
           tillbaka — annars stänger omgången på olika tider i olika länder. */
        nastaStangning() {
          const nu = new Date();
          const svensk = new Date(nu.toLocaleString('en-US', { timeZone: 'Europe/Stockholm' }));
          const skillnad = nu.getTime() - svensk.getTime();

          const mal = new Date(svensk);
          mal.setHours(this.timme, 0, 0, 0);
          let dagar = (this.veckodag - svensk.getDay() + 7) % 7;
          if (dagar === 0 && svensk.getTime() >= mal.getTime()) dagar = 7;
          mal.setDate(mal.getDate() + dagar);

          return new Date(mal.getTime() + skillnad);
        }

        rita() {
          const kvar = this.nastaStangning().getTime() - Date.now();
          /* nastaStangning() rullar alltid fram till nästa vecka när tiden
             passerats, så kvar är normalt positiv. Skulle den ändå bli det
             inte, låt förra siffran stå kvar hellre än att visa minustid. */
          if (kvar <= 0) return;

          const s = Math.floor(kvar / 1000) % 60;
          const m = Math.floor(kvar / 60000) % 60;
          const h = Math.floor(kvar / 3600000) % 24;
          const d = Math.floor(kvar / 86400000);
          const tva = (n) => String(n).padStart(2, '0');

          this.klocka.textContent = d > 0
            ? d + (d === 1 ? ' dag ' : ' dagar ') + h + ' tim ' + tva(m) + ' min'
            : tva(h) + ':' + tva(m) + ':' + tva(s);

          /* Tonen skärps när det faktiskt är bråttom — inte tidigare. */
          this.classList.toggle('ms-omg--brad', kvar < 12 * 3600000);
          this.classList.toggle('ms-omg--sist', kvar < 2 * 3600000);
        }
      }

      customElements.define('ms-omgang', MsOmgang);
    })();
  </script>
{%- endif -%}
