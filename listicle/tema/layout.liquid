{%- comment -%}
  layout/listicle.liquid — skrivs av listicle/butik.mjs (repot yognftnfgn), ändra inte här.

  En ren sida utan header, footer och meny: listicle-landningssidorna ska se ut
  som en fristående artikel (Axels beslut 2026-09-16, ersätter GemPages).
  {{ content_for_header }} behålls — där ligger Shopifys egna skript: pixlarna
  (Meta via Facebook-kanalen), kundens integritetsval och analytics. Temats
  CSS och JS laddas INTE; sidans egen stil ligger i assets/listicle.css.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <title>{{ page_title }}</title>
  {%- comment -%}
    Meta-beskrivningen härleder Shopify ur sidans innehåll, så prisplatserna
    [[PRIS]]/[[JAMFORPRIS]] följer med hit (mätt 2026-09-17 på carashell.com:
    kroppen var bytt av sidmallen, beskrivningen inte). Samma uppslag som i
    templates/page.listicle.liquid: handlen ur data-lp-produkt i innehållet.
  {%- endcomment -%}
  {%- assign lp_beskrivning = page_description -%}
  {%- if lp_beskrivning contains '[[PRIS]]' or lp_beskrivning contains '[[JAMFORPRIS]]' -%}
    {%- assign lp_delar = page.content | split: 'data-lp-produkt="' -%}
    {%- if lp_delar.size > 1 -%}
      {%- assign lp_handle = lp_delar[1] | split: '"' | first -%}
      {%- assign lp_produkt = all_products[lp_handle] -%}
      {%- if lp_produkt.price -%}
        {%- assign lp_pris = lp_produkt.price | money_without_trailing_zeros -%}
        {%- assign lp_beskrivning = lp_beskrivning | replace: '[[PRIS]]', lp_pris -%}
        {%- if lp_produkt.compare_at_price > lp_produkt.price -%}
          {%- assign lp_jmf = lp_produkt.compare_at_price | money_without_trailing_zeros -%}
          {%- assign lp_beskrivning = lp_beskrivning | replace: '[[JAMFORPRIS]]', lp_jmf -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if lp_beskrivning -%}
    <meta name="description" content="{{ lp_beskrivning | escape }}">
  {%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;600;700&display=swap">
  {{ 'listicle.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="listicle-sida">
  {{ content_for_layout }}
</body>
</html>
