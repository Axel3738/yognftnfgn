{
  "mcpServers": {
    "loopia-mail": {
      "command": "node",
      "args": ["kundtjanst/mail-mcp.mjs"],
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "NODE_NO_WARNINGS": "1",
        "KUNDTJANST_MAIL_PASS_BAVERBUTIKEN": "${KUNDTJANST_MAIL_PASS_BAVERBUTIKEN:-}",
        "KUNDTJANST_MAIL_PASS_CARASHELL": "${KUNDTJANST_MAIL_PASS_CARASHELL:-}",
        "KUNDTJANST_MAIL_PASS_CATCABIN": "${KUNDTJANST_MAIL_PASS_CATCABIN:-}",
        "KUNDTJANST_MAIL_PASS_DRYTREK": "${KUNDTJANST_MAIL_PASS_DRYTREK:-}",
        "KUNDTJANST_MAIL_PASS_HEMVAKTEN": "${KUNDTJANST_MAIL_PASS_HEMVAKTEN:-}",
        "KUNDTJANST_MAIL_PASS_KALENDER": "${KUNDTJANST_MAIL_PASS_KALENDER:-}",
        "KUNDTJANST_MAIL_PASS_TACKLEBAY": "${KUNDTJANST_MAIL_PASS_TACKLEBAY:-}",
        "KUNDTJANST_MAIL_PASS_TANKGUARD": "${KUNDTJANST_MAIL_PASS_TANKGUARD:-}",
        "KUNDTJANST_MAIL_PASS_BEVERBUTIKKEN": "${KUNDTJANST_MAIL_PASS_BEVERBUTIKKEN:-}",
        "KUNDTJANST_MAIL_PASS_BAEVERBUTIKEN": "${KUNDTJANST_MAIL_PASS_BAEVERBUTIKEN:-}",
        "KUNDTJANST_MAIL_PASS_MAJAVAKAUPPA": "${KUNDTJANST_MAIL_PASS_MAJAVAKAUPPA:-}"
      }
    }
  }
}
