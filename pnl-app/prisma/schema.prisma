generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Krävs av @shopify/shopify-app-remix — en rad per installerad butik.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  /* Utgående offline-nycklar (obligatoriska för nya appar) förnyas med en
     refresh-token som sessionslagringen v10 förväntar sig kolumner för. */
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// Per-butiksinställningar. Skapas med defaults vid installation.
model ShopSettings {
  shop            String   @id
  /// Tull per ORDER (inte per styck) i butikens valuta. Databasens default
  /// är 0 sedan 2026-09-26: 27,50 är Axels EU-tull i KRONOR och blev ett
  /// påhittat tal i alla andra valutor. afterAuth sätter 27,50 vid SKAPANDET
  /// av en SEK-butik (`startTull`), aldrig vid uppdatering.
  tariffPerOrder  Decimal  @default(0) @db.Decimal(10, 2)
  /// Transaktionsavgift som andel av totalt ordervärde. Sedan 2026-09-26
  /// gäller den omsättning UTAN faktiska avgifter: ordrar som inte gick genom
  /// Shopify Payments (PayPal, direkt-Klarna, manuellt) och dagar utan data.
  feeRate         Decimal  @default(0.029) @db.Decimal(6, 4)
  /// Shopifys egen avgift på ordrar som inte betalats med Shopify Payments
  /// (planens tredjepartsavgift), andel. Tas på omsättning som bevisligen
  /// gick via en annan betalväxel, ovanpå feeRate. 0 = ingen.
  thirdPartyFeeRate Decimal @default(0) @db.Decimal(6, 4)
  /// Målmarginal som max-CPA räknas mot.
  targetMargin    Decimal  @default(0.25) @db.Decimal(6, 4)
  /// ⚠ LEGACY sedan 2026-09-17: annonskontona bor i MetaAdAccount, en rad per
  /// konto. Fältet skrivs fortfarande som en spegel av det FÖRSTA kontot, för
  /// kod som ännu bara känner till ett konto (Meta-inloggningens spärr). Läs
  /// aldrig annonskostnad ur det — en butik med tre konton har tre rader.
  metaAdAccountId String?
  /// ⚠ LEGACY sedan 2026-09-17 — valutan bor på MetaAdAccount.currency, för
  /// två konton kan redovisa i olika valutor. Spegel av det första kontot.
  spendCurrency   String?
  /// Long-lived Meta-token. Kryptera i produktion — se lib/crypto.server.ts.
  metaAccessToken String?
  /// När Meta-token går ut. Känd bara för nycklar från Facebook-inloggningen
  /// (~60 dagar); null = okänd (manuellt inklistrad systemanvändar-token).
  metaTokenExpiresAt DateTime?
  /// "login" = via Logga in med Facebook, "manual" = inklistrad för hand.
  metaTokenSource String?
  /// När token senast sparades. Settings-sidan pollar det här värdet medan
  /// inloggningsfönstret är öppet — ändras det är inloggningen klar.
  metaTokenSavedAt DateTime?
  /// Senaste förnyelseförsöket i tokenvakten. Sex tjänster delar databasen;
  /// den som hinner sätta stämpeln gör anropet, de andra hoppar över.
  metaTokenRefreshAttemptAt DateTime?
  /// Namnet på Facebook-kontot som loggade in — så handlaren ser VEM som
  /// är kopplad, inte bara att något är det.
  metaUserName    String?
  /// Facebook-användarens app-scoped id. Återkallelse hos Meta gäller hela
  /// användaren, inte en butik — samma person på fem butiker får bara
  /// återkallas när den SISTA butiken kopplas bort.
  metaUserId      String?
  /// Meta-appen som utfärdade token. Tokenvakten förnyar bara med samma
  /// app — sex tjänster med handskrivna variabler kan glida isär.
  metaAppId       String?
  /// ⚠ LEGACY sedan 2026-09-17 — kampanjfiltret är per ANNONSKONTO och bor på
  /// MetaAdAccount. Kampanj-ID:n är kontospecifika: ett filter från ett konto
  /// matchar ingenting i ett annat. Speglar det första kontots filter.
  campaignMode    String   @default("all")
  campaignIds     String?
  currency        String   @default("SEK")
  /// Butikens tidszon. Cachad för att slippa ett GraphQL-anrop per sidladdning
  /// — den ändras i praktiken aldrig, men avgör vad "idag" betyder.
  timezone        String?
  /// Butikens namn som handlaren själv skrivit det ("Bäverbutikken"), läst ur
  /// shop { name }. Cachat: myshopify-handtaget ("1acuam-s5") säger ingenting
  /// för en människa, och gruppsummans tabell blev oläslig av tio sådana.
  shopName        String?
  /// UI-språk: "en" eller "sv". Engelska är standard för nya installationer
  /// (App Store-krav i praktiken); befintliga butiker migrerades till "sv".
  language        String   @default("en")
  /// Sätts när handlaren sparat inställningarna minst en gång. Skiljer
  /// "har granskat tull och avgifter" från "kör fortfarande på defaults".
  settingsSavedAt DateTime?
  /// Sätts när handlaren KVITTERAT tullen: ett tullbelopp ändrades i
  /// Inställningar, eller rutan "Tullbeloppen stämmer" kryssades i. Inte
  /// vid vilken sparning som helst — språkbyte eller en inklistrad
  /// Meta-nyckel stämplade förut tullen som granskad. Null = tullen är ett
  /// startvärde ingen tittat på.
  tariffConfirmedAt DateTime?
  /// Varianter (variantGid) handlaren sagt är GRATIS (gåvor, prover). Bara
  /// för dem räknas ett inköpspris på 0 som riktigt; alla andra nollor räknas
  /// som saknad kostnad i täckningen. Kolumn på ShopSettings, så shop/redact
  /// raderar den med raden.
  freeVariants    Json?
  /// Sätts när kom igång-checklistan dolts manuellt.
  setupDismissedAt DateTime?
  /// Butiker med samma groupId hör till samma ägare och får summeras ihop.
  /// Sätts bara genom att lösa in en kod från en butik man redan är inne i —
  /// aldrig automatiskt, hur gärna databasen än skulle kunna gissa rätt.
  groupId         String?
  /// Butikens plan under Shopify App Pricing: "standard" | "pro". Null =
  /// aldrig avläst. Läses ur currentAppInstallation.activeSubscriptions,
  /// cachas här och kontrolleras högst var 10:e minut (planCheckedAt).
  plan            String?
  planCheckedAt   DateTime?
  /// Kortet "Kommer du från Juicy?" på Kostnader-sidan har stängts.
  juicyCardDismissedAt DateTime?
  /// Horisont (dagar) som styr max-CPA på LTV-sidan. Null = 90.
  ltvHorizon      Int?
  /// Senaste lyckade bakfyllnad av KundOrder, och senaste felet i klartext.
  kundOrderBackfillAt    DateTime?
  kundOrderBackfillError String?
  /// Vinstmål per 30 dagar i butikens valuta — ringen i panelens hero-kort.
  /// Null = inget mål satt (ringen visar då bara vinsten).
  monthlyGoal     Decimal? @db.Decimal(12, 2)
  /// Uppskattad COGS i procent av priset för varianter UTAN inköpspris.
  /// Null = av (saknade kostnader räknas som gratis och flaggas). Alltid
  /// märkt "uppskattad" i panelen — aldrig tyst.
  cogsEstimatePct Int?
  /// Valutan handlaren skriver inköpspriser i på Kostnader-sidan ("USD").
  /// Beloppet räknas om till butikens valuta med dagens ECB-kurs när det
  /// sparas. Null = butikens valuta.
  costCurrency    String?
  /// Avgifter per marknad (landskod): { "US": { feeRate: 0.034, fxFeeRate: 0.02 } }.
  /// feeRate ersätter den generella transaktionsavgiften för marknaden,
  /// fxFeeRate är Shopify Payments valutaväxlingsavgift (tas ut när kunden
  /// betalar i en annan valuta än butikens). Marknader utan post använder
  /// feeRate ovan och ingen växlingsavgift.
  marketFees      Json?
  /// Googles refresh-token (krypterad). Satt = Google Ads är kopplat.
  /// Google ger access-token i en timme och refresh-token tills den
  /// återkallas, så det är den senare som sparas.
  googleRefreshToken String?
  /// När kopplingen gjordes — visas som "kopplad sedan" i Inställningar.
  googleTokenSavedAt DateTime?
  /// Google-kontot som kopplade, för igenkänning i UI:t. Aldrig mer än så.
  googleEmail        String?
  /// Handlarens EGEN Claude-nyckel (krypterad). Satt = appens AI-funktioner
  /// kör på butikens konto i stället för serverns. Null = serverns nyckel
  /// används, och saknas den är AI-funktionerna dolda.
  anthropicApiKey String?
  /// När nyckeln sparades — visas som "kopplad sedan" i Inställningar.
  anthropicKeySavedAt DateTime?
  /// Ser butiken ordrar äldre än 60 dagar? Utan read_all_orders svarar
  /// Shopify TOMT för dem — inte med fel — och en tom hämtning får aldrig
  /// skriva nollor över riktiga dagar. Sätts av sonden `harFullOrderhistorik`
  /// (en order äldre än idag − 61 syns = true). Null = aldrig sonderad, då
  /// gäller horisonten idag − 59. Se app/lib/historik.ts.
  fullOrderHistory Boolean?
  /// När sonden senast kördes. Kontrolleras om varje vecka — en butik som
  /// var för ny för att ha gamla ordrar kan ha fått några sedan dess.
  fullOrderHistoryCheckedAt DateTime?
  /// Returkollen: när butikens senaste 45 dagar senast exporterades om för
  /// att fånga sena återbetalningar och avbokningar (de bokas på orderns dag).
  /// Tokenvakten tar butiker där värdet är null eller äldre än 6 h och
  /// stämplar atomiskt. Skrivs med rå SQL så att `updatedAt` inte rörs — se
  /// `resyncRunda` i token-keeper.server.ts.
  refundResyncAt DateTime?
  /// När returkollen senast LYCKADES. Skrivs bara efter en lyckad hämtning
  /// (rå SQL, som låset ovan) och är det panelen och gruppen visar som
  /// "senaste koll" — `refundResyncAt` är låset och stämplas innan exporten.
  refundResyncOkAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  costChanges CostChange[]

  @@index([groupId])
}

/// En rad per order med pseudonymiserad kund — underlaget för kundvärdet
/// (LTV) och ny/återkommande. Kund-ID lagras BARA som HMAC (kundHash); det
/// går inte att vända utan serverns nyckel. Null = gästorder utan kund.
/// Raderas vid customers/redact (per hash + orders_to_redact) och shop/redact.
model KundOrder {
  shop      String
  /// Shopify order-GID — idempotent upsert och nyckel för orders_to_redact.
  orderId   String
  kundHash  String?
  /// YYYY-MM-DD i butikens tidszon.
  dag       String
  /// Subtotal − återbetalning, som DailyPnl.netSales.
  netto     Float
  /// Netto − COGS (med flerpack) − tull − avgift, räknat med kostnaden vid
  /// hämtningen. Null när någon rad saknar inköpspris — aldrig gissning.
  tb        Float?
  createdAt DateTime @default(now())

  @@id([shop, orderId])
  @@index([shop, kundHash, dag])
  @@index([shop, dag])
}

/// Engångskod för att koppla ihop två butiker. Kortlivad med flit: koden är
/// det enda som skiljer "mina butiker" från "någon annans siffror".
model StoreLinkCode {
  code      String   @id
  /// Gruppen den inlösande butiken hamnar i.
  groupId   String
  /// Butiken som skapade koden, för spårbarhet.
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([groupId])
}

/// Engångstillstånd för Logga in med Facebook. Inloggningen sker i ett eget
/// fönster utan Shopify-session, så raden är det enda som binder Metas
/// svar till rätt butik — och till webbläsaren som startade (nonceHash
/// matchas mot en cookie). Kortlivad och engångs med flit.
/// Ett kopplat Google Ads-konto. Speglar MetaAdAccount: en butik kan ha
/// flera, och annonskostnaden är summan av dem alla.
///
/// `customerId` är kundnumret utan bindestreck ("1234567890"). I DailySpend
/// lagras det med prefixet `g:` så Google och Meta kan samsas i samma tabell
/// utan att ett kundnummer råkar krocka med ett Meta-konto-id.
model GoogleAdsAccount {
  shop            String
  customerId      String
  /// Kontots namn hos Google, cachat så listan går att läsa utan API-anrop.
  name            String?
  /// Kontots valuta, läst från Google. Null = inte läst ännu.
  currency        String?
  /// Kontots tidszon (IANA). Google rapporterar dagar i kontots zon.
  timezoneName    String?
  /// Chefskontot anropet ska gå via, utan bindestreck. Null = kontot nås
  /// direkt. Krävs när kundkontot ligger under ett Google Ads-chefskonto.
  loginCustomerId String?
  createdAt       DateTime @default(now())

  @@id([shop, customerId])
  @@index([shop])
}

model MetaLoginState {
  state     String   @id
  shop      String
  /// Vilken tjänst inloggningen gäller: "meta" eller "google". Tabellen
  /// heter fortfarande MetaLoginState — den byggdes för Facebook och döptes
  /// aldrig om, för en omdöpning av en tabell mitt i drift är ett verkligt
  /// avbrott för att vinna ett namn. Allt annat delas: engångs-state,
  /// nonce-cookien, utgången och samma säkerhetsresonemang.
  provider  String   @default("meta")
  /// sha256 av nonce-cookien som sätts när fönstret öppnas. Null = fönstret
  /// har inte öppnats än; sätts exakt en gång.
  nonceHash String?
  /// Vad inloggningen är till för. Null/"butik" = en handlare kopplar sin
  /// butik. "granskning" = Metas granskare testar flödet på /meta/granska;
  /// då sparas ingenting och nyckeln återkallas direkt efteråt.
  syfte     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([expiresAt])
}

/// Kvitto på en raderingsbegäran från Meta (Data Deletion Request Callback).
/// Innehåller MEDVETET inget användar-id i klartext — bara en hash, så att
/// kvittot bevisar att raderingen skett utan att återinföra det som raderades.
model MetaDeletion {
  /// Koden Meta får tillbaka och visar för användaren.
  code        String    @id
  userHash    String
  /// Antal butiker som kopplades bort.
  shops       Int       @default(0)
  requestedAt DateTime  @default(now())
  completedAt DateTime?
}

/// Datumsatt kostnadsändring. Shopifys unitCost har bara ETT värde och ingen
/// historik — den håller alltid *nuvarande* kostnad. Vill man räkna gårdagens
/// vinst på gårdagens kostnad behövs det här lagret ovanpå.
model CostChange {
  id            String   @id @default(cuid())
  shop          String
  /// Shopify variant-GID. Null = gäller alla varianter i produkten.
  variantGid    String?
  /// Shopify produkt-GID.
  productGid    String
  /// Vara + frakt, utan tull. Summan av de två fälten nedan när de är ifyllda.
  unitCost      Decimal  @db.Decimal(10, 2)
  /// Varan själv, utan frakt. Den delen förhandlas separat och ändras sällan.
  productCost   Decimal? @db.Decimal(10, 2)
  /// Frakten per enhet. Den dominerar kostnaden och är den som sjunker vid
  /// flerpack — därför måste den gå att se och ändra för sig.
  shippingCost  Decimal? @db.Decimal(10, 2)
  /// Gäller från och med detta datum (inklusive).
  effectiveFrom DateTime @db.Date
  note          String?
  /// Marknad (ISO-landskod ur orderns leveransadress, t.ex. "SE", "NO", "US")
  /// som kostnaden gäller. Tom sträng = standard, gäller alla marknader som
  /// inte har en egen post. Frakten skiljer sig kraftigt mellan länder, så
  /// samma produkt kan kosta 60 kr att få till Sverige och 140 kr till USA.
  market        String   @default("")
  createdAt     DateTime @default(now())

  settings ShopSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, productGid, effectiveFrom])
}

/// Cachad annonskostnad per dag. Meta har hårda rate limits, så dagar som redan
/// är stängda hämtas en gång och sparas. Dagens siffra hämtas om varje gång.
model DailySpend {
  id          String   @id @default(cuid())
  shop        String
  day         DateTime @db.Date
  /// Vilket annonskonto raden kommer från, siffrorna utan act_-prefix. En
  /// butik kan köra annonser från flera konton till samma butik; varje konto
  /// får en egen rad per dag och panelen summerar dem. Tom sträng = rader
  /// från tiden före flerkontostödet (2026-09-17), bakfyllda vid migrationen.
  account     String   @default("")
  /// Marknaden kampanjerna på raden är märkta med i Inställningar (ISO-
  /// landskod). Tom sträng = kampanjer utan marknad, eller kontot saknar
  /// märkning helt (då är raden hela kontots kostnad). Summan över alla
  /// marknader för en dag är alltid kontots hela kostnad den dagen.
  market      String   @default("")
  /// Alltid i BUTIKENS valuta. Är annonskontot i en annan valuta har beloppet
  /// räknats om med dagskursen nedan. Konton i olika valutor kan därför
  /// summeras rakt av.
  spend       Decimal  @db.Decimal(12, 2)
  /// Ursprungsbeloppet i annonskontots valuta, sparat för spårbarhet.
  spendRaw    Decimal? @db.Decimal(12, 2)
  /// Kursen som användes. Null = ingen omräkning behövdes.
  fxRate      Decimal? @db.Decimal(18, 8)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  fetchedAt   DateTime @default(now())

  @@unique([shop, day, account, market])
  @@index([shop, day])
}

/// Ett annonskonto kopplat till en butik. Flera rader = flera konton, och
/// annonskostnaden är summan av dem alla.
///
/// Token ligger kvar på ShopSettings: en Facebook-inloggning ger EN nyckel som
/// når alla konton personen har tillgång till. Kampanjfiltret däremot bor här,
/// för kampanj-ID:n är kontospecifika — samma filter på två konton skulle
/// betyda "inga kampanjer" i det ena.
model MetaAdAccount {
  shop         String
  /// Siffrorna utan act_-prefix, samma form som DailySpend.account.
  accountId    String
  /// Kontots namn hos Meta, cachat så listan går att läsa utan API-anrop.
  name         String?
  /// Kontots valuta, läst från Meta. Null = inte läst ännu.
  currency     String?
  /// Kontots tidszon hos Meta (IANA, t.ex. "Europe/Copenhagen"). Metas
  /// timbreakdown levereras i DEN zonen, inte i butikens. Null = inte läst.
  /// ⚠ Jämför ALDRIG namnet mot butikens — jämför offset. Copenhagen och
  /// Stockholm har olika namn och exakt samma tid (mätt 2026-09-23).
  timezoneName String?
  /// "all" | "include" | "exclude" — se MetaConfig i lib/meta.server.ts.
  campaignMode String   @default("all")
  /// Kampanj-ID:n filtret gäller, kommaseparerade. Null/tomt = inget filter.
  campaignIds  String?
  /// Vilken marknad varje kampanj annonserar mot: { "<kampanj-id>": "NO" }.
  /// Null/tomt = ingen märkning, kontots kostnad läggs på marknaden "".
  /// Med märkning hämtas kostnaden på kampanjnivå och delas per marknad, så
  /// panelen kan visa vinsten för Norge för sig och USA för sig.
  campaignMarkets Json?
  createdAt    DateTime @default(now())

  @@id([shop, accountId])
  @@index([shop])
}

/// Färdigräknade aggregat per (butik, intervall). Bulk-exporten tar 20–60 s;
/// utan cache betalar varje sidladdning det priset igen.
/// En färdig rad per butik och dag. Varje datumintervall blir en summering av
/// dagsrader (millisekunder) istället för en orderexport (halvminut). Dagen
/// följer BUTIKENS tidszon. Rader skrivs även för dagar utan ordrar, så att
/// "saknas" betyder "aldrig hämtad", inte "såldes inget".
model DailyPnl {
  shop            String
  day             String // YYYY-MM-DD i butikens tidszon
  orders          Int    @default(0)
  grossSales      Float  @default(0)
  discounts       Float  @default(0)
  returns         Float  @default(0)
  netSales        Float  @default(0)
  totalSales      Float  @default(0)
  shippingCharges Float  @default(0)
  /// Dagens FAKTISKA betalavgifter, summerade ur ordertransaktionernas
  /// `fees` (Shopify Payments: kortavgift, växlingsavgift, utländskt kort …).
  /// Null = raden skrevs innan avgifterna hämtades, eller Shopify lämnade
  /// inte ut dem — då räknar motorn med procentsatsen i Inställningar.
  fees            Float?
  /// Omsättning i ordrar betalda genom Shopify Payments — den del av
  /// totalSales som `fees` täcker (bara Shopify Payments skriver fees).
  /// Resten räknas med satsen. Null = raden skrevs före 2026-09-26: hela
  /// omsättningen räknas som täckt tills dagen hämtas om.
  feesCoveredSales Float?
  /// Omsättning per betalväxel: { "shopify_payments": 6000, "paypal": 4000 }.
  /// "" = ordrar utan transaktion. Underlaget för listan i Inställningar.
  gatewaySales    Json?
  /// Dagens produktmix: [{productGid, variantGid, title, variantTitle, units, netSales, unitCost}]
  products        Json
  /// Samma dag uppdelad per marknad (ISO-landskod ur leveransadressen):
  /// { "SE": { orders, grossSales, discounts, returns, netSales, totalSales,
  ///   shippingCharges, products: [...] }, "NO": {...} }. Ordrar utan land
  /// ligger under "". Fälten ovan är alltid TOTALEN och förblir facit; det
  /// här är bara en uppdelning av dem. Null = raden skrevs före 2026-09-17
  /// och saknar uppdelning — under ett marknadsfilter räknas dagen då som
  /// ohämtad och exporteras om.
  markets         Json?
  /// När dagen senast timuppdelades. Null = raden skrevs före timgrafen och
  /// har inga HourlyPnl-rader — dagen räknas då varken som 24 nollor eller
  /// som hämtad, utan rapporteras som "inte timuppdelad" i panelen.
  hoursAt         DateTime?
  fetchedAt       DateTime @default(now())

  @@id([shop, day])
}

/// Samma försäljning som DailyPnl, men per TIMME på dygnet (0–23) i butikens
/// tidszon, och per marknad inom timmen. Marknaden "" är hela timmen och
/// finns alltid; landskoder finns bara när leveransadressen gick att läsa.
///
/// Egen tabell, inte en JSON-kolumn på DailyPnl: `readDaily` gör ett
/// oselekterat findMany som varenda sida i appen går igenom, och en
/// timkolumn hade varit marknader × 24 på ett svar fem skärmar redan betalar
/// för utan att någon av dem ritar grafen.
///
/// INGEN produktmix här. Timmarna bär bara skalärer — omsättning, ordrar och
/// avgifter. Vinstmarginal per timme kräver `lines`-histogrammet per timme
/// och är medvetet uppskjutet; se timgrafens avsnitt i CLAUDE.md.
model HourlyPnl {
  shop            String
  day             String // YYYY-MM-DD i butikens tidszon, som DailyPnl
  hour            Int // 0–23
  market          String @default("")
  orders          Int    @default(0)
  grossSales      Float  @default(0)
  discounts       Float  @default(0)
  returns         Float  @default(0)
  netSales        Float  @default(0)
  totalSales      Float  @default(0)
  shippingCharges Float  @default(0)
  fees            Float?
  /// Som DailyPnl.feesCoveredSales, för timmen.
  feesCoveredSales Float?

  @@id([shop, day, hour, market])
  @@index([shop, day])
}

/// Annonskostnad per timme på dygnet. Skrivs i samma vända som DailySpend,
/// ur samma dagar och samma kurs, så SUM(timmar) = dagen per konstruktion.
///
/// ⚠ `hour` är timmen i ANNONSKONTOTS tidszon — det är så Metas breakdown
/// `hourly_stats_aggregated_by_advertiser_time_zone` levererar den.
/// Butikens timmar kommer ur order-createdAt i BUTIKENS tidszon. Skiljer de
/// sig måste timmarna förskjutas vid läsning; se `tidszonsOffset`.
model HourlySpend {
  shop        String
  day         DateTime @db.Date
  account     String
  market      String   @default("")
  hour        Int // 0–23, annonskontots tidszon
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  fetchedAt   DateTime @default(now())

  @@id([shop, day, account, market, hour])
  @@index([shop, day])
}

model PnlCache {
  id        String   @id @default(cuid())
  shop      String
  key       String
  payload   Json
  fetchedAt DateTime @default(now())

  @@unique([shop, key])
}

/// Produktkatalogen med inköpspriser. Låg tidigare bara i processminnet, vilket
/// betydde full ompaginering av alla varianter varje gång containern startats om
/// — flera sekunder rakt in i sidladdningen. Databasen överlever omstarter.
model CatalogCache {
  shop      String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

/// Fasta månadskostnader — abonnemang, anställda, appavgifter. Summeras och
/// slås ut per dag i kalkylen: (summa × 12) / 365 per dag.
model FixedCost {
  id            String   @id @default(cuid())
  shop          String
  name          String
  monthlyAmount Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@index([shop])
}

/// Kostnad per ANTAL i samma orderrad — flerpack. Två stycken kostar inte
/// dubbelt: frakten delas, så leverantören offererar ett totalpris för 2 och
/// för 3. Antal 1 är Shopifys unitCost; här ligger bara stegen därefter.
/// Saknas ett antal räknas det från närmaste lägre steg plus marginalpriset.
model CostTier {
  id         String   @id @default(cuid())
  shop       String
  variantGid String
  /// Antal i orderraden som totalpriset gäller för (2, 3, …).
  units      Int
  /// Totalkostnad för hela antalet, vara + frakt, utan tull.
  totalCost  Decimal  @db.Decimal(10, 2)
  /// Marknad, som CostChange.market. Tom sträng = standard.
  market     String   @default("")
  createdAt  DateTime @default(now())

  @@unique([shop, variantGid, units, market])
  @@index([shop])
}
