      "fil": "/tmp/claude-0/-home-user-yognftnfgn/6d8eb445-6420-5e1c-8ca1-c4faf90c9d57/scratchpad/annonser/MATSTRUMP_sushi_pain_lifestyle_031_v1_4x5.png",
