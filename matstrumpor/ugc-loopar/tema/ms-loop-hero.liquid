{%- comment -%}
  ms-loopar: toppbildens loop (matstrumpor/ugc-loopar). del: 'mobil' (kortet över fotot, bara mobil)
  eller 'kort' (kortet bredvid texten, bara dator). id: sektionens id.
  Mobilen visade loopen över hela bildytan till 2026-10-01 kväll — Axel: "så himla inzoomat, så man
  inte riktigt ser produkten". Nu står produktfotot kvar och loopen är ett kort i hörnet, som på dator.
{%- endcomment -%}
{%- if del == 'mobil' -%}
  <style>
    @media screen and (max-width:749px){
      #Banner-{{ id }} .banner__media{height:100vw!important;min-height:0!important}
      #Banner-{{ id }}.banner{min-height:0!important}
      {%- comment -%} Dawns `.media > *:not(.zoom)…` (0,3,0) gör varje barn i bildytan helbild — därav id {%- endcomment -%}
      #Banner-{{ id }} .banner__media .ms-loop-hero--mobil{display:block;position:absolute;top:3%;right:3%;left:auto;bottom:auto;width:36%;height:auto;max-width:none;z-index:2;transform:rotate(3deg);background:#fff;padding:.6rem;border-radius:1.6rem;box-shadow:0 1rem 2.6rem rgba(0,0,0,.3)}
      #Banner-{{ id }} .banner__media .ms-loop-hero--mobil .ms-loop-kort{position:relative;aspect-ratio:1/1;overflow:hidden;border-radius:1.1rem;box-shadow:none}
      #Banner-{{ id }} .banner__media .ms-loop-hero--mobil .ms-loop__v{display:block;width:100%;height:100%;object-fit:cover}
    }
    @media screen and (min-width:750px){
      #Banner-{{ id }} .banner__media .ms-loop-hero--mobil{display:none!important}
      #Banner-{{ id }} .banner__content{justify-content:flex-start!important;padding-left:6%!important}
      #Banner-{{ id }} .banner__box{max-width:min(56rem,52vw)!important;margin:0!important;text-align:left!important}
      #Banner-{{ id }} .banner__box > *{text-align:left!important;justify-content:flex-start!important}
    }
  </style>
  <div class="ms-loop-hero ms-loop-hero--mobil"><div class="ms-loop-kort">{% render 'ms-loop', loop: loop %}</div></div>
{%- else -%}
  {{ 'ms-loopar.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ms-loopar.js' | asset_url }}" defer="defer"></script>
  <div class="ms-loop-hero ms-loop-hero--kort"><div class="ms-loop-kort">{% render 'ms-loop', loop: loop %}</div></div>
{%- endif -%}
