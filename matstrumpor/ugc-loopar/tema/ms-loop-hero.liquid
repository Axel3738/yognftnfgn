{%- comment -%}
  ms-loopar: toppbildens loop (matstrumpor/ugc-loopar). del: 'mobil' (i bildytan, bara mobil)
  eller 'kort' (kortet bredvid texten, bara dator). id: sektionens id.
{%- endcomment -%}
{%- if del == 'mobil' -%}
  <style>
    .ms-loop-hero--mobil{position:absolute;inset:0;z-index:1}
    .ms-loop-hero--mobil .ms-loop__v{display:block;width:100%;height:100%;object-fit:cover;background:#f4ede4}
    @media screen and (max-width:749px){
      #Banner-{{ id }} .banner__media{height:100vw!important;min-height:0!important}
      #Banner-{{ id }}.banner{min-height:0!important}
      #Banner-{{ id }}::after{opacity:0!important}
    }
    @media screen and (min-width:750px){
      {%- comment -%} Dawns `.media > *:not(.zoom)…` (0,3,0) sätter display:block — därav id + !important {%- endcomment -%}
      #Banner-{{ id }} .banner__media .ms-loop-hero--mobil{display:none!important}
      #Banner-{{ id }} .banner__content{justify-content:flex-start!important;padding-left:6%!important}
      #Banner-{{ id }} .banner__box{max-width:min(56rem,52vw)!important;margin:0!important;text-align:left!important}
      #Banner-{{ id }} .banner__box > *{text-align:left!important;justify-content:flex-start!important}
    }
  </style>
  <div class="ms-loop-hero ms-loop-hero--mobil">{% render 'ms-loop', loop: loop %}</div>
{%- else -%}
  {{ 'ms-loopar.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ms-loopar.js' | asset_url }}" defer="defer"></script>
  <div class="ms-loop-hero ms-loop-hero--kort"><div class="ms-loop-kort">{% render 'ms-loop', loop: loop %}</div></div>
{%- endif -%}
