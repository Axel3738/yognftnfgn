{
  "name": "baverbutiken-creative-os",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Creative Strategy OS för Bäverbutiken: brief-kvot, produktminne och redigerardashboard. Inga externa beroenden.",
  "scripts": {
    "quota": "node pipeline/quota.mjs",
    "seed": "node dashboard/seed.mjs --force",
    "dash": "node dashboard/build.mjs",
    "status": "node dashboard/cli.mjs status",
    "review": "node dashboard/cli.mjs review-queue",
    "test": "node --test dashboard/test/*.test.mjs",
    "tema:check": "node theme-matstrumpor/tools/liquid-check.mjs",
    "tema:test": "node --test theme-matstrumpor/ab/test/*.test.mjs theme-matstrumpor/tools/test/*.test.mjs",
    "tema:grind": "npm run tema:check && npm run tema:test",
    "tema:ab": "node theme-matstrumpor/ab/analys.mjs",
    "tema:upp": "node theme-matstrumpor/tools/ladda-upp.mjs",
    "tema:shop": "node shopify/token.mjs MATSTRUMPOR"
  },
  "engines": {
    "node": ">=20"
  }
}
