{%- liquid
  assign s = section.settings
-%}
{%- if s.visible -%}
<div class="ms-scope ms-section" {% render 'ms-ab-attrs', test: s.ab_test, variant: s.ab_variant %}>
  <div class="ms-wrap">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="ms-center" style="margin-bottom: 24px;">
        {%- if s.eyebrow != blank -%}<span class="ms-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ms-h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Slidern är ett scroll-snap-spår, inte ett karusellbibliotek. Den funkar
      med touch, med mushjul och med tangentbord utan en rad JavaScript —
      prickarna nedanför är det enda som behöver kod, och de är valfria.
    {%- endcomment -%}
    <ms-slider class="ms-rs">
      <div class="ms-rs__spar" role="list">
        {%- for block in section.blocks -%}
          <article class="ms-rs__kort ms-review" role="listitem" {{ block.shopify_attributes }}>
            <div class="ms-review__stars" role="img"
                 aria-label="{{ block.settings.stars }} av 5 stjärnor">
              {%- for i in (1..block.settings.stars) -%}
                {% render 'ms-icon', name: 'star', class: 'ms-i--fill' %}
              {%- endfor -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="ms-review__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            <p class="ms-review__body">{{ block.settings.body }}</p>
            <div class="ms-review__who">
              {%- if block.settings.avatar -%}
                <img class="ms-review__avatar" loading="lazy" width="30" height="30" alt=""
                     src="{{ block.settings.avatar | image_url: width: 80 }}">
              {%- endif -%}
              <span>{{ block.settings.name }}</span>
              {%- if block.settings.verified -%}
                <span class="ms-review__verified">
                  {% render 'ms-icon', name: 'check-circle' %}
                  Verifierat köp
                </span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="ms-rs__prickar" data-ms-slider-dots hidden></div>
    </ms-slider>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Omdömen som slider",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "visible", "label": "Visa sektionen", "default": true,
      "info": "Bocka ur för att stänga av den utan att ta bort den." },
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Vad kunderna säger" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Presenten som alltid landar rätt" },
    { "type": "paragraph", "content": "Skriv bara in omdömen som faktiskt är skrivna av kunder. Påhittade omdömen är vilseledande marknadsföring." },
    { "type": "header", "content": "A/B-test" },
    { "type": "text", "id": "ab_test", "label": "Test-id", "info": "Lämna tomt om sektionen inte ingår i något test." },
    { "type": "select", "id": "ab_variant", "label": "Visas för variant", "default": "",
      "options": [
        { "value": "", "label": "Alla" },
        { "value": "a", "label": "Bara A" },
        { "value": "b", "label": "Bara B" }
      ] }
  ],
  "blocks": [
    { "type": "review", "name": "Omdöme", "settings": [
      { "type": "range", "id": "stars", "label": "Stjärnor", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Rubrik" },
      { "type": "textarea", "id": "body", "label": "Omdöme" },
      { "type": "text", "id": "name", "label": "Namn" },
      { "type": "image_picker", "id": "avatar", "label": "Bild" },
      { "type": "checkbox", "id": "verified", "label": "Märk som verifierat köp", "default": false,
        "info": "Bocka bara i den här om köpet faktiskt går att styrka." }
    ] }
  ],
  "presets": [
    { "name": "Omdömen som slider",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }
  ]
}
{% endschema %}
