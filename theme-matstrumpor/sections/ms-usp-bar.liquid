{%- if section.settings.visible -%}
{% render 'ms-trust-row', items: section.settings.items %}
<style>
  #shopify-section-{{ section.id }} .ms-trust {
    margin: 0; border-radius: 0; border-inline: 0;
    {% if section.settings.background != blank %}background: {{ section.settings.background }};{% endif %}
  }
  /* Mobilkrympningen i ms-cro.css finns för att TRE punkter ska rymmas på
     en rad i köprutan. Här på startsidan är punkterna färre och har hela
     sidbredden — texten ska inte krympa till oläslighet. */
  #shopify-section-{{ section.id }} .ms-trust__item { font-size: var(--ms-fs-xs); }
</style>
{%- endif -%}

{% schema %}
{
  "name": "USP-rad",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "visible", "label": "Visa sektionen", "default": true,
      "info": "Bocka ur för att stänga av den utan att ta bort den." },
    { "type": "textarea", "id": "items", "label": "Punkter",
      "default": "truck:Fri frakt i Sverige|refresh:30 dagars öppet köp|gift:Levereras presentklart|star:Älskad av tusentals svenskar",
      "info": "Format ikon:text, separerade med |." },
    { "type": "color", "id": "background", "label": "Bakgrund" }
  ],
  "presets": [{ "name": "USP-rad" }]
}
{% endschema %}
