{%- liquid
  assign s = section.settings
-%}
{%- if s.visible -%}
<div class="ms-scope ms-section" {% render 'ms-ab-attrs', test: s.ab_test, variant: s.ab_variant %}>
  <div class="ms-wrap" style="max-width: {{ s.width }}px;">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="ms-center" style="margin-bottom: 22px;">
        {%- if s.eyebrow != blank -%}<span class="ms-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ms-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<p class="ms-lede">{{ s.body }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ms-videogrid" style="--ms-videogrid-cols: {{ s.columns }}">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {% render 'ms-video',
               video: block.settings.video,
               poster: block.settings.poster,
               ratio: s.ratio,
               ljud: block.settings.ljud %}
            {%- if block.settings.caption != blank -%}
              <p class="ms-videogrid__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.button_label != blank and s.button_link != blank -%}
      <div class="ms-center" style="margin-top: 26px;">
        <a class="ms-btn" href="{{ s.button_link }}">{{ s.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "visible", "label": "Visa sektionen", "default": true,
      "info": "Bocka ur för att stänga av den utan att ta bort den." },
    { "type": "header", "content": "Innehåll" },
    { "type": "text", "id": "eyebrow", "label": "Överrubrik" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Se dem i rörelse" },
    { "type": "text", "id": "body", "label": "Ingress" },
    { "type": "text", "id": "button_label", "label": "Knapptext" },
    { "type": "url", "id": "button_link", "label": "Knapplänk" },
    { "type": "header", "content": "Utseende" },
    { "type": "range", "id": "columns", "label": "Kolumner på dator", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "ratio", "label": "Bildformat", "default": "9x16",
      "options": [
        { "value": "auto", "label": "Filmens eget" },
        { "value": "1x1", "label": "Kvadrat" },
        { "value": "4x5", "label": "Stående 4:5" },
        { "value": "9x16", "label": "Stående 9:16 (Reels)" },
        { "value": "16x9", "label": "Liggande 16:9" }
      ] },
    { "type": "range", "id": "width", "label": "Maxbredd", "min": 600, "max": 1400, "step": 50, "default": 1100, "unit": "px" },
    { "type": "paragraph", "content": "Filmerna spelas tyst och i loop, utan kontroller — som en gif. De laddas först när de scrollas in i bild, så sidan blir inte långsam av dem." },
    { "type": "header", "content": "A/B-test" },
    { "type": "text", "id": "ab_test", "label": "Test-id", "info": "Lämna tomt om sektionen inte ingår i något test." },
    { "type": "select", "id": "ab_variant", "label": "Visas för variant", "default": "",
      "options": [
        { "value": "", "label": "Alla" },
        { "value": "a", "label": "Bara A" },
        { "value": "b", "label": "Bara B" }
      ] }
  ],
  "blocks": [
    { "type": "video", "name": "Film", "settings": [
      { "type": "video", "id": "video", "label": "Video" },
      { "type": "image_picker", "id": "poster", "label": "Bild före start",
        "info": "Visas tills filmen hunnit börja. Utan den blir rutan svart en kort stund." },
      { "type": "text", "id": "caption", "label": "Bildtext" },
      { "type": "checkbox", "id": "ljud", "label": "Visa ljudknapp", "default": false,
        "info": "Filmen startar alltid tyst — webbläsare tillåter inte annat. Knappen låter kunden slå på ljudet själv." }
    ] }
  ],
  "presets": [
    { "name": "Video", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }
  ]
}
{% endschema %}
