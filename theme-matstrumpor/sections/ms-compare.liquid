{%- if section.settings.visible -%}
<div class="ms-scope ms-section" {% render 'ms-ab-attrs', test: section.settings.ab_test, variant: section.settings.ab_variant %}>
  <div class="ms-wrap">
    <div class="ms-center" style="margin-bottom: 26px;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ms-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="ms-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="ms-lede">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="ms-compare__scroll">
      <table class="ms-compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="ms-sr">Egenskap</span></th>
            <th scope="col" class="ms-compare__col--us">{{ section.settings.us_label }}</th>
            <th scope="col" class="ms-compare__col--them">{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td class="ms-compare__col--us">
                {%- if block.settings.us -%}
                  <span class="ms-compare__yes">
                    {% render 'ms-icon', name: 'check' %}<span class="ms-sr">Ja</span>
                  </span>
                {%- else -%}
                  <span class="ms-compare__no">
                    {% render 'ms-icon', name: 'x' %}<span class="ms-sr">Nej</span>
                  </span>
                {%- endif -%}
              </td>
              <td class="ms-compare__col--them">
                {%- if block.settings.them -%}
                  <span class="ms-compare__yes">
                    {% render 'ms-icon', name: 'check' %}<span class="ms-sr">Ja</span>
                  </span>
                {%- else -%}
                  <span class="ms-compare__no">
                    {% render 'ms-icon', name: 'x' %}<span class="ms-sr">Nej</span>
                  </span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Jämförelsetabell",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "checkbox", "id": "visible", "label": "Visa sektionen", "default": true,
      "info": "Bocka ur för att stänga av den utan att ta bort den." },
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Varför just den här" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Matstrumpor mot en vanlig present" },
    { "type": "text", "id": "body", "label": "Ingress" },
    { "type": "text", "id": "us_label", "label": "Vår kolumn", "default": "Matstrumpor" },
    { "type": "text", "id": "them_label", "label": "Jämförelsekolumn", "default": "Vanlig present" },
    { "type": "header", "content": "A/B-test" },
    { "type": "text", "id": "ab_test", "label": "Test-id", "info": "Lämna tomt om sektionen inte ingår i något test." },
    { "type": "select", "id": "ab_variant", "label": "Visas för variant", "default": "",
      "options": [
        { "value": "", "label": "Alla" },
        { "value": "a", "label": "Bara A" },
        { "value": "b", "label": "Bara B" }
      ] }
  ],
  "blocks": [
    { "type": "row", "name": "Rad", "settings": [
      { "type": "text", "id": "feature", "label": "Egenskap" },
      { "type": "checkbox", "id": "us", "label": "Vi har den", "default": true },
      { "type": "checkbox", "id": "them", "label": "Jämförelsen har den", "default": false }
    ] }
  ],
  "presets": [
    { "name": "Jämförelsetabell",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" }] }
  ]
}
{% endschema %}
