{%- comment -%}
  ms-skrapkort — skrapa-fram-rabatten-popup för e-postklubben.

  Flödet i tre steg:
    1. SKRAPA  Efter en stunds fördröjning öppnas ett skrapkort. Foliet är en
               canvas som suddas med fingret (destination-out). När ~40 % är
               bortskrapat visas vinsten.
    2. MEJL    Koden lämnas ut först mot mejladress. Formuläret är Shopifys
               eget kundformulär — adressen blir en riktig prenumerant i
               Shopify (tagg newsletter) och följer med till Klaviyo.
               Sidan laddas om av Shopify efter POST; vi läser flaggan och
               öppnar popupen igen i klart-läget.
    3. KLAR    Koden visas och knappen lägger den i kassan via /discount/.

  Ärlighetsregler: koden är en riktig rabattkod i Shopify — popupen lovar
  inget som kassan inte håller. Shopify tar EN kod per köp, så den kan inte
  kombineras med paketpriserna (som också är koder) — det står i finstilten.

  Minnet, två lager:
    sessionStorage 'ms-skrap-besok'  Sedd en gång = klart för det besöket.
      Sätts i samma stund som popupen öppnas, inte när den stängs. Kunden
      som bara klickar vidare stänger aldrig något — utan den här spärren
      möter samma popup hen på varje ny sida i butiken.
    localStorage 'ms-skrap'          Minnet mellan besök:
      'klar'        prenumerant, visa aldrig igen
      'skrapad'     skrapade men mejlade inte — mejlsteget nästa besök
      'vila:<ms>'   aktivt nej tack — vila i valt antal dagar
      'visad:<ms>'  sedd men obesvarad — vilar lika länge som ett nej
{%- endcomment -%}
{%- if section.settings.visible -%}
{%- liquid
  assign kod = section.settings.kod | strip
  assign rabatt = section.settings.rabatt_text | strip
  # Hårt mellanslag så "10 %" aldrig radbryts mitt i.
  assign rabatt_fast = rabatt | replace: ' ', '&nbsp;'
-%}
<dialog class="ms-skrap" id="ms-skrap" tabindex="-1"
  data-fordrojning="{{ section.settings.fordrojning }}"
  data-vilodagar="{{ section.settings.vilodagar }}">
  <button type="button" class="ms-skrap__stang" data-ms-skrap-stang aria-label="Stäng">&times;</button>

  <div class="ms-skrap__steg" data-ms-steg="skrapa">
    <h2 class="ms-skrap__rubrik">{{ section.settings.rubrik }}</h2>
    <p class="ms-skrap__under">{{ section.settings.under }}</p>
    <div class="ms-skrap__kort">
      <div class="ms-skrap__vinst" aria-hidden="true">
        <span class="ms-skrap__procent">{{ rabatt }}</span>
        <span class="ms-skrap__vinsttext">rabatt på ditt köp</span>
      </div>
      <canvas class="ms-skrap__folie" width="840" height="450" aria-label="Skrapyta"></canvas>
    </div>
    <p class="ms-skrap__ledtext">Dra med fingret över guldet</p>
  </div>

  <div class="ms-skrap__steg" data-ms-steg="mejl" hidden>
    <h2 class="ms-skrap__rubrik">Du skrapade fram {{ rabatt_fast }}! 🎉</h2>
    <p class="ms-skrap__under">Ange din mejl så låser du upp koden — den funkar direkt.</p>
    {%- form 'customer', id: 'ms-skrap-form', class: 'ms-skrap__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,skrapkort">
      {%- if form.posted_successfully? -%}<div data-ms-skrap-postad hidden></div>{%- endif -%}
      {%- if form.errors -%}
        <p class="ms-skrap__fel" data-ms-skrap-fel>
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
      <div class="ms-skrap__falt">
        <input type="email" name="contact[email]" required autocomplete="email"
          autocapitalize="off" autocorrect="off"
          placeholder="din@mejl.se" aria-label="Mejladress">
        <button type="submit" class="ms-skrap__knapp">Lås upp koden</button>
      </div>
    {%- endform -%}
    <p class="ms-skrap__finstilt">
      Genom att gå med säger du ja till mejl från oss — avsluta när du vill.
      <a href="/policies/privacy-policy">Integritetspolicy</a>
    </p>
  </div>

  <div class="ms-skrap__steg" data-ms-steg="klar" hidden>
    <h2 class="ms-skrap__rubrik">Välkommen i klubben! 🎉</h2>
    <p class="ms-skrap__under">Din kod:</p>
    <p class="ms-skrap__kod">{{ kod }}</p>
    <a class="ms-skrap__knapp ms-skrap__knapp--bred" href="/discount/{{ kod | url_encode }}?redirect=/">
      Handla med {{ rabatt_fast }} rabatt
    </a>
    <p class="ms-skrap__finstilt">
      Koden följer med till kassan när du klickar på knappen.
      Gäller inte ihop med paketpriserna.
    </p>
  </div>
</dialog>
<style>
  /* Fullskärm i märkesorange — förebilden är skrapkorts-apparna: hela
     skärmen tas över, guldkortet är det enda att interagera med och
     krysset är medvetet lågmält (men 44 px stort och alltid klickbart). */
  .ms-skrap {
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 24px;
    width: 100vw;
    height: 100vh;
    width: 100dvw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #FDFBF7;
    /* Gradient kring accentfärgen #DD821D — ger djup i stället för platt yta. */
    background: linear-gradient(160deg, #EE9E3F 0%, #DD821D 55%, #B96A12 100%);
  }
  /* Entrén: snabb och mjuk — fade + litet lyft på ~0,3 s. Snabbt nog att
     inte tänkas på, mjukt nog att inte kännas som ett skärmbyte. Varje
     steg gör samma lilla resa när det visas, så även bytet skrapa → mejl
     glider i stället för att slå om. */
  @keyframes ms-skrap-in {
    from { opacity: 0; transform: translateY(14px) scale(.98); }
    to { opacity: 1; transform: none; }
  }
  .ms-skrap[open] { display: flex; animation: ms-skrap-in .28s cubic-bezier(.22, .9, .36, 1) both; }
  .ms-skrap[open] .ms-skrap__steg:not([hidden]) {
    animation: ms-skrap-in .34s cubic-bezier(.22, .9, .36, 1) both;
  }
  /* Vinsten gör en liten pop när guldet släpper. */
  @keyframes ms-skrap-pop {
    0% { transform: scale(.92); }
    55% { transform: scale(1.05); }
    100% { transform: none; }
  }
  .ms-skrap__kort[data-avslojad] .ms-skrap__vinst {
    animation: ms-skrap-pop .5s cubic-bezier(.22, .9, .36, 1) .2s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .ms-skrap[open],
    .ms-skrap[open] .ms-skrap__steg:not([hidden]),
    .ms-skrap__kort[data-avslojad] .ms-skrap__vinst { animation: none; }
  }
  .ms-skrap::backdrop { background: rgba(18, 18, 18, .45); }
  /* Rubriken mäts mot RUTAN, inte skärmen — därför container-enheter. */
  .ms-skrap__steg { max-width: 520px; width: 100%; container-type: inline-size; }
  .ms-skrap__stang {
    position: fixed;
    top: 14px;
    right: 16px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    font-size: 30px;
    line-height: 1;
    color: #FDFBF7;
    opacity: .55;
    cursor: pointer;
    transition: opacity .15s ease;
  }
  .ms-skrap__stang:hover, .ms-skrap__stang:focus-visible { opacity: 1; }
  /* Dawns vita fokusring gör krysset till en vit låda — egen diskret ring. */
  .ms-skrap__stang:focus, .ms-skrap__stang:focus-visible, .ms-skrap__stang.focused {
    box-shadow: none;
    outline: 2px solid rgba(253, 251, 247, .7);
    outline-offset: 2px;
    border-radius: 8px;
  }
  /* Dialogen tar själva fokuset vid öppning så ringen inte pekar på krysset. */
  .ms-skrap:focus, .ms-skrap:focus-visible { outline: none; box-shadow: none; }
  .ms-skrap__rubrik {
    margin: 0 0 8px;
    /* cqw = procent av rutans bredd. Med vw räknade rubriken på skärmen och
       tog ingen hänsyn till att rutan är smalare — då sprack långa ord. */
    font-size: clamp(1.35em, 7.6cqw, 2.5em);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .02em;
    /* Temat sätter word-break: break-word på rubriker. Det kapar långa ord
       mitt itu så sista bokstaven hamnar ensam på egen rad
       ("VÄLKOMSTRABAT / T"). Ord bryts aldrig — de får hellre krympa. */
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
    text-wrap: balance;
    color: #FDFBF7;
  }
  .ms-skrap__under { margin: 0 0 22px; color: rgba(253, 251, 247, .85); font-size: 1em; }
  .ms-skrap__kort {
    position: relative;
    width: min(84vw, 420px);
    aspect-ratio: 28 / 15;
    margin: 0 auto;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(90, 50, 0, .45), 0 2px 8px rgba(90, 50, 0, .3);
  }
  .ms-skrap__vinst {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    background: #FDFBF7;
  }
  .ms-skrap__procent { font-size: 2.6em; font-weight: 800; color: #C9A227; }
  .ms-skrap__vinsttext { color: #5f5a52; }
  .ms-skrap__folie {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: crosshair;
    transition: opacity .5s ease;
  }
  .ms-skrap__folie[data-borta] { opacity: 0; pointer-events: none; }
  .ms-skrap__ledtext { margin: 16px 0 0; color: rgba(253, 251, 247, .75); font-size: .9em; }
  .ms-skrap__falt { display: flex; gap: 8px; }
  .ms-skrap__falt .ms-skrap__knapp { white-space: nowrap; }
  .ms-skrap__falt input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 13px 14px;
    border: 0;
    border-radius: 12px;
    font: inherit;
    background: #FDFBF7;
    color: #121212;
  }
  .ms-skrap__knapp {
    display: inline-block;
    padding: 13px 18px;
    border: 0;
    border-radius: 12px;
    /* Guldknapp som matchar kortet. */
    background: linear-gradient(180deg, #F2D879 0%, #DDB94B 55%, #C9A227 100%);
    color: #4A3506;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(90, 50, 0, .35);
    transition: filter .15s ease, transform .15s ease;
  }
  .ms-skrap__knapp:hover { filter: brightness(1.05); transform: translateY(-1px); }
  .ms-skrap__knapp--bred { display: block; }
  .ms-skrap__kod {
    margin: 0 auto 18px;
    padding: 12px;
    max-width: 300px;
    border: 2px dashed #F2D879;
    border-radius: 12px;
    background: rgba(253, 251, 247, .12);
    color: #FDFBF7;
    font-size: 1.4em;
    font-weight: 800;
    letter-spacing: .1em;
    user-select: all;
  }
  .ms-skrap__fel {
    margin: 0 0 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #FDFBF7;
    color: #b3261e;
    font-size: .9em;
  }
  .ms-skrap__finstilt { margin: 14px 0 0; font-size: .78em; color: rgba(253, 251, 247, .7); }
  .ms-skrap__finstilt a { color: inherit; }
</style>
<script>
  (function () {
    'use strict';
    var ruta = document.getElementById('ms-skrap');
    if (!ruta || !ruta.showModal) return;

    var NYCKEL = 'ms-skrap';
    var BESOK = 'ms-skrap-besok';
    var VILA_MS = Number(ruta.dataset.vilodagar || 3) * 86400000;
    function minns() { try { return localStorage.getItem(NYCKEL) || ''; } catch (e) { return ''; } }
    function spara(v) { try { localStorage.setItem(NYCKEL, v); } catch (e) { /* privat läge */ } }
    // Besöksspärren lever i sessionStorage: den följer med mellan sidbyten
    // i samma flik men nollas när kunden kommer tillbaka en annan gång.
    function visadIBesoket() { try { return sessionStorage.getItem(BESOK) === '1'; } catch (e) { return false; } }
    function markeraBesok() { try { sessionStorage.setItem(BESOK, '1'); } catch (e) { /* privat läge */ } }

    function steg(namn) {
      ruta.querySelectorAll('[data-ms-steg]').forEach(function (el) {
        el.hidden = el.dataset.msSteg !== namn;
      });
      passaRubrik();
    }

    // Sista skyddet mot fula radbrytningar: ord får aldrig kapas mitt itu
    // (det sköter CSS), men ett riktigt långt ord i ett brett typsnitt kan
    // ändå bli bredare än rutan. Då krymps rubriken tills den ryms, i stället
    // för att svämma över kanten. Max sex steg — sen är det texten som är fel.
    var passar = false, passningar = 0;
    function passaRubrik() {
      // Stängd dialog har bredden noll — mäter man då krymper rubriken i
      // onödan innan den ens visats. Taket är en spärr mot evighetsloopar
      // i teman vi aldrig sett.
      if (!ruta.open || passar || passningar > 30) return;
      var h = ruta.querySelector('[data-ms-steg]:not([hidden]) .ms-skrap__rubrik');
      if (!h) return;
      passar = true;
      passningar++;
      h.style.fontSize = '';
      for (var i = 0; i < 6 && h.scrollWidth > h.clientWidth + 1; i++) {
        h.style.fontSize = (parseFloat(getComputedStyle(h).fontSize) * 0.92) + 'px';
      }
      passar = false;
    }
    window.addEventListener('resize', passaRubrik);
    // Butikens typsnitt laddas asynkront och är ofta bredare än reservtypsnittet.
    // Slår det in efter att vi mätt växer texten och svämmar över kanten.
    // ResizeObserver duger inte: rubriken är alltid 100 % bred, så dess EGEN
    // storlek ändras aldrig — bara textens. Därför några efterkontroller.
    function passaSnart() {
      passaRubrik();
      [150, 600, 1500].forEach(function (ms) { setTimeout(passaRubrik, ms); });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(passaRubrik);
    }

    /* --- skrapfoliet ---------------------------------------------------- */
    var canvas = ruta.querySelector('.ms-skrap__folie');
    var ctx = canvas.getContext('2d');
    var skrapklar = false;

    function malaFolie() {
      // Guldfolie: gradient i guldtoner, sneda glansband, svaga skrapmärken
      // och präglad text — ljus kant ovanför, mörk under, som tryckt i guldet.
      var b = canvas.width, h = canvas.height;
      ctx.globalCompositeOperation = 'source-over';

      var g = ctx.createLinearGradient(0, 0, b, h);
      g.addColorStop(0, '#F1D77E');
      g.addColorStop(.35, '#E3BE55');
      g.addColorStop(.62, '#C9A227');
      g.addColorStop(1, '#E8C863');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, b, h);

      // Två sneda glansband.
      ctx.fillStyle = 'rgba(255, 250, 235, .28)';
      ctx.beginPath();
      ctx.moveTo(b * .12, 0); ctx.lineTo(b * .30, 0);
      ctx.lineTo(b * .06, h); ctx.lineTo(-b * .12, h);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = 'rgba(255, 250, 235, .16)';
      ctx.beginPath();
      ctx.moveTo(b * .78, 0); ctx.lineTo(b * .86, 0);
      ctx.lineTo(b * .62, h); ctx.lineTo(-b * .54 + b, h);
      ctx.closePath(); ctx.fill();

      // Svaga skrapmärken som bjuder in fingret.
      ctx.strokeStyle = 'rgba(140, 110, 20, .18)';
      ctx.lineCap = 'round';
      ctx.lineWidth = 16;
      [[.16, .30, .30, .22], [.20, .42, .36, .34], [.68, .68, .84, .60], [.72, .80, .86, .74]]
        .forEach(function (m) {
          ctx.beginPath();
          ctx.moveTo(b * m[0], h * m[1]);
          ctx.lineTo(b * m[2], h * m[3]);
          ctx.stroke();
        });

      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '800 64px sans-serif';
      // Präglingen: ljus kant snett ovanför, mörk text ovanpå.
      ctx.fillStyle = 'rgba(255, 250, 235, .55)';
      ctx.fillText('SKRAPA HÄR', b / 2, h / 2 - 2);
      ctx.fillStyle = '#8A6A14';
      ctx.fillText('SKRAPA HÄR', b / 2, h / 2 + 2);
    }

    function andelBorta() {
      // Var 16:e pixel räcker som stickprov — exakthet spelar ingen roll här.
      var data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      var borta = 0, alla = 0;
      for (var i = 3; i < data.length; i += 64) {
        alla++;
        if (data[i] === 0) borta++;
      }
      return alla ? borta / alla : 0;
    }

    function skrapa(ev) {
      if (skrapklar) return;
      var rekt = canvas.getBoundingClientRect();
      var x = (ev.clientX - rekt.left) * (canvas.width / rekt.width);
      var y = (ev.clientY - rekt.top) * (canvas.height / rekt.height);
      ctx.globalCompositeOperation = 'destination-out';
      ctx.beginPath();
      ctx.arc(x, y, 50, 0, Math.PI * 2);
      ctx.fill();
      if (andelBorta() > 0.4) {
        skrapklar = true;
        canvas.setAttribute('data-borta', '');
        canvas.parentNode.setAttribute('data-avslojad', '');
        spara('skrapad');
        // Låt vinsten sjunka in innan mejlsteget glider fram — foliet tonar
        // på 0,5 s och kunden ska hinna LÄSA vad den skrapat fram.
        setTimeout(function () { steg('mejl'); }, 1600);
      }
    }

    var drar = false;
    canvas.addEventListener('pointerdown', function (ev) {
      drar = true;
      canvas.setPointerCapture(ev.pointerId);
      skrapa(ev);
    });
    canvas.addEventListener('pointermove', function (ev) { if (drar) skrapa(ev); });
    canvas.addEventListener('pointerup', function () { drar = false; });

    /* --- öppna/stäng ----------------------------------------------------- */
    function oppna(stegnamn) {
      steg(stegnamn);
      if (stegnamn !== 'skrapa') canvas.setAttribute('data-borta', '');
      else malaFolie();
      ruta.showModal();
      // showModal fokuserar annars stängkrysset — då lyser temats fokusring
      // upp krysset som det första man ser. Dialogen tar fokuset i stället.
      ruta.focus();
      passaSnart();

      // Minnet skrivs HÄR, i samma stund som kunden får se popupen — inte
      // först när den stängs. Kunden som bara klickar vidare till nästa sida
      // stänger aldrig något, och utan den här raden mötte samma popup hen
      // på varje ny sida.
      markeraBesok();
      var f = minns();
      if (f !== 'klar' && f !== 'skrapad' && f.indexOf('vila:') !== 0) spara('visad:' + Date.now());
    }

    // Stängning utan medlemskap = vila. Klart läge förblir klart.
    function vilaEllerKlar() {
      if (minns() === 'klar') return;
      if (minns() === 'skrapad') return; // mejlsteget återkommer nästa besök
      // Aktivt nej väger tyngre än 'visad' och startar om vilan.
      spara('vila:' + Date.now());
    }
    ruta.querySelector('[data-ms-skrap-stang]').addEventListener('click', function () { ruta.close(); });
    ruta.addEventListener('close', vilaEllerKlar);
    ruta.addEventListener('click', function (ev) {
      // Klick med target = dialogen är två olika saker: bakgrunden ELLER
      // dialogens egen padding. Bara äkta bakgrundsklick får stänga —
      // utan koordinatkollen stängde ivriga skrapfingrar popupen på
      // paddingen precis när mejlsteget kom fram.
      if (ev.target !== ruta) return;
      var r = ruta.getBoundingClientRect();
      if (ev.clientX < r.left || ev.clientX > r.right || ev.clientY < r.top || ev.clientY > r.bottom) {
        ruta.close();
      }
    });

    /* --- vad ska hända vid sidladdning? ---------------------------------- */
    var lage = minns();

    // Mejlen skickades nyss: Shopify har laddat om sidan, flaggan finns bara
    // om det var VÅRT formulär som postade.
    if (ruta.querySelector('[data-ms-skrap-postad]')) {
      spara('klar');
      oppna('klar');
      return;
    }
    if (ruta.querySelector('[data-ms-skrap-fel]')) {
      oppna('mejl');
      return;
    }

    // Sedd en gång under besöket = klart för i dag. Gäller ALLA lägen, så
    // popupen aldrig möter samma kund två gånger på en shoppingrunda.
    if (visadIBesoket()) return;

    if (lage === 'klar') return;
    if (lage.indexOf('vila:') === 0) {
      var sedan = Number(lage.slice(5));
      if (Date.now() - sedan < VILA_MS) return;
    }
    // Sedd men obesvarad i ett tidigare besök: vila lika länge som ett nej.
    if (lage.indexOf('visad:') === 0) {
      var sett = Number(lage.slice(6));
      if (Date.now() - sett < VILA_MS) return;
    }

    setTimeout(function () {
      oppna(lage === 'skrapad' ? 'mejl' : 'skrapa');
    }, Number(ruta.dataset.fordrojning || 10) * 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Skrapkort e-postklubb",
  "settings": [
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Visa sektionen",
      "default": true,
      "info": "Bocka ur för att stänga av den utan att ta bort den."
    },
    {
      "type": "text",
      "id": "rubrik",
      "label": "Rubrik",
      "default": "Skrapa fram din välkomstrabatt"
    },
    {
      "type": "text",
      "id": "under",
      "label": "Underrubrik",
      "default": "Alla vinner – guldet döljer din rabatt."
    },
    {
      "type": "text",
      "id": "kod",
      "label": "Rabattkod",
      "default": "KLUBB10",
      "info": "Måste finnas som riktig rabattkod i Shopify — popupen skapar den inte."
    },
    {
      "type": "text",
      "id": "rabatt_text",
      "label": "Rabatten i text",
      "default": "10 %",
      "info": "Ska stämma med vad koden faktiskt ger."
