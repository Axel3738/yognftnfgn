<div class="ms-scope ms-section">
  <div class="ms-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="ms-center" style="margin-bottom: 28px;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ms-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="ms-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="ms-lede">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      App-block först, i full bredd. En riktig recensionsapp (Judge.me, Loox,
      Okendo) ritar sitt eget rutnät och ska inte tvingas in i vårt.
    {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div {{ block.shopify_attributes }} style="margin-bottom: 22px;">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    <div class="ms-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        <article class="ms-review" {{ block.shopify_attributes }}>
          <div class="ms-review__stars" role="img"
               aria-label="{{ block.settings.stars }} av 5 stjärnor">
            {%- for i in (1..block.settings.stars) -%}
              {% render 'ms-icon', name: 'star', class: 'ms-i--fill' %}
            {%- endfor -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="ms-review__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          <p class="ms-review__body">{{ block.settings.body }}</p>
          <div class="ms-review__who">
            {%- if block.settings.avatar -%}
              <img class="ms-review__avatar"
                   src="{{ block.settings.avatar | image_url: width: 80 }}"
                   alt="" width="30" height="30" loading="lazy">
            {%- endif -%}
            <span>{{ block.settings.name }}</span>
            {%- if block.settings.verified -%}
              <span class="ms-review__verified">
                {% render 'ms-icon', name: 'check-circle' %}
                Verifierat köp
              </span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Omdömen",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Vad kunderna säger" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Presenten som alltid landar rätt" },
    { "type": "text", "id": "body", "label": "Ingress" },
    { "type": "paragraph", "content": "Vill du visa riktiga recensioner från en app i stället: klicka på Lägg till block och välj appen, t.ex. Judge.me. Appen ritar sitt eget rutnät ovanför de skrivna omdömena." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Omdöme",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stjärnor", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Rubrik" },
        { "type": "textarea", "id": "body", "label": "Omdöme" },
        { "type": "text", "id": "name", "label": "Namn" },
        { "type": "image_picker", "id": "avatar", "label": "Bild" },
        { "type": "checkbox", "id": "verified", "label": "Märk som verifierat köp", "default": false,
          "info": "Bocka bara i den här om köpet faktiskt går att styrka. Falska verifieringsmärken är vilseledande marknadsföring." }
      ]
    }
  ],
  "presets": [
    { "name": "Omdömen",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }
  ]
}
{% endschema %}
