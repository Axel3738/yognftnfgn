{%- comment -%}
  ms-stock-urgency — lagerindikator.

  Två lägen:
    riktigt   Produkten spårar lager → visar verkligt antal kvar.
    manuellt  Ingen lagerspårning → visar bara en textrad från inställningen.
              Vi hittar ALDRIG på en siffra som ser ut att komma från lagret.

  Parametrar: variant, threshold (visa först under detta antal), manual_text
{%- endcomment -%}
{%- liquid
  assign v = variant
  assign limit = threshold | default: 25 | plus: 0
  assign qty = 0
  assign tracked = false
  if v and v.inventory_management != blank
    assign tracked = true
    assign qty = v.inventory_quantity | plus: 0
  endif
-%}
{%- if tracked and qty > 0 and qty <= limit -%}
  {%- assign pct = qty | times: 100 | divided_by: limit -%}
  <div class="ms-stock ms-scope" style="--ms-stock-pct: {{ pct }}%">
    <div class="ms-stock__row">
      <span class="ms-stock__dot" aria-hidden="true"></span>
      <span>Endast <strong>{{ qty }}</strong> kvar i lager</span>
    </div>
    <div class="ms-stock__bar" role="img" aria-label="{{ qty }} av {{ limit }} kvar i lager">
      <div class="ms-stock__fill"></div>
    </div>
  </div>
{%- elsif tracked == false and manual_text != blank -%}
  <div class="ms-stock ms-scope">
    <div class="ms-stock__row">
      <span class="ms-stock__dot" aria-hidden="true"></span>
      <span>{{ manual_text }}</span>
    </div>
  </div>
{%- endif -%}
