{%- liquid
  assign p = product
  if p == blank
    assign p = closest.product
  endif
  assign v = p.selected_or_first_available_variant
-%}
{% render 'ms-stock-urgency',
   variant: v,
   threshold: block.settings.threshold,
   manual_text: block.settings.manual_text %}

{% schema %}
{
  "name": "Lagerindikator",
  "settings": [
    { "type": "range", "id": "threshold", "label": "Visa när lagret är under", "min": 3, "max": 100, "step": 1, "default": 25 },
    { "type": "text", "id": "manual_text", "label": "Text när lager inte spåras",
      "info": "Används bara för produkter utan lagerspårning. Lämna tomt för att inte visa något. Skriv aldrig en siffra här som ser ut att komma från lagret." },
    { "type": "paragraph", "content": "Spårar produkten lager visas det verkliga antalet. Vi hittar aldrig på siffror." }
  ],
  "presets": [{ "name": "Lagerindikator" }]
}
{% endschema %}
