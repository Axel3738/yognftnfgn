{% render 'ms-delivery-estimate',
   min_days: block.settings.min_days,
   max_days: block.settings.max_days,
   cutoff_hour: block.settings.cutoff_hour,
   text: block.settings.text %}

{% schema %}
{
  "name": "Leveransbesked",
  "settings": [
    { "type": "text", "id": "text", "label": "Inledande text", "default": "Beräknad leverans" },
    { "type": "range", "id": "min_days", "label": "Snabbast, arbetsdagar", "min": 1, "max": 20, "step": 1, "default": 5 },
    { "type": "range", "id": "max_days", "label": "Långsammast, arbetsdagar", "min": 1, "max": 30, "step": 1, "default": 10 },
    { "type": "range", "id": "cutoff_hour", "label": "Brytpunkt för dagens packning", "min": 0, "max": 20, "step": 1, "default": 0,
      "info": "0 = ingen brytpunkt. Sätts t.ex. 14 visas 'Beställ inom X tim så packas den idag'. Sätt bara ett värde ni faktiskt håller." },
    { "type": "paragraph", "content": "Datumet räknas i arbetsdagar och svensk tid, och hoppar över helger." }
  ],
  "presets": [{ "name": "Leveransbesked" }]
}
{% endschema %}
