{%- comment -%}
  ms-trust-row — trust icons under the buy button.
  Parameters: items — "icon:text|icon:text|…"
              e.g. "truck:Free shipping|refresh:30-day returns"
  Valid icon names are listed in ms-icon.liquid.
{%- endcomment -%}
{%- liquid
  assign fallback = 'truck:Free shipping|refresh:30-day returns|lock:Secure checkout'
  assign rows = items | default: fallback | split: '|'
-%}
{%- if rows.size > 0 -%}
  {%- comment -%}
    The column count follows the number of points. With a fixed 3-column grid the
    home page's two points sat in columns 1–2 with an empty third to the right —
    the row read as left-shifted rather than centred.
  {%- endcomment -%}
  <div class="ms-trust ms-scope" style="--ms-tr-antal: {{ rows.size }}">
    {%- for row in rows -%}
      {%- liquid
        assign bits = row | split: ':'
        assign ico = bits[0] | strip
        assign txt = bits[1] | strip
        if txt == blank
          assign txt = ico
          assign ico = 'check-circle'
        endif
      -%}
      <div class="ms-trust__item">
        {% render 'ms-icon', name: ico %}
        <span>{{ txt }}</span>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
