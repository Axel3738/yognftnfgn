# ── Grillkliniken P&L – miljövariabler ──────────────────────────────
# Kopiera till .env och fyll i. Alla källor är valfria: saknas en nyckel
# körs den källan i "ej kopplad"-läge (0 kr) så appen ändå startar.

PORT=3000

# ── Shopify (intäkter + betal-/transaktionsavgifter) ────────────────
# OBS: koppla GRILLKLINIKENS butik – inte Bäverbutiken.
# Skapa en Custom App i Shopify Admin → Apps → Develop apps → Admin API,
# scopes: read_orders, read_products. Kopiera Admin API access token.
SHOPIFY_STORE=grillkliniken.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10

# ── Meta / Facebook Ads (annonskostnad) ─────────────────────────────
# System user token med ads_read. Ad account = SnarkLös.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1346450049878358
META_API_VERSION=v21.0

# ── Google Ads (annonskostnad) ──────────────────────────────────────
# Kräver developer token + OAuth (client id/secret + refresh token) + customer id.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Momsläge ────────────────────────────────────────────────────────
# Grillkliniken säljer utan moms → 0. Sätt t.ex. 25 om det ändras.
VAT_PERCENT=0
