    },
    {
      "type": "regular",
      "text": "It only takes one person, and these four steps in order.",
      "alignment": "left"
    },
    {
      "type": "list",
      "text": "Lay it over the roof, with the edge hanging down over the sides."
    },
    {
      "type": "list",
      "text": "Hook the straps under the edge of the body, on all four sides."
    },
    {
      "type": "list",
      "text": "Pull the straps tight."
    },
    {
      "type": "list",
      "text": "Use the two extra reinforced straps for extra hold."
