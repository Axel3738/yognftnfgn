        "ggePKcDJ1a3_text": "<p>OBS: Detta är reklam.<br><a href=\"mailto:kundsupport@grillkliniken.se\">kundsupport@grillkliniken.se</a><br>Grillkliniken.se</p>",
        "ggnjSBAEvhs_text": "<p>|</p>",
