    "gp_section_623152569568526881": {
      "settings": {
        "checksum": "11c2fb5486d2b82e9940e4a31bacc371b0976179684cc4276631b7de3f0e0806_1_1_1_0__1",
        "ggXVwZhmAuK_text": "<p><i><strong>Rent galler varje gång. Inte bara när du orkar.&nbsp;</strong></i><br><br><i><strong>30 dagars öppet köp, inga frågor ställs.&nbsp;</strong></i><br><br><i><strong>Fri frakt inom Sverige.</strong></i></p>"
      },
      "type": "gp-section-623152569568526881"
