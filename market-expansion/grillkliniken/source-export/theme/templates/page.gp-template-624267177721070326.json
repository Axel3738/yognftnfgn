        "ggePKcDJ1a3_text": "<p><br><a href=\"mailto:kundsupport@grillkliniken.se\">kundsupport@grillkliniken.se</a><br>Grillkliniken.se<br>OBS: Detta är reklam.</p>",
        "ggnjSBAEvhs_text": "<p>|</p>",
