        "gg5knyehVEx_text": "<p>Av <strong>Anders Johansson.</strong></p>",
        "ggM51wRYsAX_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_53.png",
        "ggM51wRYsAX_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_53.png",
