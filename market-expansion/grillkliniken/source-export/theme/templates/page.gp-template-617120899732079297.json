  "sections": {
    "gp_section_617120906476520427": {
      "settings": {
        "checksum": "b5f4473edc94348a46c53163ec1bf2c680019109ad221baf23c077b2c793ce7a_1_1_0_0__1",
        "gg5HKHt_pbr_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/Rectangle_41017.png",
