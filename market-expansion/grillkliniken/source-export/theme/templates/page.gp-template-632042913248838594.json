{"sections":{"gp_section_632042913332724674":{"settings":{"checksum":"302db478607809dfcb4d9408d1f965cbc2890b03f9d39181f2e1bd8a3632a3e1_1_1_1_0__1","ggN_Y62y1x6_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggaJsxiAN7L_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggaJsxiAN7L_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggaJsxiAN7L_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggicEtHSQob_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e"},"type":"gp-section-632042913332724674"},"gp_section_632042913332790210":{"settings":{"checksum":"4758e52736f543110f291e21be169e0d45cf0adf58631e1eca33732483ddb46f_1_1_1_0__1","gg0aF2u8lyT_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","gg0aF2u8lyT_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","gg0aF2u8lyT_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","ggQYsDDjz8q_label":"\u003cp\u003eBeställ Mastern — Fri frakt\u003c/p\u003e","ggcSRSH48Jn_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg","ggcSRSH48Jn_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg","ggxMUIlaaZR_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg"},"type":"gp-section-632042913332790210"},"gp_section_632042913332855746":{"settings":{"checksum":"454f6673c5dd046dad38330d0652b0efebb7deccbee9b8556cada2b63d37488a_1_1_1_0__1","ggePKcDJ1a3_text":"\u003cp\u003eOBS: Detta är reklam.\u003cbr\u003e\u003ca href=\"mailto:kundsupport@grillkliniken.se\"\u003ekundsupport@grillkliniken.se\u003c/a\u003e\u003cbr\u003eGrillkliniken.se\u003c/p\u003e","ggnjSBAEvhs_text":"\u003cp\u003e|\u003c/p\u003e","ggwJwnj2Az7_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png","ggwJwnj2Az7_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png","ggwJwnj2Az7_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png"},"type":"gp-section-632042913332855746"},"gp_section_632042913332921282":{"settings":{"checksum":"43f2f1e951adbffa401bbdd36bc67f017ecc433c76f78aef9716b96ed0fb018e_1_1_1_0__1","gg12G0kUpIa_text":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDu rengjorde den gamla grillen. Troligen efter nästan varje grillning. Skrapade, borstade, torkade av. Ytan blev hyfsat bra ändå.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eMen titta på springorna mellan gallerstängerna. Där, mellan varje stång, satt fettet kvar. Svart, hårt, orörligt.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDet är dit ingen vanlig borste når. En stålborste jobbar på ovansidan av gallret. Springorna ligger under den ytan, och det är där det inbrända fettet gömmer sig från allt du gör.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDet fettet är inte bara smutsigt. Det är frätande. Det bryter ner metallen underifrån, dygn för dygn, säsong för säsong. Missfärgning blir rost. Rost blir ett galler som spjälkar och brännare som kärvar.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eEn grill byggd för femton år, som kostade femton tusen kronor, dog efter sju somrar. Inte för att du slarvade. För att verktyget aldrig nådde dit problemet faktiskt satt.\u003c/span\u003e\u003c/p\u003e","gg3g8HZ9t2b_text":"\u003cspan style=\"background-color:transparent;color:#1b2a3a;\"\u003e\u003cstrong\u003eDET VAR INTE DIN SKULD. YTAN LJÖG FÖR DIG.\u003c/strong\u003e\u003c/span\u003e","gglGdc5Sduj_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/just-got-my-new-to-me-22-weber-charcoal-grill-and-looking-v0-76fvb0sm010d1.webp","gglGdc5Sduj_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/7a92adbc-d3b2-5ba3-aa0d-70d1edf496c0.jpg"},"type":"gp-section-632042913332921282"},"gp_section_632042913332986818":{"settings":{"checksum":"8415d5da0392079bb60640d20f5f176a3ca0de68a2ee8541e0728a4169f06fcf_1_1_1_0__1","ggLThU8b6u0_label":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#FFFFFF;\"\u003e\u003cstrong\u003eGe den nya grillen ett annat öde\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggQ4xMGzK7h_text":"\u003cspan style=\"background-color:transparent;color:#1b2a3a;\"\u003e\u003cstrong\u003eSTÅLBORSTEN, LÖKEN, FOLIEN — SAMMA GRUNDFEL\u003c/strong\u003e\u003c/span\u003e","ggdzeecRZdG_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggdzeecRZdG_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggj1ylP6WCi_text":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eStålborsten är förstahandsvalet för de flesta. Den känns grov nog, den är billig, den finns i varje järnaffär.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eMen den skrapar bara ytan. Och när man trycker hårdare för att komma djupare ner i springorna händer något annat: tunna metallstrån lossnar från borsten och följer med maten. Weber skriver själva om det på sin supportsida, det är ett tillräckligt känt problem för att tillverkaren ska varna för det.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eLökhalvan är en klassiker. Den doftar bra, känns hemmagjord, och gör i princip ingenting under ytan.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eAluminiumfolien, hopskrynklad och gnuggad mot gallret, har samma begränsning. Ytlig kontakt, ingen åtkomst till springorna.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eAvbränning, att köra grillen tom och het en stund, \u0026nbsp;bränner bort matrester på ytan. Det gör ingenting åt fettet som redan tagit sig ner mellan stängerna och börjat fräta.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eFyra olika metoder, fyra olika vanor. Samma grundfel i alla: ingen av dem når dit skadan faktiskt sker.\u003c/span\u003e\u003c/p\u003e","ggzJY0t-gH4_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif"},"type":"gp-section-632042913332986818"},"gp_section_632042913333052354":{"settings":{"checksum":"2d26a068aa934f9a422129c76f7588e25fc441687748a6a6131ece345d598368_1_1_1_0__1","gg1Lydu5nRs_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","gg1Lydu5nRs_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggA904-0DfB_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e","ggdcYl02jms_text":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eMastern, Grillklinikens Master, är byggd runt precis det problemet. Inte ytan. Springorna.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eHuvudet snurrar 400 varv i minuten, runt hela gallerstaven, och ner i springorna mellan stängerna. Dit en vanlig stålborste aldrig kommer.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003e1 - 2 minuter räcker. Körs direkt efter grillningen, medan gallret fortfarande är varmt.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eVill du ha ångtricket: värm upp gallret, doppa borsthuvudet i en skål vatten innan du kör det över. Ångan gör halva jobbet åt dig.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eTvå huvuden följer med. Grovhuvudet har en låsmekanism som gör att det aldrig kan tappa strån i maten. Polerhuvudet innehåller ingen metall alls, Grillkliniken kallar det Brush Safe.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDen funkar på Weber, Napoleon, Broil King, Traeger. Kol, gas, keramik, samma metod, samma resultat.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003e999 kronor. Delat på tio grillsäsonger blir det 99 kronor per sommar. Går den sönder ändå får du en ny, det är hela garantin. Och 30 dagars öppet köp om den av någon anledning inte är rätt för dig.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eBetyget står i dagsläget på 4,7 av 5, baserat på 60 recensioner, från andra som stod där du står nu, med en ny grill och ett löfte till sig själva.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDu gav dig själv det löftet redan innan du läste det här. Nu vet du varför den förra grillen inte höll det åt dig. Och nu har du ett sätt att faktiskt hålla det.\u003c/span\u003e\u003c/p\u003e","ggkk6_gC4qd_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggkk6_gC4qd_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggp87Wb3FFa_text":"\u003cspan style=\"background-color:transparent;color:#1b2a3a;\"\u003e\u003cstrong\u003eVERKTYGET SOM FAKTISKT NÅR SPRINGORNA\u003c/strong\u003e\u003c/span\u003e"},"type":"gp-section-632042913333052354"},"gp_section_632042913333117890":{"settings":{"checksum":"a8db362b8de5d91640383b137f14918734c1475f63f8fce0217b1fa1d70b4ba4_1_1_1_0__1","gg42Me8D_t5_text":"\u003cspan style=\"background-color:transparent;color:#1b2a3a;\"\u003e\u003cstrong\u003eBESLUTET SOM FATTAS DAG ETT — INTE ÅR FEM\u003c/strong\u003e\u003c/span\u003e","gg8FQhJxsPM_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","gg8FQhJxsPM_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","ggnhVRgAr0d_text":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDet är lätt att tro att en grills livslängd handlar om kvalitet på materialet, eller tur, eller hur många år man haft den.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eI praktiken avgörs den av en vana. Och den vanan sätts inte år fem, när rosten redan syns och gallret redan spjälkar. Den sätts nu. Den här första säsongen, med den grill som just står på din altan.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eSkillnaden är ungefär en minut. Utförd direkt efter grillningen, medan gallret fortfarande är varmt och fettet fortfarande mjukt, innan det hinner härda och bränna fast till nästa gång.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDet är inte en helg med avkalkningsmedel. Inte en timme på knä med stålull. En minut, varje gång, med ett verktyg som faktiskt når springorna.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#222222;\"\u003eDen nya grillen vet ännu inte om den blir en sjuårsgrill eller en femtonårsgrill. Det avgörs under veckorna som kommer, inte om ett halvt decennium.\u003c/span\u003e\u003c/p\u003e"},"type":"gp-section-632042913333117890"},"gp_section_632042913333183426":{"settings":{"checksum":"4673b26845d2153da0f763cb5634ce6ac0663efe3bc6f66a941ec9d6d3e905d7_1_1_1_0__1","gg5knyehVEx_text":"\u003cp\u003eAv \u003cstrong\u003eAnders Johansson.\u003c/strong\u003e\u003c/p\u003e","ggM51wRYsAX_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_-_2026-08-04T063116.503.png","ggM51wRYsAX_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_-_2026-08-04T063116.503.png","ggM51wRYsAX_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggQqOoPJHpx_text":"\u003cspan style=\"background-color:transparent;color:#1b2a3a;\"\u003e\u003cstrong\u003e5 ANLEDNINGAR TILL VARFÖR DIN NYA GRILLS LIVSLÄNGD — SJU ÅR ELLER FEMTON — AVGÖRS DEN HÄR SOMMAREN\u003c/strong\u003e\u003c/span\u003e","ggcRx4s-HQ4_text":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#5f6a76;\"\u003e\u003ci\u003eDin förra grill rostade inte sönder på grund av vädret, märket eller hur ofta du grillade. Den nya behöver inte gå samma väg. Men beslutet tas tidigare än de flesta tror.\u003c/i\u003e\u003c/span\u003e\u003c/p\u003e","gghBWMjoA6E_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Skarmbild_2026-05-15_085739.png","gghBWMjoA6E_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791","gghBWMjoA6E_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791","ggyK8xEtS-K_label":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#FFFFFF;\"\u003e\u003cstrong\u003eLäs innan du tänder den nya grillen →\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggyzO0V7arV_text":"\u003cp\u003eSenast uppdaterad 3 juni 2026.\u003c/p\u003e"},"type":"gp-section-632042913333183426"},"gp_section_632042913333248962":{"settings":{"checksum":"58424507f00c8ded907c26ad0ece7edaee52244840d53b330ba68ac3cfe5e7a9_1_1_1_0__1","ggXVwZhmAuK_text":"\u003cp\u003e\u003ci\u003e\u003cstrong\u003eRent galler varje gång. Inte bara när du orkar.\u0026nbsp;\u003c/strong\u003e\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ci\u003e\u003cstrong\u003e30 dagars öppet köp, inga frågor ställs.\u0026nbsp;\u003c/strong\u003e\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ci\u003e\u003cstrong\u003eFri frakt inom Sverige.\u003c/strong\u003e\u003c/i\u003e\u003c/p\u003e"},"type":"gp-section-632042913333248962"},"gp_section_632042913333314498":{"settings":{"checksum":"f8ea72a5ce3f3db1baf60e02fb2ce5fbea54141c8bf867406117f49eac96f137_1_1_1_0__1","gg4KQlTtUYv_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Mikael T.\u003