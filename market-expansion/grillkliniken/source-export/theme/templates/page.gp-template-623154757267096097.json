,"gg5HKHt_pbr_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/2005/9307/files/Rectangle_41017.png","gg5HKHt_pbr_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif","ggC0xmYDikw_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggC0xmYDikw_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggPDY2CMjIb_text":"STÅLBORSTEN SKRAPAR YTAN. FETTET SITTER KVAR.","ggso_0gGOT3_text":"\u003cp\u003eTjugo minuter. Armarna värker. Gallret ser okej ut efteråt.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eMen det inbrända fettet som sitter djupt nere i springorna, lager på lager, grillning efter grillning, det rör den sig aldrig. Den skrapar ytan och lämnar allt under. Varje grillning bränner bara fast mer ovanpå det gamla.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eSju år. Samma resultat varje gång.\u003c/p\u003e"},"type":"gp-section-623154757401772577"},"gp_section_623154757401838113":{"settings":{"checksum":"231bc3b0bc97d7b978d29c4f777b33b5b3b621d836f98a45b5421972cf9f3b62_1_1_1_0__1","gg12G0kUpIa_text":"\u003cp\u003eLökhalvan missar inte bara problemet, den packar fettet tätare ner i springorna. Nästa grillning blir sämre, inte bättre.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eWeber-borsten med det bekvämare handtaget? Samma mekanism. Samma resultat. Och Weber erkänner det själva skriftligt: borststrån lossnar under normal användning och följer med i maten.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eBorst på ett handtag når aldrig dit fettet faktiskt sitter. Det är fysik, inte kvalitet.\u003c/p\u003e","gg3g8HZ9t2b_text":"LÖKHALVAN. FOLIEN. DEN DYRA WEBER-BORSTEN. SAMMA SAK.","gglGdc5Sduj_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/just-got-my-new-to-me-22-weber-charcoal-grill-and-looking-v0-76fvb0sm010d1.webp","gglGdc5Sduj_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png"},"type":"gp-section-623154757401838113"},"gp_section_623154757401903649":{"settings":{"checksum":"886046fd37b2657af95a34252fabdeb88dcf8c98f1f966cd32813423dd705dba_1_1_1_0__1","ggLThU8b6u0_label":"\u003cp\u003eByt ut borsten en gång för alla\u003c/p\u003e","ggQ4xMGzK7h_text":"DET FETTET ÄR INTE BARA ÄCKLIGT — DET ÄR FRÄTANDE","ggdzeecRZdG_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggdzeecRZdG_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_11.gif","ggj1ylP6WCi_text":"\u003cp\u003eDet här är delen ingen pratar om.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eInbränt fett biter sig fast i metallen och äter sakta på din grill underifrån. Missfärgning blir rost. Rost blir ett galler som spjälkar och brännare som kärvar. En grill som ska hålla i femton år håller kanske sju.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDu skrubbade i sju år och trodde att du underhöll grillen. Du fördröjde bara skadan.\u003c/p\u003e","ggzJY0t-gH4_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif"},"type":"gp-section-623154757401903649"},"gp_section_623154757401969185":{"settings":{"checksum":"1cafb9fa374517a136a7f6f03d8d85c4c617dcc22a443408265e27063c129db2_1_1_1_0__1","gg42Me8D_t5_text":"DET KRÄVS ROTATION — INTE MER ARMKRAFT","gg8FQhJxsPM_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","gg8FQhJxsPM_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","ggnhVRgAr0d_text":"\u003cp\u003ePå en restaurang har du inte tid att gnugga ett galler i tjugo minuter. Och du får ändå inte loss det inbrända fettet med ren armkraft.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet krävs rotation för att bryta den bindningen.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eGrillklinikens Master snurrar fyrahundra varv i minuten mot gallret. Värm upp gallret, doppa huvudet i vatten, kör. Ångan gör halva jobbet, fettet bara släpper. Ett drag lyfter mer än stålborsten fick på tjugo minuter.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eInga lösa strån. Ingen armkraft. Inget fettstänk på kläderna.\u003c/p\u003e"},"type":"gp-section-623154757401969185"},"gp_section_623154757402034721":{"settings":{"checksum":"f8c3feac686c45700d07cf49931ba3d9be52d59396c6766690c2ea4792ec2cf7_1_1_1_0__1","gg1Lydu5nRs_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","gg1Lydu5nRs_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggA904-0DfB_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e","ggdcYl02jms_text":"\u003cp\u003eTjugo sekunder med stålborsten, ett drag med Mastern, samma galler. Det är inte ens nära.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003ePinsamt att jag skrubbade i sju år och trodde att jag gjorde något. Allt det här satt i gallret hela tiden.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e999 kr. Billigare än att förstöra en grill för 15 000. Rengör bättre än någon borste du någonsin betalat för, annars pengarna tillbaka, inga frågor.\u003c/p\u003e","ggkk6_gC4qd_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggkk6_gC4qd_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggp87Wb3FFa_text":"\u003cstrong\u003eETT GALLER. SEXTIO SEKUNDER. KOLLA SKILLNADEN.\u003c/strong\u003e"},"type":"gp-section-623154757402034721"}},"order":["gp_section_623154757401575969","gp_section_623154757401707041","gp_section_623154757401772577","gp_section_623154757401838113","gp_section_623154757401903649","gp_section_623154757401969185","gp_section_623154757402034721","gp_section_623154757401510433","gp_section_623154757401444897","gp_section_623154757401313825","gp_section_623154757401379361","gp_section_623154757401641505"],"layout":"theme.gempages.footer"}