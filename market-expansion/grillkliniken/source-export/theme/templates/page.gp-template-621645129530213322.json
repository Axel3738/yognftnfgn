    "gp_section_621645129698313162": {
      "settings": {
        "checksum": "d4405d58850098367c676d5bc3499fc353760cc6d160581a80c54239fd6026f2_1_1_1_0__1",
        "ggePKcDJ1a3_text": "<p>OBS: Detta är reklam.<br><a href=\"mailto:kundsupport@grillkliniken.se\">kundsupport@grillkliniken.se</a><br>Grillkliniken.se</p>",
        "ggnjSBAEvhs_text": "<p>|</p>",
        "ggwJwnj2Az7_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png",
        "ggwJwnj2Az7_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png",
        "ggwJwnj2Az7_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png"
