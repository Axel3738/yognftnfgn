{"sections":{"gp_section_623149626861552408":{"settings":{"checksum":"bf744bb45ce92dc3dab6f03650e09768459758683109adf39fe9cddf5d99ba3a_1_1_1_0__1","gg5HKHt_pbr_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/2005/9307/files/Rectangle_41017.png","gg5HKHt_pbr_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif","ggC0xmYDikw_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggC0xmYDikw_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggPDY2CMjIb_text":"DU TRODDE DET VAR HANDLAGET. DET VAR DET INTE.","ggso_0gGOT3_text":"\u003cp\u003eDu har läst på. Köpt termometer. Bytt slaktare. Vilat köttet längre. Bytt från propan till kol och tillbaka igen.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOch ändå. Gästerna säger gott. Det artiga gott. Aldrig det där tre sekunders tystnaden följt av — vad har du gjort?\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet är en speciell sorts frustration. Att göra allt rätt och ändå hamna tvåa. Att lägga tid, pengar och stolthet på varje grillkväll och se grannen, samma grill, samma råvaror, få den reaktionen du jobbat mot hela säsongen.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDu har skyllt på köttet. På gasen. På temperaturen. På allt utom det som faktiskt orsakar det.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet sitter i gallret.\u003c/p\u003e"},"type":"gp-section-623149626861552408"},"gp_section_623149626861617944":{"settings":{"checksum":"91ae09e3daeed7b75ff187691a0f989365554ce97af55ea86214e72fc34da37d_1_1_1_0__1","gg1Lydu5nRs_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","gg1Lydu5nRs_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggA904-0DfB_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e","ggdcYl02jms_text":"\u003cp\u003e999 kr. Delat på tio säsonger. Det är 99 kr per grillsommar, mindre än två billiga stålborstar per år, som ändå rostade, tappade strån och gav ett halvdant resultat.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eSex år av att vara tvåa vid din egen grill. Det enda som behövdes var en minut.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eProva den vid din egen grill. Om gallret inte är rent på sextio sekunder, full återbetalning utan ett enda frågetecken. Du riskerar ingenting utom att sluta vara tvåa.\u003c/p\u003e","ggkk6_gC4qd_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggkk6_gC4qd_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggp87Wb3FFa_text":"\u003cstrong\u003eNÄSTA MIDDAG TYSTNAR GRANNEN\u003c/strong\u003e"},"type":"gp-section-623149626861617944"},"gp_section_623149626861683480":{"settings":{"checksum":"27d6ef5d06f05ba02058eb47132dd18c263ebb824163b559f666aea42f33af54_1_1_1_0__1","ggN_Y62y1x6_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggaJsxiAN7L_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggaJsxiAN7L_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggaJsxiAN7L_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggicEtHSQob_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e"},"type":"gp-section-623149626861683480"},"gp_section_623149626861749016":{"settings":{"checksum":"0051e7307f6e9d34289a50356b32076e450e8db1f4ad195cfc0d6a921662fb71_1_1_1_0__1","ggXVwZhmAuK_text":"\u003cp\u003e\u003ci\u003e\u003cstrong\u003eRent galler varje gång. Inte bara när du orkar.\u0026nbsp;\u003c/strong\u003e\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ci\u003e\u003cstrong\u003e30 dagars öppet köp, inga frågor ställs.\u0026nbsp;\u003c/strong\u003e\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ci\u003e\u003cstrong\u003eFri frakt inom Sverige.\u003c/strong\u003e\u003c/i\u003e\u003c/p\u003e"},"type":"gp-section-623149626861749016"},"gp_section_623149626861814552":{"settings":{"checksum":"2bf1158183fe92f77297e8b6c57d503955426ec6d1fa47b4312ed0fef944dbc1_1_1_1_0__1","gg4KQlTtUYv_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Mikael T.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","gg5PSJ4Q-GY_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eEn till stugan också\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","gg7NpbaGO4B_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Johan S.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggArOemGYsb_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eFrun nöjd att borsten försvann\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggBgWMJwY3q_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003ePerfekt start på säsongen\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggFSVFalSQB_text":"\u003cp\u003e\u003cstrong\u003e4.7 / \u003c/strong\u003e60 recensioner\u003c/p\u003e","ggFXZ2-NMIt_text":"\u003cspan style=\"background-color:#FF3B00;color:#FFFFFF;\"\u003eKundrecensioner\u003c/span\u003e","ggFlRB-uzyw_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eNormalt ett jobb jag skjuter upp i en halvtimme. Nu tar det knappt en minut.\u003c/span\u003e\u003c/p\u003e","ggJl5RX_A0Q_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Marcus A.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggNo76XJh-k_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Peter N.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggSHNHBn1Un_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eKöpte en till stugan också. Enkelt funkar och inga konstigheter.\u003c/span\u003e\u003c/p\u003e","ggS_u_DFeUK_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eTog fram grillen inför Valborg och gallret var ruttet efter vintern. En omgång med borsten och det var klart.\u003c/span\u003e\u003c/p\u003e","ggV4zCx8JFi_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eFunkar på gjutjärn\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggVTB4Wo5dC_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eSkjuter inte upp rengöringen längre\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggVq9E-t-bu_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eSlängde stålborsten direkt\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","gg_NQzOCssC_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eFörväntade mig ännu ett Kinapynt men den här känns robust. Motorn har kraft nog för inbränt fett.\u003c/span\u003e\u003c/p\u003e","ggdqSjETRqH_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eKänns robust\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggeUbajTDbj_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eTog lite tid att vänja sig vid rätt vinkel men när man fått kläm går det snabbt. Frun är nöjd att stålborsten försvann.\u003c/span\u003e\u003c/p\u003e","ggjLRRM2pbv_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Christer F.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggo0FuGe01V_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Tomas W.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggrYefE8m-M_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eHittade ett borststrå i hamburgaren förra sommaren och det var nog. Den här känns gedigen och inte något TV-shop-pynt.\u003c/span\u003e\u003c/p\u003e","ggreutcPGpi_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Rickard B.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggymToTtxGn_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eHade farhågor om att den skulle repa gjutjärnet på min Napoleon men det gick fint.\u003c/span\u003e\u003c/p\u003e"},"type":"gp-section-623149626861814552"},"gp_section_623149626861880088":{"settings":{"checksum":"6dd5188fb90a0a2fd7a380ba98c4b9539328fdb2f897925cc7eb78a276bd6c67_1_1_1_0__1","gg0aF2u8lyT_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","gg0aF2u8lyT_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","gg0aF2u8lyT_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","ggQYsDDjz8q_label":"\u003cp\u003eBeställ Mastern — Fri frakt\u003c/p\u003e","ggcSRSH48Jn_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg","ggcSRSH48Jn_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg","ggxMUIlaaZR_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg"},"type":"gp-section-623149626861880088"},"gp_section_623149626861945624":{"settings":{"checksum":"d5ef8d43d9f79ac2c05730d81a0f230f16c6e9e6072c3ddc6b2945dd046bae3e_1_1_1_0__1","section_preload":"true"},"type":"gp-section-623149626861945624"},"gp_section_623149626862011160":{"settings":{"checksum":"c9b130e9128fa6b3e7f26baf449c1fce14718bb0a97e059a72d39616c808fd25_1_1_1_0__1","ggePKcDJ1a3_text":"\u003cp\u003eOBS: Detta är reklam.\u003cbr\u003e\u003ca href=\"mailto:kundsupport@grillkliniken.se\"\u003ekundsupport@grillkliniken.se\u003c/a\u003e\u003cbr\u003eGrillkliniken.se\u003c/p\u003e","ggnjSBAEvhs_text":"\u003cp\u003e|\u003c/p\u003e","ggwJwnj2Az7_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png","ggwJwnj2Az7_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png","ggwJwnj2Az7_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png"},"type":"gp-section-623149626862011160"},"gp_section_623149626862076696":{"settings":{"checksum":"7bb892ff7362b77ad1547354933f99fa6ff09c6527202519699ad670b8664574_1_1_1_0__1","gg12G0kUpIa_text":"\u003cp\u003eVarje grillning du gjort de senaste åren har lämnat något kvar. Fett som sjunkit ner i springorna mellan gallerstängerna. Kolrester som byggts på. Lager för lager, säsong efter säsong, tills det sitter fast hårt som lack.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet fettet värms upp på nytt varje gång du tänder grillen. Det ryker. Det sätter bismak. Och det isolerar ytan mellan köttet och gallret — förhindrar den direktkontakt som ger den där perfekta stekytan.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eKöttet fastnar lite. Ryker konstigt. Stekytan blir aldrig riktigt jämn. Du skyller på köttet. Det var aldrig köttet.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eJournal of Food Science 2024 bekräftade det vetenskapligt: inbränt fett på grillgallret påverkar smakämnena i köttet negativt med upp till 34 procent. Det är inte en liten detalj. Det är skillnaden mellan gott och det här är det bästa jag ätit.\u003c/p\u003e","gg3g8HZ9t2b_text":"SEX ÅRS FETT ISOLERAR KÖTTET FRÅN VÄRMEN","gglGdc5Sduj_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/just-got-my-new-to-me-22-weber-charcoal-grill-and-looking-v0-76fvb0sm010d1.webp","gglGdc5Sduj_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_11.gif"},"type":"gp-section-623149626862076696"},"gp_section_623149626862142232":{"settings":{"checksum":"4cfd35090ab512df7fe591c9c74c082316d8346441ef9e07154b655ea3a65478_1_1_1_0__1","gg42Me8D_t5_text":"GRANNENS HEMLIGHET VAR INTE ETT HANDLAG — DET VAR ETT VERKTYG","gg8FQhJxsPM_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","gg8FQhJxsPM_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","ggnhVRgAr0d_text":"\u003cp\u003eHan lutade sig över häcken en kväll och frågade vad du rengjorde gallret med. Stålborste, sa du. Han log. Då har du aldrig rengjort det.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eHan visade dig sitt galler. Blankt ända ner i springorna. Ditt såg rent ut på toppen, men under satt år av gammalt fett, hårt som lack.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eGrillklinikens Master snurrar mot gallret istället för att skrapa. Rotationen på över 400 varv per minut bryter loss fettet underifrån, når ner i springorna där en vanlig borste aldrig kommer. Inga lösa borststrån. Inget hårt tryck.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eEn knapp. Sextio sekunder. Gallret blänker innan du lägger på köttet.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOch eftersom det tar sextio sekunder gör du det varje gång, inte bara när gästerna kommer. Det är hela poängen: inte ett projekt du skjuter upp. En rutin lika självklar som att vila köttet efteråt.\u003c/p\u003e"},"type":"gp-section-623149626862142232"},"gp_section_623149626862207768":{"settings":{"checksum":"30b2173912d16025bf1b93971521fc5a73bf058e4306c809b96325d7f53a201d_1_1_1_0__1","ggLThU8b6u0_label":"\u003cp\u003eByt ut borsten en gång för alla\u003c/p\u003e","ggQ4xMGzK7h_text":"DIN STÅLBORSTE LÖSER DET INTE — DEN DÖLJER DET","ggdzeecRZdG_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggdzeecRZdG_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggj1ylP6WCi_text":"\u003cp\u003eDu rengjorde gallret. Det vet du. Tjugo minuter, armarna värkte, händerna luktade fett.\u003c/p\u003e\u003cp\u003eMen grannen ställde samma fråga när han såg ditt galler: med vad?\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eEn stålborste skrapar på ytan. Den ser ut att göra ett jobb, och det gör den, på ytan. Fettet i springorna, det gamla fettet som sitter fast djupt mellan gallerstängerna, når den aldrig. Du tror att gallret är rent. Det är det inte. Det är bara lätt rengjort uppifrån.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOch sedan lägger du på köttet igen. Och fettet från förra veckan värms upp igen. Och bismaken är tillbaka igen.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eWeber erkänner det dessutom själva skriftligt på sin egen supportsida: borststrån lossnar under normal användning och följer med i maten. I februari 2026 återkallade Weber 3,2 miljoner stålborstar i USA. I Sverige sitter de fortfarande kvar. På Jula. På Biltema. Bredvid din Weber.\u003c/p\u003e","ggzJY0t-gH4_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif"},"type":"gp-section-623149626862207768"},"gp_section_623149626862273304":{"settings":{"checksum":"f1591a2807b84cf8554aa110eb0756a7cdb86a37613724245d44be6498f8dfdf_1_1_1_0__1","gg5knyehVEx_text":"\u003cp\u003eAv \u003cstrong\u003eAnders Johansson.\u003c/strong\u003e\u003c/p\u003e","ggM51wRYsAX_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggM51wRYsAX_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_74.png","ggM51wRYsAX_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggQqOoPJHpx_text":"5 ANLEDNINGAR TILL VARFÖR GRANNEN ALLTID FÅR REAKTIONEN DU VÄNTAT PÅ","ggcRx4s-HQ4_text":"\u003cp\u003eSamma grill. Samma kött. Samma slaktare. Skillnaden har ingenting med handlag att göra.\u003c/p\u003e","gghBWMjoA6E_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Skarmbild_2026-05-15_085739.png","gghBWMjoA6E_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791","gghBWMjoA6E_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791","ggyK8xEtS-K_label":"\u003cp\u003eSe vad han visste som du inte visste →\u003c/p\u003e","ggyzO0V7arV_text":"\u003cp\u003eSenast uppdaterad 15 maj 2026.\u003c/p\u003e"},"type":"gp-section-623149626862273304"}},"order":["gp_section_623149626861945624","gp_section_623149626862273304","gp_section_623149626861552408","gp_section_623149626862076696","gp_section_623149626862207768","gp_section_623149626862142232","gp_section_623149626861617944","gp_section_623149626861880088","gp_section_623149626861814552","gp_section_623149626861683480","gp