r:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Rickard B.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggymToTtxGn_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eHade farhågor om att den skulle repa gjutjärnet på min Napoleon men det gick fint.\u003c/span\u003e\u003c/p\u003e"},"type":"gp-section-621654614210642531"},"gp_section_621654614210708067":{"settings":{"checksum":"f1b2ffe08d99fc7a0491e604fb4d26db8538fa9f10423fa997f3abaa8a282199_1_1_1_0__1","gg0aF2u8lyT_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","gg0aF2u8lyT_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","gg0aF2u8lyT_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_3.png","ggQYsDDjz8q_label":"\u003cp\u003eBeställ Mastern — Fri frakt\u003c/p\u003e","ggcSRSH48Jn_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg","ggcSRSH48Jn_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg","ggxMUIlaaZR_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4286.jpg"},"type":"gp-section-621654614210708067"},"gp_section_621654614210773603":{"settings":{"checksum":"d0eb6925e5ce30f938bdc5997f5affaa72b23addc7f9a65bf4eccfddae48ec1a_1_1_1_0__1","section_preload":"true"},"type":"gp-section-621654614210773603"},"gp_section_621654614210839139":{"settings":{"checksum":"c024fb0b545c111b8fa18eee53be88a43037deea55c00e8a5e02e73b3fa5293f_1_1_1_0__1","ggePKcDJ1a3_text":"\u003cp\u003eOBS: Detta är reklam.\u003cbr\u003e\u003ca href=\"mailto:kundsupport@grillkliniken.se\"\u003ekundsupport@grillkliniken.se\u003c/a\u003e\u003cbr\u003eGrillkliniken.se\u003c/p\u003e","ggnjSBAEvhs_text":"\u003cp\u003e|\u003c/p\u003e","ggwJwnj2Az7_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png","ggwJwnj2Az7_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png","ggwJwnj2Az7_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_4.png"},"type":"gp-section-621654614210839139"},"gp_section_621654614210904675":{"settings":{"checksum":"f9bd1efa8440b59254fd53b72a39965aa588ddfb9346ed6f11b30dbf38094712_1_1_1_0__1","gg12G0kUpIa_text":"\u003cp\u003eFettet från varje grillning sjunker ner i springorna mellan gallerstängerna. Kolrester bygger på sig. Gamla matrester packas djupare för varje säsong.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eNär du sedan tänder grillen värms allt det gamla upp på nytt. Det ryker. Det sätter smak. Det isolerar ytan mellan köttet och gallret och förstör den direktkontakt som ger den där perfekta stekytan.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eBismaken du inte kan sätta fingret på? Det är inte köttet. Det är inte gasen. Det är varje grillning du gjort de senaste tre åren som sitter kvar i springorna.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eJournal of Food Science mätte det 2024: inbränt fett på grillgallret försämrar smaken på köttet med upp till 34 procent. Det är inte en liten detalj. Det är skillnaden mellan det artiga \u003ci\u003egott\u003c/i\u003e — och tre sekunders tystnad följt av: \u003ci\u003evad har du gjort annorlunda?\u003c/i\u003e\u003c/p\u003e","gg3g8HZ9t2b_text":"ETT SMUTSIGT GALLER FÖRSTÖR KÖTTET INNAN DU ENS BÖRJAT","gglGdc5Sduj_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/just-got-my-new-to-me-22-weber-charcoal-grill-and-looking-v0-76fvb0sm010d1.webp","gglGdc5Sduj_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_11.gif"},"type":"gp-section-621654614210904675"},"gp_section_621654614210970211":{"settings":{"checksum":"01e1e3a7db22ad4a1c826e2f2dce10d8a7591fe707beecc6e7d0c16ac1530375_1_1_1_0__1","ggLThU8b6u0_label":"\u003cp\u003eByt ut borsten en gång för alla\u003c/p\u003e","ggQ4xMGzK7h_text":"DIN STÅLBORSTE LÖSER INTE PROBLEMET — OCH LÖKHALVAN GÖR DET VÄRRE","ggdzeecRZdG_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggdzeecRZdG_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060048_550c3444-485b-4d56-bd78-edceaec95db2.png","ggj1ylP6WCi_text":"\u003cp\u003eEn vanlig stålborste skrapar på ytan. För en stund ser gallret okej ut. Men fettet i springorna har inte förändrats ett dugg. Nästa gång du tänder grillen är det tillbaka. Bismaken är tillbaka.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet första jag gör när någon visar mig sin grillborste är att lägga undan den.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOch lökhalvan, den som folk svär på, den missar inte bara problemet. Den skrapar fettet längs ytan och packar det tätare ner i springorna. Nästa grillning blir sämre, inte bättre.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet enda som faktiskt löser problemet är att nå dit fettet sitter. Inte att skrapa hårdare på ytan.\u003c/p\u003e","ggzJY0t-gH4_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif"},"type":"gp-section-621654614210970211"},"gp_section_621654614211035747":{"settings":{"checksum":"fb70f270e49c8aedb864f156670b6c6f2c21710a0c5461ad4f1d5477f9dc09fd_1_1_1_0__1","gg5HKHt_pbr_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/2005/9307/files/Rectangle_41017.png","gg5HKHt_pbr_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif","ggC0xmYDikw_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggC0xmYDikw_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggPDY2CMjIb_text":"DET FÖRSTA JAG GÖR ÄR ATT KOLLA PÅ DIN GRILL","ggso_0gGOT3_text":"\u003cp\u003eFolk ber mig om hemligheten bakom en oförglömlig köttbit. De förväntar sig att jag ska prata om marinad, temperatur, vilotid.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet gör jag inte.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet första jag gör är att lyfta locket på deras grill.\u003c/p\u003e\u003cp\u003eFör efter trettio år i köket vet jag en sak som de flesta hemmagrillare aldrig fått höra: problemet sitter nästan aldrig i köttet. Det sitter i miljön köttet landar i.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOch den miljön, gallret, springorna, det inbrända fettet från varje tidigare grillning, det är vad som avgör om din köttbit blir oförglömlig eller bara okej.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDu känner igen det. Den sommarkvällen när allt stämde och köttet var perfekt. Och alla andra kvällar när du försökt återskapa det, men det är alltid något. En bismak du inte kan sätta fingret på. En stekyta som aldrig riktigt levererar.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet är inte otur. Det är gallret.\u003c/p\u003e"},"type":"gp-section-621654614211035747"},"gp_section_621654614211101283":{"settings":{"checksum":"b9c56e2fd1c3990db6afef188ad9f968353d3836bf055d93b2a3e92bcf538213_1_1_1_0__1","gg1Lydu5nRs_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","gg1Lydu5nRs_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggA904-0DfB_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e","ggdcYl02jms_text":"\u003cp\u003eJag har provat det mesta under trettio år. Det enda verktyg jag rekommenderar är det som faktiskt når dit fettet sitter.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eGrillklinikens Master snurrar mot gallret istället för att skrapa. Rotationen bryter loss fettet underifrån och upp, når ner i springorna där en vanlig borste aldrig kommer. Inga lösa borststrån. Inget hårt tryck.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eEn knapp. Sextio sekunder. Gallret är rent på riktigt, inte bara lätt på ytan.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDirekt kontakt mellan köttet och gallret. Ingen gammal smak. Ingen rök från förra grillningen. Bara köttet och värmen, precis som det ska vara.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDu som betalat 7 000 kr för din grill ska inte låta en 200-kr-borste sabotera resultatet varje gång. Det är ett kalkylfel.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e30 dagars öppet köp. Inte nöjd, full återbetalning, inga frågor. Det värsta som kan hända är att du slutar skrubba för hand.\u003c/p\u003e","ggkk6_gC4qd_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggkk6_gC4qd_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/e_4.gif","ggp87Wb3FFa_text":"\u003cstrong\u003eDET ÄR DÄRFÖR JAG REKOMMENDERAR GRILLKLINIKENS MASTER TILL ALLA SOM FRÅGAR MIG\u003c/strong\u003e"},"type":"gp-section-621654614211101283"},"gp_section_621654614211166819":{"settings":{"checksum":"e40cee348ef6fda9f3ea72b10def18e2eb831acbaf4e05b17ac143e9f24575d0_1_1_1_0__1","gg42Me8D_t5_text":"RÄTT UNDERHÅLL TAR SEXTIO SEKUNDER — INTE TJUGO MINUTER","gg8FQhJxsPM_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","gg8FQhJxsPM_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Fore.png","ggnhVRgAr0d_text":"\u003cp\u003eVarje grillexpert säger att du ska hålla gallret rent. Men ingen förklarar vad det faktiskt innebär.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDet handlar inte om att skrubba hårdare efter varje grillning. Det handlar om att aldrig låta träsket byggas upp från början, att ta bort fettet, kolresterna och matresterna direkt, innan de hinner bränna fast till ett lager som förstör nästa kväll.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDu förstör ingenting. Du återställer.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eDu håller gallret i det skick det ska vara i, rent, varje gång, precis som på restaurangen. Och när verktyget tar sextio sekunder istället för tjugo minuter är det inte längre ett projekt du skjuter upp. Det blir en rutin lika självklar som att vila köttet efteråt.\u003c/p\u003e"},"type":"gp-section-621654614211166819"},"gp_section_621654614211232355":{"settings":{"checksum":"9b5f837cf885c118378c006fb4120880ca90b58936a482c0e437807da55818c0_1_1_1_0__1","gg5knyehVEx_text":"\u003cp\u003eAv \u003cstrong\u003eAnders Johansson.\u003c/strong\u003e\u003c/p\u003e","ggM51wRYsAX_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggM51wRYsAX_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_74.png","ggM51wRYsAX_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggQqOoPJHpx_text":"5 saker en kock med 30 års erfarenhet kollar på din grill — innan han ens pratar om köttet","ggcRx4s-HQ4_text":"\u003cp\u003eVarje gång någon frågar mig varför deras kött inte smakar som på restaurang börjar jag på samma ställe. Aldrig med köttet.\u003c/p\u003e","gghBWMjoA6E_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Skarmbild_2026-05-15_085739.png","gghBWMjoA6E_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791","gghBWMjoA6E_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791","ggyK8xEtS-K_label":"\u003cp\u003eLäs innan du tänder grillen\u003c/p\u003e\u003cp\u003e\u0026nbsp;→\u003c/p\u003e","ggyzO0V7arV_text":"\u003cp\u003eSenast uppdaterad 15 maj 2026.\u003c/p\u003e"},"type":"gp-section-621654614211232355"}},"order":["gp_section_621654614210773603","gp_section_621654614211232355","gp_section_621654614211035747","gp_section_621654614210904675","gp_section_621654614210970211","gp_section_621654614211166819","gp_section_621654614211101283","gp_section_621654614210708067","gp_section_621654614210642531","gp_section_621654614210511459","gp_section_621654614210576995","gp_section_621654614210839139"],"layout":"theme.gempages.footer"}