{"sections":{"gp_section_621654614210511459":{"settings":{"checksum":"e89e7d5eb082e90ea119193c31a8f0fb8683b2c9ee6e617a652f2ea21c221a9f_1_1_1_0__1","ggN_Y62y1x6_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggaJsxiAN7L_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggaJsxiAN7L_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggaJsxiAN7L_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Lagg_till_en_rubrik_1.png","ggicEtHSQob_label":"\u003cp\u003eSe erbjudandet nu\u003c/p\u003e"},"type":"gp-section-621654614210511459"},"gp_section_621654614210576995":{"settings":{"checksum":"69a61e47ee2a7d4d05a3504f63ed9a76d7471d333d1a9d813d1a3b6cb1284e5c_1_1_1_0__1","ggXVwZhmAuK_text":"\u003cp\u003e\u003ci\u003e\u003cstrong\u003eRent galler varje gång. Inte bara när du orkar.\u0026nbsp;\u003c/strong\u003e\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ci\u003e\u003cstrong\u003e30 dagars öppet köp, inga frågor ställs.\u0026nbsp;\u003c/strong\u003e\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ci\u003e\u003cstrong\u003eFri frakt inom Sverige.\u003c/strong\u003e\u003c/i\u003e\u003c/p\u003e"},"type":"gp-section-621654614210576995"},"gp_section_621654614210642531":{"settings":{"checksum":"bb8783e56d5d8665bfe25226334277ba273460cc687df439fddf33939e145ee0_1_1_1_0__1","gg4KQlTtUYv_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Mikael T.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","gg5PSJ4Q-GY_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eEn till stugan också\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","gg7NpbaGO4B_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Johan S.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggArOemGYsb_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003eFrun nöjd att borsten försvann\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggBgWMJwY3q_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003ePerfekt start på säsongen\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggFSVFalSQB_text":"\u003cp\u003e\u003cstrong\u003e4.7 / \u003c/strong\u003e60 recensioner\u003c/p\u003e","ggFXZ2-NMIt_text":"\u003cspan style=\"background-color:#FF3B00;color:#FFFFFF;\"\u003eKundrecensioner\u003c/span\u003e","ggFlRB-uzyw_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eNormalt ett jobb jag skjuter upp i en halvtimme. Nu tar det knappt en minut.\u003c/span\u003e\u003c/p\u003e","ggJl5RX_A0Q_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Marcus A.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggNo76XJh-k_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003e\u003cstrong\u003e- Peter N.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e","ggSHNHBn1Un_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eKöpte en till stugan också. Enkelt funkar och inga konstigheter.\u003c/span\u003e\u003c/p\u003e","ggS_u_DFeUK_text":"\u003cp\u003e\u003cspan style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"\u003eTog fram grillen inför Valborg och gallret var ruttet efter vintern. En omgång med borsten och det var klart.\u003c/span\u003e\u003c/p\u003e","ggV4zCx8JFi_text":"\u003cp\u003e