    "gp_section_620621395671712743": {
      "settings": {
        "checksum": "079c66622d7507f6c95f6ac3ce500e03f128b58c206a6ba145e661c4c8d0e418_1_1_1_0__1",
        "gg5knyehVEx_text": "<p>Av <strong>Anders Johansson.</strong></p>",
        "ggM51wRYsAX_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png",
        "ggM51wRYsAX_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Namnlos_design_74.png",
        "ggM51wRYsAX_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png",
        "ggQqOoPJHpx_text": "5 ANLEDNINGAR TILL VARFÖR HAN SLUTADE SKYLLA PÅ KÖTTET OCH BÖRJADE TITTA PÅ GALLRET.",
        "ggcRx4s-HQ4_text": "<p>Hans dotter ställde en fråga han aldrig ställt sig själv. Det förändrade hur han grillar.</p>",
        "gghBWMjoA6E_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/Skarmbild_2026-05-15_085739.png",
        "gghBWMjoA6E_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791",
        "gghBWMjoA6E_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260217_124645_31eadc60-b0a9-464e-ab35-6677e400c118_1.webp?v=1777386791",
        "ggyK8xEtS-K_label": "<p>Läs innan du tänder grillen</p><p>&nbsp;→</p>",
        "ggyzO0V7arV_text": "<p>Senast uppdaterad 15 maj 2026.</p>"
