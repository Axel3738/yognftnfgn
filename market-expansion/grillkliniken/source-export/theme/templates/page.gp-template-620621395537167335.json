{"sections":{"gp_section_620621395671385063":{"settings":{"checksum":"6a3130b0df8b1c89f0e8b09e9e716e4a6cc3f0372b829859b0e594be62d56805_1_1_1_0__1","gg5HKHt_pbr_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/2005/9307/files/Rectangle_41017.png","gg5HKHt_pbr_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/download_9.gif","ggC0xmYDikw_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggC0xmYDikw_srcSet_tablet_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/hf_20260515_060630_b31d00e8-9061-44b0-aa3c-46e9db6cdfad.png","ggPDY2CMjIb_text":"HON SÅG VAD HAN NORMALISERAT","ggso_0gGOT3_text":"\u003cp\u003e\"Pappa, ska det verkligen se ut så?\"\u0026nbsp;\u003cbr\u003e\u003cbr\u003eHan hade sett gallret tusen gånger. Svart, inbränt, fett i varenda springa. Men han hade aldrig sett det som hon såg det, som något som inte borde vara där.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eSamma kväll började han gräva. Inbränt fett på gallret isolerar ytan mellan köttet och gallret. Det ryker. Det sätter smak. Bismaken han skyllde på köttet eller gasolen, det var gallret. Hela tiden.\u003cbr\u003e\u003cbr\u003eJournal of Food Science 2024 bekräftade det: inbränt fett påverkar smakämnena i köttet negativt med upp till 34 procent. Det är inte en detalj. Det är skillnaden mellan \"gott\" och \"det här är det bästa jag ätit.\"\u003c/p\u003e"},"type":"gp-section-620621395671385063"},"gp_section_620621395671450599":{"settings":{"checksum":"9108dc296e6600660fe0d0b79a8af0b54faf587b1728878a2315ffbc7eaac479_1_1_1_0__1","ggN_Y62y1x6_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggN_Y62y1x6_background_tablet_image_src":"https://cdn.shopify.com/s/files/1/0947/0174/8548/files/IMG_4290.jpg","ggaJsxiAN7L_srcSet_