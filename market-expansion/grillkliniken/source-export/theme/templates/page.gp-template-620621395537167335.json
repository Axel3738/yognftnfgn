    "gp_section_620621395671581671": {
      "settings": {
        "checksum": "7c9bca85aeba90a546375c12945684bb4a3dda4493aba8ad3de5cb71dce25f61_1_1_1_0__1",
        "gg4KQlTtUYv_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Mikael T.</strong></span></p>",
        "gg5PSJ4Q-GY_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>En till stugan också</strong></span></p>",
        "gg7NpbaGO4B_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Johan S.</strong></span></p>",
        "ggArOemGYsb_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>Frun nöjd att borsten försvann</strong></span></p>",
        "ggBgWMJwY3q_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>Perfekt start på säsongen</strong></span></p>",
        "ggFSVFalSQB_text": "<p><strong>4.7 / </strong>60 recensioner</p>",
        "ggFXZ2-NMIt_text": "<span style=\"background-color:#FF3B00;color:#FFFFFF;\">Kundrecensioner</span>",
        "ggFlRB-uzyw_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Normalt ett jobb jag skjuter upp i en halvtimme. Nu tar det knappt en minut.</span></p>",
        "ggJl5RX_A0Q_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Marcus A.</strong></span></p>",
        "ggNo76XJh-k_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Peter N.</strong></span></p>",
        "ggSHNHBn1Un_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Köpte en till stugan också. Enkelt funkar och inga konstigheter.</span></p>",
        "ggS_u_DFeUK_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Tog fram grillen inför Valborg och gallret var ruttet efter vintern. En omgång med borsten och det var klart.</span></p>",
        "ggV4zCx8JFi_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>Funkar på gjutjärn</strong></span></p>",
        "ggVTB4Wo5dC_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>Skjuter inte upp rengöringen längre</strong></span></p>",
        "ggVq9E-t-bu_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>Slängde stålborsten direkt</strong></span></p>",
        "gg_NQzOCssC_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Förväntade mig ännu ett Kinapynt men den här känns robust. Motorn har kraft nog för inbränt fett.</span></p>",
        "ggdqSjETRqH_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>Känns robust</strong></span></p>",
        "ggeUbajTDbj_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Tog lite tid att vänja sig vid rätt vinkel men när man fått kläm går det snabbt. Frun är nöjd att stålborsten försvann.</span></p>",
        "ggjLRRM2pbv_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Christer F.</strong></span></p>",
        "ggo0FuGe01V_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Tomas W.</strong></span></p>",
        "ggrYefE8m-M_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Hittade ett borststrå i hamburgaren förra sommaren och det var nog. Den här känns gedigen och inte något TV-shop-pynt.</span></p>",
        "ggreutcPGpi_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\"><strong>- Rickard B.</strong></span></p>",
        "ggymToTtxGn_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);\">Hade farhågor om att den skulle repa gjutjärnet på min Napoleon men det gick fint.</span></p>"
      },
      "type": "gp-section-620621395671581671"
    },
