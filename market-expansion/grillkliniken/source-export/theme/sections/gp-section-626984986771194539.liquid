    <!-- ============================================================================
     GRILLKLINIKEN – REVIEW-LISTICLE för GEMPAGES (Lovable-designen som ren HTML/CSS)
     KLISTRA IN i ett "HTML / Liquid"-element i GemPages (ej i temat).
     Byt BUY_URL nedan (sök på grillkliniken.se) om du vill peka på .no.
       SE: https://grillkliniken.se/products/elektrisk-grillborste
       NO: https://grillklinikken.no/products/mastern-risten-skinner-olet-er-kaldt
     Allt är scope:at under .gk så det inte krockar med ditt tema.
     ========================================================================= -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap');

.gk *{box-sizing:border-box;margin:0;padding:0}
.gk{
  --orange:#FF5F1F; --orange-dark:#CC4715; --black:#17171A; --ink:#26262b;
  --gray:#F4F4F5; --text:#1c1c1e; --muted:#71717a; --border:#e6e6e8;
  --success:#16a34a; --danger:#e03a22;
  --font-d:"Bebas Neue",Impact,sans-serif; --font-s:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  --sh-card:0 2px 6px -1px rgba(0,0,0,.06),0 8px 30px -10px rgba(0,0,0,.08);
  --sh-elev:0 20px 60px -20px rgba(0,0,0,.25);
  font-family:var(--font-s); color:var(--text); background:#fff; line-height:1.6; -webkit-font-smoothing:antialiased;
  overflow-x:hidden; width:100%; max-width:100%;
}
.gk *{max-width:100%}
/* Force explicit backgrounds so the component never inherits GemPages' dark section bg */
.gk{background:#fff}
.gk header.hero{background:#fff}
.gk section{background:#fff}
.gk section.dark{background:var(--black)}
.gk section.bg-gray{background:var(--gray)}
.gk .d{font-family:var(--font-d);letter-spacing:.02em;line-height:.92;overflow-wrap:break-word}
.gk img{display:block;max-width:100%}
.gk a{text-decoration:none}
.gk .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.gk .narrow{max-width:768px;margin:0 auto;padding:0 24px}
.gk .mid{max-width:896px;margin:0 auto;padding:0 24px}
.gk .kicker{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.24em;color:var(--orange);margin-bottom:12px}
.gk h2.d{font-size:clamp(34px,6vw,52px);text-transform:uppercase}
.gk .lead{font-size:18px;color:var(--muted);line-height:1.7}
.gk .prose p{font-size:18px;line-height:1.75;color:#3f3f46;margin-bottom:20px}
.gk .prose strong{color:var(--black);font-weight:700}

/* trust bar + nav */
.gk .trust{background:var(--black);color:#fff;text-align:center;font-size:10px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;padding:8px}
.gk .nav{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(0,0,0,.06)}
.gk .nav .row{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;max-width:1120px;margin:0 auto}
.gk .brand{font-family:var(--font-d);font-size:26px;letter-spacing:.01em;color:var(--black)}
.gk .brand span{color:var(--orange)}
.gk .nav-links{display:flex;gap:30px}
.gk .nav-links a{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:rgba(0,0,0,.55)}
.gk .nav-links a:hover{color:var(--black)}
.gk .btn{display:inline-block;font-weight:700;text-transform:uppercase;letter-spacing:.18em;transition:.15s;cursor:pointer}
.gk .btn-orange{background:var(--orange);color:#fff;padding:11px 20px;font-size:11px}
.gk .btn-orange:hover{background:var(--orange-dark)}
.gk .btn-black{background:var(--black);color:#fff;padding:16px 32px;font-size:13px}
.gk .btn-black:hover{background:var(--orange)}
.gk .btn-white{background:#fff;color:var(--black);padding:20px 40px;font-size:13px;letter-spacing:.2em}
.gk .btn-white:hover{transform:scale(1.03)}
.gk .btn-cta{background:var(--orange);color:#fff;padding:16px 32px;font-size:13px}
.gk .btn-cta:hover{background:var(--orange-dark)}

/* hero */
.gk .hero{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding:72px 0}
.gk .pill{display:inline-flex;align-items:center;gap:8px;background:rgba(255,95,31,.1);color:var(--orange);padding:6px 12px;border-radius:5px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;margin-bottom:24px}
.gk .dot{width:6px;height:6px;border-radius:50%;background:var(--orange);display:inline-block}
.gk .hero h1{font-family:var(--font-d);font-size:clamp(44px,7vw,74px);text-transform:uppercase;margin-bottom:22px}
.gk .hero h1 .o{color:var(--orange)}
.gk .hero .lead{max-width:460px;margin-bottom:30px}
.gk .hero-actions{display:flex;flex-wrap:wrap;gap:18px;align-items:center}
.gk .avatars{display:flex}
.gk .avatars span{width:32px;height:32px;border-radius:50%;border:2px solid #fff;margin-left:-8px}
.gk .avatars span:first-child{margin-left:0}
.gk .a1{background:linear-gradient(135deg,#fdba74,#f97316)}
.gk .a2{background:linear-gradient(135deg,#a1a1aa,#3f3f46)}
.gk .a3{background:linear-gradient(135deg,#fbbf24,#ef4444)}
.gk .rate-txt{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(0,0,0,.5);line-height:1.3;margin-left:12px}
.gk .byline{margin-top:38px;padding-top:24px;border-top:1px solid rgba(0,0,0,.1);display:flex;align-items:center;gap:12px}
.gk .byline img{width:44px;height:44px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 1px rgba(0,0,0,.1)}
.gk .byline b{font-size:14px}
.gk .byline .meta{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:rgba(0,0,0,.45)}
.gk .hero-media{position:relative}
.gk .hero-media .frame{width:100%;aspect-ratio:1;border-radius:16px;overflow:hidden;background:var(--gray);box-shadow:var(--sh-elev)}
.gk .hero-media .frame img{width:100%;height:100%;object-fit:cover}
.gk .tag-disc{position:absolute;bottom:-24px;left:-24px;background:#fff;padding:20px 28px 20px 20px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.15);border:1px solid rgba(0,0,0,.05)}
.gk .tag-disc .big{font-family:var(--font-d);font-size:30px;color:var(--orange);line-height:1}
.gk .tag-disc .sub{font-size:10px;font-weight:700;color:rgba(0,0,0,.45);text-transform:uppercase;letter-spacing:.16em;margin-top:4px}
.gk .tag-badge{position:absolute;top:-16px;right:-16px;background:var(--black);color:#fff;width:96px;height:96px;border-radius:50%;display:grid;place-items:center;transform:rotate(8deg);box-shadow:0 8px 20px rgba(0,0,0,.25);text-align:center}
.gk .tag-badge .big{font-family:var(--font-d);font-size:22px;color:var(--orange);line-height:1}
.gk .tag-badge .sub{font-size:9px;text-transform:uppercase;letter-spacing:.18em}

/* snapshot (dark) */
.gk .dark{background:var(--black);color:#fff;padding:80px 0}
.gk .snap-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:16px;margin-bottom:40px}
.gk .snap-head .price{font-family:var(--font-d);font-size:clamp(38px,5vw,52px);color:var(--orange);line-height:1;text-align:right}
.gk .snap-head .price .sub{font-family:var(--font-s);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-top:8px}
.gk .spec{display:grid;grid-template-columns:1fr 1fr;gap:0 56px}
.gk .spec .r{display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.1)}
.gk .spec .k{font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:rgba(255,255,255,.5);flex-shrink:0}
.gk .spec .v{font-size:14px;font-weight:600;text-align:right}
.gk .snap-note{margin-top:36px;max-width:640px;color:rgba(255,255,255,.7);font-size:16px;line-height:1.7}

/* sections */
.gk section.pad{padding:80px 0}
.gk .bg-gray{background:var(--gray)}

/* reviews */
.gk .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.gk .rev{background:#fff;border-radius:12px;padding:24px;box-shadow:var(--sh-card);border:1px solid rgba(0,0,0,.05)}
.gk .rev .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.gk .rev .stars{color:var(--orange);font-size:14px;letter-spacing:.1em}
.gk .rev .stars .off{color:rgba(0,0,0,.15)}
.gk .rev .vf{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:var(--success);background:rgba(22,163,74,.1);padding:2px 8px;border-radius:4px}
.gk .rev p{font-size:14px;color:rgba(0,0,0,.75);line-height:1.6;margin-bottom:16px}
.gk .rev .who{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.16em;color:rgba(0,0,0,.5)}

/* figure */
.gk figure{margin-top:48px;border-radius:16px;overflow:hidden;border:1px solid rgba(0,0,0,.05);background:#fff;box-shadow:var(--sh-card)}
.gk figure img{width:100%;height:auto}
.gk figcaption{padding:16px;font-size:12px;color:rgba(0,0,0,.5);text-transform:uppercase;letter-spacing:.18em;font-weight:600;text-align:center}

/* banner blue */
.gk .banner{position:relative;overflow:hidden;border-radius:16px;padding:56px 40px;color:#fff;box-shadow:var(--sh-elev)}
.gk .banner.blue{background:linear-gradient(135deg,#1e293b,#0f172a 60%,var(--black))}
.gk .banner .tag{display:inline-block;background:rgba(255,255,255,.1);color:rgba(255,255,255,.9);padding:4px 12px;border-radius:5px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.2em;margin-bottom:20px}
.gk .banner h3{font-family:var(--font-d);font-size:clamp(30px,5vw,50px);text-transform:uppercase;margin-bottom:16px;max-width:600px}
.gk .banner p{color:rgba(255,255,255,.7);margin-bottom:30px;max-width:440px}

/* safety split */
.gk .split{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.gk .scard{background:#fff;border-radius:16px;padding:32px;box-shadow:var(--sh-card)}
.gk .scard.red{border-left:4px solid var(--danger)}
.gk .scard.green{border-left:4px solid var(--success)}
.gk .scard .lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.24em;margin-bottom:16px}
.gk .scard.red .lbl{color:var(--danger)}
.gk .scard.green .lbl{color:var(--success)}
.gk .scard h3{font-family:var(--font-d);font-size:30px;text-transform:uppercase;margin-bottom:16px;color:var(--black)}
.gk .scard p{font-size:14px;color:rgba(0,0,0,.7);line-height:1.6}

/* feature grid */
.gk .feat{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.gk .feat .n{font-family:var(--font-d);font-size:40px;color:var(--orange);line-height:1;margin-bottom:12px}
.gk .feat .t{font-weight:700;font-size:16px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}
.gk .feat p{font-size:14px;color:rgba(0,0,0,.6);line-height:1.6}

/* köp/skippa */
.gk .two{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.gk .colcard{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:32px}
.gk .colcard .lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.24em;margin-bottom:20px}
.gk .colcard.yes .lbl{color:var(--success)}
.gk .colcard.no .lbl{color:var(--danger)}
.gk .colcard ul{list-style:none}
.gk .colcard li{display:flex;gap:12px;font-size:15px;line-height:1.4;color:rgba(255,255,255,.85);margin-bottom:12px}
.gk .colcard .mk{font-weight:700;flex-shrink:0}
.gk .colcard.yes .mk{color:var(--success)}
.gk .colcard.no .mk{color:var(--danger)}

/* verdict */
.gk .verd{background:#fff;border:1px solid rgba(0,0,0,.05);border-left:4px solid var(--orange);border-radius:0 12px 12px 0;padding:28px 32px;box-shadow:var(--sh-card);margin-bottom:16px}
.gk .verd .q{font-weight:700;font-size:19px;margin-bottom:8px;color:var(--black)}
.gk .verd p{color:rgba(0,0,0,.65);line-height:1.6}

/* final fire */
.gk .fire{position:relative;overflow:hidden;border-radius:24px;padding:72px 40px;text-align:center;color:#fff;background:linear-gradient(135deg,var(--orange),var(--orange-dark) 55%,var(--black));box-shadow:var(--sh-elev)}
.gk .fire .tag{display:inline-block;background:#fff;color:var(--orange);padding:6px 16px;border-radius:999px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.2em;margin-bottom:24px}
.gk .fire h2{font-family:var(--font-d);font-size:clamp(44px,7vw,72px);text-transform:uppercase;font-style:italic;margin-bottom:22px}
