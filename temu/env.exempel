# Nycklarna till de fem butikerna.
#
# GÖR SÅ HÄR:
#   1. Kopiera den här filen till repots rot och döp den till .env
#         cp temu/env.exempel .env
#   2. Fyll i värdena efter varje = (inga citattecken, inga mellanslag runt =)
#   3. Kolla att allt sitter:  node temu/kolla-lokalt.mjs
#
# .env är redan i .gitignore — den hamnar ALDRIG på GitHub. Skicka den aldrig
# vidare i en chatt heller.
#
# Var uppgifterna står: temu/TOKENS.md (klickväg i Shopify-admin, steg 1–2)

# --- Sverige: bäverbutiken.se ---
SHOPIFY_SHOP_SE=
SHOPIFY_CLIENT_ID_SE=
SHOPIFY_CLIENT_SECRET_SE=

# --- Norge: beverbutikken.no ---
SHOPIFY_SHOP_NO=
SHOPIFY_CLIENT_ID_NO=
SHOPIFY_CLIENT_SECRET_NO=

# --- Danmark: bæverbutiken.dk ---
SHOPIFY_SHOP_DK=
SHOPIFY_CLIENT_ID_DK=
SHOPIFY_CLIENT_SECRET_DK=

# --- Finland: majavakauppa.fi ---
SHOPIFY_SHOP_FI=
SHOPIFY_CLIENT_ID_FI=
SHOPIFY_CLIENT_SECRET_FI=

# --- Storbritannien: beavershop.co.uk ---
SHOPIFY_SHOP_UK=
SHOPIFY_CLIENT_ID_UK=
SHOPIFY_CLIENT_SECRET_UK=

# --- Bildtvätten (tar bort kinesisk text på skördebilder) ---
KIE_API_KEY=
