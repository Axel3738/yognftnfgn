node_modules/
pipeline/output/
*.log
.env

# Agentens isolerade git-worktrees (tillfällig arbetsyta för bakgrundsagenter)
.claude/worktrees/

# Genererade bildannonser — artefakter, inte källkod
bildannonser/output/

# Annonsvaktens kö till Slack-connectorn (att-posta.json) — lever i rutinens session, aldrig i repot
annonsvakt/output/

# Python-bytekod (py_compile, tester)
__pycache__/
market-expansion/no/video-batches/fran-meta/

# Sessionens tillfälliga arbetsyta (nedladdad media, QA-frames) — inte källkod
.scratch/

# OPS-butikernas översättningsbatchar: bara JSON committas, media dör med containern
market-expansion/ops/**/*.mp4
market-expansion/ops/**/*.mov
market-expansion/ops/**/*.jpg
market-expansion/ops/**/*.jpeg
market-expansion/ops/**/*.png
market-expansion/ops/**/*.srt
market-expansion/ops/**/*.mp3
market-expansion/ops/**/*.wav
factory/output/*/leverans-*/
factory/output/*/bild-*/
factory/output/*/*/bild-*/
factory/output/*/spegla-*/
factory/output/*/*/spegla-*/
# Briefgranskningen: brief-dumparna ur Notion (kopior) — kön (ko.json), domarna
# (.dom.json), resultaten och rapporten committas; dumparna per hub inte
tools/output/briefgranskning/*/*/
# (den gamla OPS-varianten, till 2026-09-18)
factory/output/*/briefgranskning-*/
factory/output/*/*/briefgranskning-*/
factory/output/*/spegla-*-torr.*
factory/output/*/*/spegla-*-torr.*
factory/output/*/*.logg
# Lagerrensnings-sidorna: kie-bildernas lokala kopior dör med containern — bilderna ligger på Shopifys CDN
listicle/output/*/*/bilder/
listicle/output/*/*/forhandsvisning/
listicle/output/*/*/forhandsvisning-*/
kundtjanst/jobb/
# Akutlarmet: kön till Slack-connectorn och senaste körningen — minnet (akut/data/larm.json) committas, utdatan inte
akut/output/
# Fixturkörningens utdata (`--fixtur kundtjanst/test/fixturer/demo`). Den skriver
# brandet "demobutiken" som en riktig körning — men den är demodata och ska
# aldrig blandas ihop med brevlådornas verkliga historik.
kundtjanst/korningar/demobutiken/
kundtjanst/historik/demobutiken.jsonl

# Åtgärdade videor i OPS-flödet (factory/media-upload.mjs bildfix) — ligger i Meta, klipptiderna står i brand-syn.json
factory/output/*/bildfix/*.mp4
factory/output/*/bildfix/kie/
factory/output/*/bildfix/*.mp4.qa-*.png
# ElevenLabs-omdubb (pipeline/omdubb/elevenlabs-omdubb.mjs): renderingar, röstcache och QA-bilder
# ligger i Meta; de nya SRT:erna och tidslinjerna (små) committas som facit
factory/output/*/bildfix-el/*.mp4
factory/output/*/bildfix-el/*.png
factory/output/*/bildfix-el/vo/

# /oversatt: batchernas media committas aldrig (källor, renderingar, lager)
market-expansion/*/notion-batches/*/se/
market-expansion/*/notion-batches/*/no/
market-expansion/*/notion-batches/*/no-video/
market-expansion/*/notion-batches/*/out/
market-expansion/*/notion-batches/*/lager/
market-expansion/*/notion-batches/*/*/up/
# Källvideorna ligger direkt under batchen när kön inte delar upp per slug
# (kommandofilen skriver <batch>/<slug>/up/, kön 2026-10-03 skrev <batch>/up/).
# Raden ovan matchar bara slug-varianten, så 11 mp4 låg otrackade i vägen.
market-expansion/*/notion-batches/*/up/
market-expansion/*/notion-batches/*/*.err

# NO-videobatchernas tunga binärer (källvideor, renderingar, zip-leveranser) —
# stannar i containern och i Drive, aldrig i git. QA-bilder och SRT:er committas.
market-expansion/no/video-batches/*/rendered/
market-expansion/no/video-batches/*/out/
market-expansion/no/video-batches/*/zip/
market-expansion/no/video-batches/*/*/up/
market-expansion/no/video-batches/*/final/*/*.mp4
market-expansion/no/video-batches/*/frame-check/
market-expansion/no/video-batches/*/img-src/
market-expansion/*/notion-batches/*/frames/
# QA- och mätbilder i en /oversatt-batch: kontaktark, rutnätsbilder och
# skärmdumpar som sessionen tittar på under granskningen. De är arbetsmaterial,
# inte minne — kommandot säger uttryckligen "committa aldrig bilder/videor",
# och 2026-09-22 blev de 46 PNG:er på 78 MB i en enda körning.
market-expansion/*/notion-batches/*/qa/
market-expansion/*/notion-batches/*/qa2/
market-expansion/*/notion-batches/*/matt/
market-expansion/*/notion-batches/*/skann/
# Lösa mätbilder i batchroten. QA-mapparna ovan räcker inte: när en enskild
# video felsöks hamnar strippen där sessionen råkar skriva den (co5_ny.png,
# g11.png, rod.png … 2026-09-23). Samma sak, samma skäl — arbetsmaterial.
market-expansion/*/notion-batches/*/*.png
market-expansion/*/notion-batches/*/*.jpg
# …och i vilken undermapp sessionen än hittar på att skapa. Att räkna upp
# mappnamn har misslyckats tre gånger (qa/, qa2/, matt/, skann/, sedan roten,
# sedan ark/ samma dag). En bild i en batch är alltid arbetsmaterial.
market-expansion/*/notion-batches/*/**/*.png
market-expansion/*/notion-batches/*/**/*.jpg
# Röstkollens indata: KOPIOR av källvideorna och SRT:erna, omdöpta så namnen
# matchar utdatan. Källan finns redan i */up/ och srt-no/ — det här är dubbletter
# som väger MB, och rostkoll.py bygger om dem på en sekund.
market-expansion/*/notion-batches/*/rk-kalla/
market-expansion/*/notion-batches/*/rk-srt/
# HeyGens eget körläge per manifest — pekar på jobb-id som dör med batchen.
market-expansion/*/notion-batches/*/*.state.json

# Spårningssidan: byggd sidkropp och förhandsvisning — artefakter, inte källkod
sparning/output/

# Spårningens utdata per butik (sidkroppen + alla skanningar, ~1 MB per körning)
sparning/butiker/*/output/
# Kassabilden byggs om ur butikens live-betyg (factory/kassabild.mjs) — bara
# MÄTNINGEN (kassabild.json) är minne värt att committa. PNG:en och spec:en
# är genererade och skulle bara lägga binärer i historiken.
factory/output/*/kassabild.png
factory/output/*/kassabild.png.spec.json

# Stonebite-sidan: hemligheter och inloggningar committas ALDRIG.
# snapshot.json committas med flit — det är datan sidan visar, och rutinen
# som hämtar den pushar den till main (som alla andra rutiner i huset).
stonebite/data/hemlighet.txt
stonebite/data/anvandare.json

# Bonusen: inrapporterade insatser och personer som lagts till på sajten bor i
# dataspegeln (STONEBITE_DATA), inte i git. Utfallen (bonus/utfall/) committas
# — de är kvittot på vad som betalats ut.
stonebite/data/insatser.jsonl
stonebite/data/personer-extra.json

factory/output/*/logga-*
stonebite/data/kalender.jsonl
stonebite/data/kontakter.jsonl
# Autosvarets logg när minutservern körs lokalt utan STONEBITE_DATA (i drift: volymen). Repots logg är kundtjanst/autosvar/logg/.
stonebite/data/autosvar/
stonebite/data/fakturor.jsonl
stonebite/data/fakturor/

# Klaviyo-motorn: byggda mejl, galleri, produkt- och recensionscache (klaviyo/bygg.mjs)
klaviyo/output/

# Matstrumpors översättningar är minnet — de committas (Axels marknadsbygge 2026-09-27)
!matstrumpor/marknader/output/
!matstrumpor/marknader/output/underlag-*.json

# Konkurrentdödaren: rådata, kandidater, bildcache, skärmdumpar och den byggda granskningssidan — dör med containern. Ärendena (arenden.jsonl, arenden/) och lage.json committas.
konkurrenter/output/
# Meta-anmälningarnas bevisbilder (~1 MB PNG styck), formulärets skärmdumpar (<nr>-torr/-formular/-kvitto.png), engångskodens filer och verifieringssidan (data-URI:er) — bevisets länk på CDN, fälten och kvittot (referens) står i <nr>.json och arenden.jsonl som committas.
konkurrenter/arenden/*/anmalan/*.png
konkurrenter/arenden/*/anmalan/*.jpg
konkurrenter/arenden/*/anmalan/kod.txt*
konkurrenter/arenden/*/anmalan/verifiering.html
# Shopify-anmälans bevisbild (~5 MB PNG) — länken på CDN och fälten står i shopify/anmalan.json som committas.
konkurrenter/arenden/*/shopify/*.png
konkurrenter/arenden/*/shopify/*.jpg
# Mejlanmälans bilaga som base64 till Gmail-anropet — görs alltid om ur PDF:en bredvid (som committas).
konkurrenter/arenden/*/epost/*.b64

# Matstrumpors lokaliserade videor (HeyGen + undertexter) — stora filer, laddas upp till Meta, aldrig i git
matstrumpor/marknader/annonser/klar/*.mp4
matstrumpor/marknader/annonser/klar/*.png
matstrumpor/marknader/annonser/klar/*.rutor.json
# Matstrumpors egna videor: källorna och renderingarna ligger inte i repot
matstrumpor/marknader/egna/kalla/
matstrumpor/marknader/egna/ut/

# D3-bildannonsens renderingar (ritas om av egna/d3/annons.mjs --skriv; hash:en ligger i videor.json)
matstrumpor/marknader/annonser/klar/*_d3.jpg
mejl/output/butiker/*/lankkoll/
# mejl/notis-lankar.mjs: före/efter-kopior av Shopifys notisöversättningar (~50 MB per körning,
# Shopifys egen text). Läget per körning (lage.json) ligger i mejl/output/butiker/<id>/notis-lankar/ och committas.
mejl/output/notis-lankar/

# Köparenkätens svar: aldrig i repot (GDPR-raden lovar högst 12 månader)
enkat/output/
# Värva en vän: skärmdumpar från kundvyn (matstrumpor/varva/kundvy.mjs)
matstrumpor/varva/output/

# Skool-läsaren: inloggad session + hämtade lektioner (tools/skool/)
tools/skool/.state/

# Matstrumpors arkiv som JSON (~170 kB) byggs om av `kor.mjs --arkiv` varje rond ur logg.jsonl +
# arkiv/matningar.jsonl + briefernas taggar — härledd data, committas inte (samma lärdom som
# sparning/lage.json). arkiv.md och matningar.jsonl committas.
products/matstrumpor/arkiv.json

# /oversatt: färdiga videor och uppladdningsmappen committas ALDRIG. 2026-10-01
# gick 11 mp4-filer (116 MB) in i historiken via no-video-txt/ — paketet var
# 4,8 GiB 2026-10-02. Pillerloggen (*.piller.json) är liten och sparas.
market-expansion/*/notion-batches/*/no-video-txt/*.mp4
market-expansion/*/notion-batches/*/no-video-txt/*.png
market-expansion/*/notion-batches/*/no-video-txt/*.jpg
market-expansion/*/notion-batches/*/upp/
market-expansion/*/notion-batches/*/heygen/
matstrumpor/ursakt/output/
