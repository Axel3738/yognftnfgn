{% comment %}
  Fraktbekreftelse ("Ordren din er pakket") — brandet for Beverbutikken.no.
  Limes inn i: Innstillinger → Varsler → Kundevarsler → Fraktbekreftelse → Rediger kode.
  Bygger på Shopifys standardvariabler: fulfillment, order_status_url, shop.
  OBS: leverandøren markerer ordrer som sendt innen ~24 t, ofte før pakken
  fysisk har beveget seg. Derfor sier e-posten "pakket og overlevert til
  fraktselskapet" — ALDRI "på vei" — og forklarer at sporingen kan vise tomt
  til transportøren har skannet pakken.
  Brandfarger fra theme.css (Impulse): knapp #dd1d1d, kant #e8e8e1, header/footer #000000.
  Norsk versjon av mallar/frakt-bekraftelse.liquid.
{% endcomment %}
<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ordren din er pakket</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
</head>
<body style="margin:0; padding:0; background-color:#f2f2f2; -webkit-text-size-adjust:100%;">

  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
    Ordren din er pakket og overlevert til fraktselskapet — her er sporingslinken din.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f2f2;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border:1px solid #e8e8e1;">

          <!-- Sidehode: svart list med ordmerke, som sidens header -->
          <tr>
            <td align="center" style="background-color:#000000; padding:20px 24px;">
              <a href="{{ shop.url }}" style="text-decoration:none;">
                <span style="font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:26px; letter-spacing:1px; color:#ffffff; text-transform:uppercase;">{{ shop.name }}</span>
              </a>
            </td>
          </tr>

          <!-- Overskrift -->
          <tr>
            <td style="padding:36px 32px 8px 32px;" align="center">
              <span style="font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:30px; line-height:1.15; color:#000000; text-transform:uppercase;">Ordren din er pakket!</span>
            </td>
          </tr>

          <!-- Ingress -->
          <tr>
            <td style="padding:8px 32px 4px 32px;" align="center">
              <p style="font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:1.6; color:#000000; margin:0;">
                {% if customer.first_name %}Hei {{ customer.first_name }}!{% else %}Hei!{% endif %}
                Ordre <strong>{{ name }}</strong> er pakket og overlevert til fraktselskapet — nå tar transportøren over resten av reisen hjem til deg.
              </p>
            </td>
          </tr>

          <!-- Sporingsknapp — hovedhandlingen i e-posten -->
          <tr>
            <td align="center" style="padding:24px 32px 8px 32px;">
              {% if fulfillment.tracking_url %}
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" bgcolor="#dd1d1d" style="background-color:#dd1d1d;">
                      <a href="{{ fulfillment.tracking_url }}" target="_blank"
                         style="display:inline-block; padding:16px 44px; font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:18px; letter-spacing:1px; color:#ffffff; text-decoration:none; text-transform:uppercase;">
                        Spor pakken din
                      </a>
                    </td>
                  </tr>
                </table>
              {% else %}
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" bgcolor="#dd1d1d" style="background-color:#dd1d1d;">
                      <a href="{{ order_status_url }}" target="_blank"
                         style="display:inline-block; padding:16px 44px; font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:18px; letter-spacing:1px; color:#ffffff; text-decoration:none; text-transform:uppercase;">
                        Følg ordren din
                      </a>
                    </td>
                  </tr>
                </table>
              {% endif %}
            </td>
          </tr>

          <!-- Sporingsnummer i klartekst, klikkbare -->
          <tr>
            <td align="center" style="padding:8px 32px 24px 32px;">
              {% if fulfillment.tracking_numbers.size == 1 %}
                <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#6b6b6b; margin:0;">
                  Sporingsnummer:
                  {% if fulfillment.tracking_url %}
                    <a href="{{ fulfillment.tracking_url }}" style="color:#dd1d1d; font-weight:bold;">{{ fulfillment.tracking_numbers.first }}</a>
                  {% else %}
                    <strong style="color:#000000;">{{ fulfillment.tracking_numbers.first }}</strong>
                  {% endif %}
                  {% if fulfillment.tracking_company %}({{ fulfillment.tracking_company }}){% endif %}
                </p>
              {% elsif fulfillment.tracking_numbers.size > 1 %}
                <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#6b6b6b; margin:0 0 6px 0;">
                  Leveransen din har flere kolli{% if fulfillment.tracking_company %} ({{ fulfillment.tracking_company }}){% endif %}:
                </p>
                {% for tracking_number in fulfillment.tracking_numbers %}
                  <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 4px 0;">
                    {% assign t_url = fulfillment.tracking_urls[forloop.index0] %}
                    {% if t_url %}
                      <a href="{{ t_url }}" style="color:#dd1d1d; font-weight:bold;">{{ tracking_number }}</a>
                    {% else %}
                      <strong style="color:#000000;">{{ tracking_number }}</strong>
                    {% endif %}
                  </p>
                {% endfor %}
              {% else %}
                <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#6b6b6b; margin:0;">
                  Sporingsnummer legges til så snart transportøren har registrert pakken.
                </p>
              {% endif %}
              <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:1.6; color:#6b6b6b; margin:10px 0 0 0;">
                Sporingen kan vise tomt de første dagene — den våkner så snart transportøren skanner pakken.
              </p>
            </td>
          </tr>

          <!-- Skillelinje -->
          <tr>
            <td style="padding:0 32px;"><div style="border-top:1px solid #e8e8e1; font-size:0; line-height:0;">&nbsp;</div></td>
          </tr>

          <!-- Innhold i leveransen -->
          <tr>
            <td style="padding:24px 32px 8px 32px;">
              <span style="font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:16px; color:#000000; text-transform:uppercase; letter-spacing:0.5px;">I denne leveransen</span>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                {% for line in fulfillment.fulfillment_line_items %}
                <tr>
                  <td width="72" style="padding:10px 0; vertical-align:middle;">
                    {% if line.line_item.image %}
                      <img src="{{ line.line_item.image | img_url: 'compact_cropped' }}" alt="{{ line.line_item.title | escape }}" width="60" height="60" style="display:block; border:1px solid #e8e8e1;">
                    {% endif %}
                  </td>
                  <td style="padding:10px 0 10px 12px; vertical-align:middle;">
                    <p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; color:#000000; margin:0; font-weight:bold;">{{ line.line_item.title }}</p>
                    {% if line.line_item.variant_title and line.line_item.variant_title != 'Default Title' %}
                      <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#6b6b6b; margin:2px 0 0 0;">{{ line.line_item.variant_title }}</p>
                    {% endif %}
                  </td>
                  <td align="right" style="padding:10px 0; vertical-align:middle;">
                    <p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; color:#000000; margin:0;">× {{ line.quantity }}</p>
                  </td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>

          <!-- Sekundær link til ordrestatus -->
          <tr>
            <td align="center" style="padding:0 32px 32px 32px;">
              <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#6b6b6b; margin:0;">
                Du kan alltid se leveringsstatus og hele ordren din på
                <a href="{{ order_status_url }}" style="color:#dd1d1d; font-weight:bold;">ordresiden din</a>.
              </p>
            </td>
          </tr>

          <!-- Nyhetsbrev-blokk -->
          <tr>
            <td style="padding:0 32px 32px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#000000;">
                <tr>
                  <td align="center" style="padding:24px 20px;">
                    <p style="font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:20px; color:#ffffff; margin:0; text-transform:uppercase; letter-spacing:0.5px;">10 % rabatt på neste kjøp</p>
                    <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:1.6; color:#d9d9d9; margin:8px 0 16px 0;">Meld deg på nyhetsbrevet og få en rabattkode rett i innboksen. Ingen venting.</p>
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" bgcolor="#dd1d1d" style="background-color:#dd1d1d;">
                          <a href="{{ shop.url }}/#newsletter-footer" target="_blank"
                             style="display:inline-block; padding:12px 32px; font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:15px; letter-spacing:1px; color:#ffffff; text-decoration:none; text-transform:uppercase;">
                            Hent rabattkoden
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Sidefot: svart, som sidens footer -->
          <tr>
            <td align="center" style="background-color:#000000; padding:24px 32px;">
              <p style="font-family:'Anton','Arial Narrow',Arial,sans-serif; font-size:15px; color:#ffffff; margin:0 0 8px 0; text-transform:uppercase; letter-spacing:1px;">{{ shop.name }}</p>
              <p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#d9d9d9; margin:0;">
                Spørsmål om leveransen din? Svar på denne e-posten eller skriv til
                <a href="mailto:{{ shop.email }}" style="color:#ffffff;">{{ shop.email }}</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
