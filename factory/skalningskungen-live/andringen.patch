+  }
+});
+
+test('startskottsbehov: en kampanj som ronden stängt av tidigare larmas inte', () => {
+  const logg = [{ kampanj_id: 'K1', kod: 'STANG_AV', genomford: true, datum: '2026-09-01' }];
