{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "ms_trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ms-trust-row', items: 'truck:Fri frakt i Sverige|refresh:30 dagars öppet köp|lock:Trygg betalning' %}"
          }
        },
        "ms_delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ms-delivery-estimate', min_days: 5, max_days: 10, cutoff_hour: 0, text: 'Beräknad leverans' %}"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "ms_paket": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ms-paket', product: product, section_id: section.id %}"
          }
        },
        "judgeme_stjarnor": {
          "type": "shopify://apps/judge-me-reviews/blocks/preview_badge/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8",
          "settings": {}
        }
      },
      "block_order": [
        "vendor",
        "title",
        "judgeme_stjarnor",
        "price",
        "variant_picker",
        "ms_paket",
        "buy_buttons",
        "ms_trust",
        "ms_delivery",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "ms_faq_section": {
      "type": "ms-faq-section",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "Passar de alla?",
            "a": "<p>En storlek passar de flesta, ungefär strl 36–44.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Hur fungerar Köp 1 – Få 1?",
            "a": "<p>Välj paketet i köprutan och tryck på Lägg i varukorgen. Gratisdelarna följer med automatiskt, och i varukorgen ser du dem som egna rader på 0 kr.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Kan jag skicka dem som present direkt?",
            "a": "<p>Ja. Alla par levereras i en presentförpackning som ser ut som riktig mat — redo att ges bort utan inslagning.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Hur snabbt kommer de?",
            "a": "<p>5–10 arbetsdagar med fri frakt inom Sverige.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Vilka betalsätt kan jag använda?",
            "a": "<p>Klarna, kort (Visa, Mastercard, American Express m.fl.), Apple Pay, Google Pay, PayPal och Shop Pay.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "Vad gäller om jag ångrar mig?",
            "a": "<p>30 dagars öppet köp. Mejla <a href=\"mailto:kundsupport@matstrumpor.se\">kundsupport@matstrumpor.se</a> så hjälper vi dig — inget krångel.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ],
      "settings": {
        "heading": "Vanliga frågor"
      }
    },
    "ms_sticky": {
      "type": "ms-sticky-atc",
      "settings": {
        "label": "Köp nu",
        "position": "bottom",
        "show_image": true
      }
    },
    "judgeme_widget": {
      "type": "apps",
      "blocks": {
        "w": {
          "type": "shopify://apps/judge-me-reviews/blocks/review_widget/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8",
          "settings": {}
        }
      },
      "block_order": [
        "w"
      ],
      "settings": {
        "include_margins": true
      }
    }
  },
  "order": [
    "main",
    "judgeme_widget",
    "ms_faq_section",
    "ms_sticky"
  ]
}
