# OPS Factory — miljövariabler för Shopify-kopplingen.
# Kopiera till factory/.env och fyll i. .env är gitignorerad — committa den aldrig.

# Butikens myshopify-domän, ex: min-butik.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token från en custom app i butiken
# (Inställningar → Appar och försäljningskanaler → Utveckla appar,
# appnamn "Fabriken" enligt VA-CHECKLIST.md steg 3).
# Bocka i ALLA scopes — hela bygget behöver bl.a. products, themes,
# content, legal_policies, publications, translations, locales, markets,
# discounts, price_rules, files, metaobjects, online_store_navigation,
# shipping. En delmängd ger kryptiska stopp mitt i kedjan.
SHOPIFY_ADMIN_TOKEN=

# Valfritt — API-version, lämna tom för standard (2025-07)
SHOPIFY_API_VERSION=
