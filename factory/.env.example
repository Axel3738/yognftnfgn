# OPS Factory — Shopify-kopplingen.
#
# FÖRSTA VALET (Axels mall 2026-09-08): lägg nycklarna i MOLNMILJÖN
# (claude.ai → Environment → variabler), en triplett per butik.
# <ID> = butik.id ur factory/butiker/<id>.yaml, i VERSALER:
#
#   SHOPIFY_SHOP_<ID>            = y1sj1i-3d.myshopify.com
#   SHOPIFY_CLIENT_ID_<ID>       = appen "Fabriken" → Settings → Client ID
#   SHOPIFY_CLIENT_SECRET_<ID>   = appen "Fabriken" → Settings → Client secret
#
#   Exempel för TankGuard:
#   SHOPIFY_SHOP_TANKGUARD, SHOPIFY_CLIENT_ID_TANKGUARD, SHOPIFY_CLIENT_SECRET_TANKGUARD
#
# Fabriken byter Client ID + secret mot en färsk Admin-token vid varje körning
# (client credentials grant). Då behövs ingen fil alls — factory/.env kan vara tom.
#
# ⚠️ En token som börjar på atkn_ är Shopify CLI:s token och ger ALLTID 401
# mot Admin API. Använd aldrig den. Client ID + Client secret är det som gäller.
#
# ANDRA VALET: den här filen. Kopiera till factory/.env och fyll i.
# .env är gitignorerad — committa den aldrig.

# Butikens myshopify-domän, ex: min-butik.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Appen "Fabriken" (ALLA Admin API-scopes ibockade — hela bygget behöver bl.a.
# products, themes, content, legal_policies, publications, translations,
# locales, markets, discounts, price_rules, files, metaobjects,
# online_store_navigation, shipping. En delmängd ger kryptiska stopp mitt i kedjan.)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Alternativ till Client ID/secret: en färdig Admin API access token (shpat_…)
SHOPIFY_ADMIN_TOKEN=

# Valfritt — API-version, lämna tom för standard (2025-07)
SHOPIFY_API_VERSION=
