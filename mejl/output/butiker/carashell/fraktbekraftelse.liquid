            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 0; line-height: 1.6;">{% if fulfillment.tracking_number %}Your parcel number: <strong style="color: #22282E; letter-spacing: 0.04em;">{{ fulfillment.tracking_number | upcase | replace: ' ', '' | replace: '-', '' | sha256 | slice: 0, 8 | upcase | prepend: 'CS-' }}</strong><br>Click the button above and your parcel shows up right away.{% endif %}</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 16px 32px 4px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f7f2" style="border: 1px solid #D6D9D3;">
                <tr>
                  <td align="center" style="padding: 16px 20px 6px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 12px; font-weight: bold; color: #1F6F8E; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 6px;">Estimated delivery</p>
