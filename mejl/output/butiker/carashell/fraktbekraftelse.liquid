<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your parcel is on its way!</title>
  <style>
    @media only screen and (max-width: 480px) {
