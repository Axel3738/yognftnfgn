{% assign fornamn = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name %}
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Spårningen är uppdaterad</title>
  <style>
    @media only screen and (max-width: 480px) {
      .bb-yttre { padding: 8px 0 !important; }
      .bb-kort { display: inline-block !important; width: 48% !important; box-sizing: border-box !important; }
      .bb-vinst { display: inline-block !important; width: 32% !important; box-sizing: border-box !important; }
      .bb-knapp { display: block !important; width: auto !important; }
      .bb-rubrik { font-size: 26px !important; }
    }</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f2f2f2;">
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">Så här ligger det till just nu.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2f2f2">
    <tr>
      <td align="center" class="bb-yttre" style="padding: 24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width: 600px; width: 100%; border: 1px solid #e4dbc9;">
          <tr>
            <td align="center" bgcolor="#ffffff" style="padding: 20px 24px 16px; border-bottom: 1px solid #e4dbc9;">
              <a href="https://matstrumpor.se" style="text-decoration: none;"><img src="https://matstrumpor.se/cdn/shop/files/Namnlos_design_-_2026-03-19T120925.579.png?v=1773918572&width=280" alt="Matstrumpor" width="140" height="79" style="display: block; margin: 0 auto; max-width: 100%; height: auto; border: 0;"></a>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 36px 32px 8px;">
              <span style="font-family: 'Trebuchet MS',Verdana,Arial,sans-serif; font-weight: bold; font-size: 30px; line-height: 1.15; color: #121212;">Spårningen är uppdaterad</span>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 15px; line-height: 1.6; color: #121212; margin: 0;">
                {% if fornamn != blank %}Hej {{ fornamn }}!{% else %}Hej!{% endif %}
                Spårningsuppgifterna för din order {{ name }} har uppdaterats.
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 24px 32px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="bb-knapp">
                <tr>
                  <td align="center" bgcolor="#dd821d">
                    <a href="{% if fulfillment.tracking_number %}https://matstrumpor.se/pages/spara?nummer={{ fulfillment.tracking_number | upcase | replace: ' ', '' | replace: '-', '' | sha256 | slice: 0, 8 | upcase | prepend: 'MS-' }}{% else %}{{ order_status_url }}{% endif %}" target="_blank" style="display: inline-block; font-family: 'Trebuchet MS',Verdana,Arial,sans-serif; font-weight: bold; font-size: 18px; letter-spacing: 1px; color: #ffffff; text-decoration: none; padding: 16px 44px;">Spåra paketet</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 0; line-height: 1.6;">{% if fulfillment.tracking_number %}Ditt paketnummer: <strong style="color: #121212; letter-spacing: 0.04em;">{{ fulfillment.tracking_number | upcase | replace: ' ', '' | replace: '-', '' | sha256 | slice: 0, 8 | upcase | prepend: 'MS-' }}</strong><br>Klicka på knappen ovan så visas ditt paket direkt.{% endif %}</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px;"><div style="border-top: 1px solid #e4dbc9; font-size: 0; line-height: 0;">&nbsp;</div></td>
          </tr>
          <tr>
            <td style="padding: 24px 32px 8px;">
              <span style="font-family: 'Trebuchet MS',Verdana,Arial,sans-serif; font-weight: bold; font-size: 16px; color: #121212; letter-spacing: 0.5px;">I paketet</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in fulfillment.fulfillment_line_items %}
                <tr>
                  <td width="72" valign="middle" style="padding: 10px 0;">
                    {% if line.line_item.image %}<img src="{{ line.line_item | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display: block; border: 1px solid #e4dbc9;">{% endif %}
                  </td>
                  <td valign="middle" style="padding: 10px 0 10px 12px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; color: #121212; font-weight: bold; margin: 0;">{{ line.line_item.title }}</p>
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 2px 0 0;">Antal: {{ line.quantity }}</p>
                  </td>
                  
                </tr>{% endfor %}
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" bgcolor="#ffffff" style="border-top: 1px solid #e4dbc9; padding: 24px 32px;">
              <p style="font-family: 'Trebuchet MS',Verdana,Arial,sans-serif; font-weight: bold; font-size: 15px; color: #121212; letter-spacing: 1px; margin: 0 0 8px;">Matstrumpor</p>
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 12px; line-height: 1.6; color: #6b6b6b; margin: 0;">Frågor om din order? Svara på det här mejlet eller skriv till <a href="mailto:kundsupport@matstrumpor.se" style="color: #121212;">kundsupport@matstrumpor.se</a>.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
