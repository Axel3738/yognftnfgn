{% assign fornamn = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name %}
{% assign lev_bas = 'now' | date: '%s' | plus: 0 %}{% assign lev_fran_ts = lev_bas | plus: 604800 %}{% assign lev_fran_dag = lev_fran_ts | date: '%-d' %}{% assign lev_fran_mm = lev_fran_ts | date: '%m' %}{% case lev_fran_mm %}{% when '01' %}{% assign lev_fran_man = 'tammikuuta' %}{% when '02' %}{% assign lev_fran_man = 'helmikuuta' %}{% when '03' %}{% assign lev_fran_man = 'maaliskuuta' %}{% when '04' %}{% assign lev_fran_man = 'huhtikuuta' %}{% when '05' %}{% assign lev_fran_man = 'toukokuuta' %}{% when '06' %}{% assign lev_fran_man = 'kesäkuuta' %}{% when '07' %}{% assign lev_fran_man = 'heinäkuuta' %}{% when '08' %}{% assign lev_fran_man = 'elokuuta' %}{% when '09' %}{% assign lev_fran_man = 'syyskuuta' %}{% when '10' %}{% assign lev_fran_man = 'lokakuuta' %}{% when '11' %}{% assign lev_fran_man = 'marraskuuta' %}{% when '12' %}{% assign lev_fran_man = 'joulukuuta' %}{% else %}{% assign lev_fran_man = '' %}{% endcase %}{% assign lev_fran_datum = lev_fran_dag | append: '. ' | append: lev_fran_man %}{% assign lev_till_ts = lev_bas | plus: 1209600 %}{% assign lev_till_dag = lev_till_ts | date: '%-d' %}{% assign lev_till_mm = lev_till_ts | date: '%m' %}{% case lev_till_mm %}{% when '01' %}{% assign lev_till_man = 'tammikuuta' %}{% when '02' %}{% assign lev_till_man = 'helmikuuta' %}{% when '03' %}{% assign lev_till_man = 'maaliskuuta' %}{% when '04' %}{% assign lev_till_man = 'huhtikuuta' %}{% when '05' %}{% assign lev_till_man = 'toukokuuta' %}{% when '06' %}{% assign lev_till_man = 'kesäkuuta' %}{% when '07' %}{% assign lev_till_man = 'heinäkuuta' %}{% when '08' %}{% assign lev_till_man = 'elokuuta' %}{% when '09' %}{% assign lev_till_man = 'syyskuuta' %}{% when '10' %}{% assign lev_till_man = 'lokakuuta' %}{% when '11' %}{% assign lev_till_man = 'marraskuuta' %}{% when '12' %}{% assign lev_till_man = 'joulukuuta' %}{% else %}{% assign lev_till_man = '' %}{% endcase %}{% assign lev_till_datum = lev_till_dag | append: '. ' | append: lev_till_man %}
<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Paketti on matkalla!</title>
  <style>
    @media only screen and (max-width: 480px) {
      .bb-yttre { padding: 8px 0 !important; }
      .bb-kort { display: inline-block !important; width: 48% !important; box-sizing: border-box !important; }
      .bb-vinst { display: inline-block !important; width: 32% !important; box-sizing: border-box !important; }
      .bb-knapp { display: block !important; width: auto !important; }
      .bb-rubrik { font-size: 26px !important; }
    }</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f2f2f2;">
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">Seurantalinkki on tässä.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2f2f2">
    <tr>
      <td align="center" class="bb-yttre" style="padding: 24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width: 600px; width: 100%; border: 1px solid #e8e8e1;">
          <tr>
            <td align="center" bgcolor="#ffffff" style="padding: 20px 24px 16px; border-bottom: 1px solid #e8e8e1;">
              <a href="https://majavakauppa.fi" style="text-decoration: none;"><img src="https://majavakauppa.fi/cdn/shop/files/majavakauppa-logo.png?v=1786556659&width=480" alt="Majavakauppa" width="240" height="29" style="display: block; margin: 0 auto; max-width: 100%; height: auto; border: 0;"></a>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 36px 32px 8px;">
              <span style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 30px; line-height: 1.15; color: #000000;">Paketti on matkalla!</span>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 15px; line-height: 1.6; color: #000000; margin: 0;">
                {% if fornamn != blank %}Hei {{ fornamn }}!{% else %}Hei!{% endif %}
                Tilauksesi {{ name }} on lähtenyt varastolta ja on matkalla sinulle.
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 24px 32px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="bb-knapp">
                <tr>
                  <td align="center" bgcolor="#dd1d1d">
                    <a href="{% if fulfillment.tracking_number %}https://majavakauppa.fi/pages/seuranta?nummer={{ fulfillment.tracking_number | upcase | replace: ' ', '' | replace: '-', '' | sha256 | slice: 0, 8 | upcase | prepend: 'BB-' }}{% else %}{{ order_status_url }}{% endif %}" target="_blank" style="display: inline-block; font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 18px; letter-spacing: 1px; color: #ffffff; text-decoration: none; padding: 16px 44px;">Seuraa pakettia</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 0; line-height: 1.6;">{% if fulfillment.tracking_number %}Pakettinumerosi: <strong style="color: #000000; letter-spacing: 0.04em;">{{ fulfillment.tracking_number | upcase | replace: ' ', '' | replace: '-', '' | sha256 | slice: 0, 8 | upcase | prepend: 'BB-' }}</strong><br>Klikkaa yllä olevaa painiketta, niin pakettisi näkyy heti.{% endif %}</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 16px 32px 4px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f7f2" style="border: 1px solid #e8e8e1;">
                <tr>
                  <td align="center" style="padding: 16px 20px 6px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 12px; font-weight: bold; color: #dd1d1d; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 6px;">Arvioitu toimitus</p>
                    <p style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 24px; line-height: 1.15; color: #000000; margin: 0;">{{ lev_fran_datum }}–{{ lev_till_datum }}</p>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding: 4px 20px 16px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; line-height: 1.6; color: #6b6b6b; margin: 0;">Seuranta ei usein näytä mitään ensimmäisten 2–4 päivän aikana – paketti on matkalla lentokentälle, ei kadonnut. Sinun ei tarvitse tehdä mitään, seuranta päivittyy heti kun paketti on kirjattu sisään.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding: 8px 32px 8px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; line-height: 1.6; color: #6b6b6b; margin: 0;">Seuranta voi pysyä paikallaan 2–4 päivää, kun paketti on matkalla lentokentälle – täysin normaalia. Tarkista uudelleen sen jälkeen.</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 24px 32px 8px;">
              <span style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 16px; color: #000000; letter-spacing: 0.5px;">Paketissa</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in fulfillment.fulfillment_line_items %}
                <tr>
                  <td width="72" valign="middle" style="padding: 10px 0;">
                    {% if line.line_item.image %}<img src="{{ line.line_item | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display: block; border: 1px solid #e8e8e1;">{% endif %}
                  </td>
                  <td valign="middle" style="padding: 10px 0 10px 12px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; color: #000000; font-weight: bold; margin: 0;">{{ line.line_item.title }}</p>
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 2px 0 0;">Määrä: {{ line.quantity }}</p>
                  </td>
                  
                </tr>{% endfor %}
              </table>
            </td>
          </tr>{% if shipping_address %}
          <tr>
            <td style="padding: 0 32px;"><div style="border-top: 1px solid #e8e8e1; font-size: 0; line-height: 0;">&nbsp;</div></td>
          </tr>
          <tr>
            <td style="padding: 20px 32px;">
              <span style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 16px; color: #000000; letter-spacing: 0.5px;">Toimitusosoite</span>
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; line-height: 1.6; color: #000000; margin: 8px 0 0;">{{ shipping_address.name }}<br>{{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}<br>{{ shipping_address.address2 }}{% endif %}<br>{{ shipping_address.zip }} {{ shipping_address.city }}</p>
            </td>
          </tr>{% endif %}
          <tr>
            <td align="center" bgcolor="#ffffff" style="border-top: 1px solid #e8e8e1; padding: 24px 32px;">
              <p style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 15px; color: #000000; letter-spacing: 1px; margin: 0 0 8px;">Majavakauppa</p>
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 12px; line-height: 1.6; color: #6b6b6b; margin: 0;">Kysyttävää tilauksestasi? Vastaa tähän viestiin tai kirjoita osoitteeseen <a href="mailto:asiakastuki@majavakauppa.fi" style="color: #000000;">asiakastuki@majavakauppa.fi</a>.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
