{% assign fornamn = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name %}
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dina varor väntar i kassan</title>
  <style>
    @media only screen and (max-width: 480px) {
      .bb-yttre { padding: 8px 0 !important; }
      .bb-kort { display: inline-block !important; width: 48% !important; box-sizing: border-box !important; }
      .bb-vinst { display: inline-block !important; width: 32% !important; box-sizing: border-box !important; }
      .bb-knapp { display: block !important; width: auto !important; }
      .bb-rubrik { font-size: 26px !important; }
    }</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f2f2f2;">
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">Varorna ligger kvar, redo när du är.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2f2f2">
    <tr>
      <td align="center" class="bb-yttre" style="padding: 24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width: 600px; width: 100%; border: 1px solid #e8e8e1;">
          <tr>
            <td align="center" bgcolor="#000000" style="padding: 16px 24px;">
              <a href="https://baverbutiken.se" style="text-decoration: none;"><img src="https://baverbutiken.se/cdn/shop/files/Namnlos_design_44_67839842-4d7e-4a47-bad7-edcdcd627348_600x200_crop_center.png?v=1776922108" alt="Bäverbutiken.se" width="240" height="80" style="display: block; margin: 0 auto; max-width: 100%; height: auto; border: 0;"></a>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 36px 32px 8px;">
              <span style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 30px; line-height: 1.15; color: #000000;">Dina varor väntar i kassan</span>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 15px; line-height: 1.6; color: #000000; margin: 0;">
                {% if fornamn != blank %}Hej {{ fornamn }}!{% else %}Hej!{% endif %}
                Vi har sparat varorna i din kundvagn — du behöver bara slutföra köpet.
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 24px 32px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="bb-knapp">
                <tr>
                  <td align="center" bgcolor="#dd1d1d">
                    <a href="{{ url }}" target="_blank" style="display: inline-block; font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 18px; letter-spacing: 1px; color: #ffffff; text-decoration: none; padding: 16px 44px;">Slutför köpet</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding: 8px 32px 8px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; line-height: 1.6; color: #6b6b6b; margin: 0;">14 dagars ångerrätt och spårbar frakt på alla köp.</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px;"><div style="border-top: 1px solid #e8e8e1; font-size: 0; line-height: 0;">&nbsp;</div></td>
          </tr>
          <tr>
            <td style="padding: 24px 32px 8px;">
              <span style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 16px; color: #000000; letter-spacing: 0.5px;">I din kundvagn</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in line_items %}
                <tr>
                  <td width="72" valign="middle" style="padding: 10px 0;">
                    {% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display: block; border: 1px solid #e8e8e1;">{% endif %}
                  </td>
                  <td valign="middle" style="padding: 10px 0 10px 12px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; color: #000000; font-weight: bold; margin: 0;">{{ line.title }}</p>
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 2px 0 0;">Antal: {{ line.quantity }}</p>
                  </td>
                  <td align="right" valign="middle" style="white-space: nowrap; padding: 10px 0;"><p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; color: #000000; margin: 0;">{{ line.final_line_price | money }}</p></td>
                </tr>{% endfor %}
              </table>
            </td>
          </tr>
          <tr><td style="padding: 0 0 24px;"></td></tr>
          <tr>
            <td align="center" bgcolor="#000000" style="border-top: 1px solid #2a2a2a; padding: 24px 32px;">
              <p style="font-family: Impact,'Anton','Arial Narrow','Arial Black',sans-serif; text-transform: uppercase; font-size: 15px; color: #ffffff; letter-spacing: 1px; margin: 0 0 8px;">Bäverbutiken.se</p>
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 12px; line-height: 1.6; color: #d9d9d9; margin: 0;">Frågor om din order? Svara på det här mejlet eller skriv till <a href="mailto:kundsupport@baverbutiken.se" style="color: #ffffff;">kundsupport@baverbutiken.se</a>.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
