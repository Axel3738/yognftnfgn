{% assign fornamn = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name %}
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Din order är avbruten</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f2f2f2;">
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">Inga pengar dras.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2f2f2">
    <tr>
      <td align="center" style="padding: 24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width: 600px; width: 100%; border: 1px solid #e8e8e1;">
          <tr>
            <td align="center" bgcolor="#000000" style="padding: 20px 24px;">
              <a href="https://baverbutiken.se" style="text-decoration: none;">
                <span style="font-family: 'Anton','Arial Narrow',Arial,sans-serif; text-transform: uppercase; font-size: 26px; letter-spacing: 1px; color: #ffffff;">Bäverbutiken.se</span>
              </a>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 36px 32px 8px;">
              <span style="font-family: 'Anton','Arial Narrow',Arial,sans-serif; text-transform: uppercase; font-size: 30px; line-height: 1.15; color: #000000;">Din order är avbruten</span>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 8px 32px 4px;">
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 15px; line-height: 1.6; color: #000000; margin: 0;">
                {% if fornamn != blank %}Hej {{ fornamn }}!{% else %}Hej!{% endif %}
                Order {{ name }} är avbruten. Pengar dras inte — är de redan dragna återbetalas de automatiskt.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px;"><div style="border-top: 1px solid #e8e8e1; font-size: 0; line-height: 0;">&nbsp;</div></td>
          </tr>
          <tr>
            <td style="padding: 24px 32px 8px;">
              <span style="font-family: 'Anton','Arial Narrow',Arial,sans-serif; text-transform: uppercase; font-size: 16px; color: #000000; letter-spacing: 0.5px;">Din order</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 32px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in line_items %}
                <tr>
                  <td width="72" valign="middle" style="padding: 10px 0;">
                    {% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display: block; border: 1px solid #e8e8e1;">{% endif %}
                  </td>
                  <td valign="middle" style="padding: 10px 0 10px 12px;">
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; color: #000000; font-weight: bold; margin: 0;">{{ line.title }}</p>
                    <p style="font-family: Arial,Helvetica,sans-serif; font-size: 13px; color: #6b6b6b; margin: 2px 0 0;">Antal: {{ line.quantity }}</p>
                  </td>
                  <td align="right" valign="middle" style="white-space: nowrap; padding: 10px 0;"><p style="font-family: Arial,Helvetica,sans-serif; font-size: 14px; color: #000000; margin: 0;">{{ line.final_line_price | money }}</p></td>
                </tr>{% endfor %}
              </table>
            </td>
          </tr>
          <tr><td style="padding: 0 0 24px;"></td></tr>
          <tr>
            <td align="center" bgcolor="#000000" style="border-top: 1px solid #2a2a2a; padding: 24px 32px;">
              <p style="font-family: 'Anton','Arial Narrow',Arial,sans-serif; text-transform: uppercase; font-size: 15px; color: #ffffff; letter-spacing: 1px; margin: 0 0 8px;">Bäverbutiken.se</p>
              <p style="font-family: Arial,Helvetica,sans-serif; font-size: 12px; line-height: 1.6; color: #d9d9d9; margin: 0;">Frågor om din order? Svara på det här mejlet eller skriv till <a href="mailto:kundsupport@baverbutiken.se" style="color: #ffffff;">kundsupport@baverbutiken.se</a>.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
