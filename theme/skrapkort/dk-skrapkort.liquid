{%- comment -%}
  Skrapkort — välkomstrabatt-popup. Rekonstruerad 2026-08-24 ur den live,
  buggfixade versionen på baverbutiken.se (besöksspärr + rubrikskydd ingår).
  Installeras: lägg filen i sections/ och raden {% section 'skrapkort' %}
  i layout/theme.liquid, direkt före </body>. Texter och kod ändras under
  Anpassa → temainställningar för sektionen.
{%- endcomment -%}
<dialog class="sk-skrap" id="sk-skrap" tabindex="-1"
  data-fordrojning="{{ section.settings.fordrojning | default: 7 }}"
  data-vilodagar="{{ section.settings.vilodagar | default: 3 }}"
  data-skrapa-text="{{ section.settings.skrapa_text }}">
  <button type="button" class="sk-skrap__stang" data-sk-stang aria-label="{{ section.settings.stang }}">&times;</button>

  <div class="sk-skrap__steg" data-sk-steg="skrapa">
    <h2 class="sk-skrap__rubrik">{{ section.settings.rubrik_skrapa }}</h2>
    <p class="sk-skrap__under">{{ section.settings.under_skrapa }}</p>
    <div class="sk-skrap__kort">
      <div class="sk-skrap__vinst" aria-hidden="true">
        <span class="sk-skrap__procent">{{ section.settings.procent }}</span>
        <span class="sk-skrap__vinsttext">{{ section.settings.vinsttext }}</span>
      </div>
      <canvas class="sk-skrap__folie" width="840" height="450" aria-label="{{ section.settings.skrapyta }}"></canvas>
    </div>
    <p class="sk-skrap__ledtext">{{ section.settings.ledtext }}</p>
  </div>

  <div class="sk-skrap__steg" data-sk-steg="mejl" hidden>
    <h2 class="sk-skrap__rubrik">{{ section.settings.rubrik_mejl }}</h2>
    <p class="sk-skrap__under">{{ section.settings.under_mejl }}</p>
    {%- form 'customer', id: 'sk-skrap-form', class: 'sk-skrap__form' -%}
      {%- if form.posted_successfully? -%}<span data-sk-postad hidden></span>{%- endif -%}
      {%- if form.errors -%}<p class="sk-skrap__fel" data-sk-fel>{{ form.errors | default_errors }}</p>{%- endif -%}
      <input type="hidden" name="contact[tags]" value="newsletter,skrapkort">
      <div class="sk-skrap__falt">
        <input type="email" name="contact[email]" required autocomplete="email"
          autocapitalize="off" autocorrect="off"
          placeholder="{{ section.settings.mejl_platshallare }}" aria-label="{{ section.settings.mejl_platshallare }}">
        <button type="submit" class="sk-skrap__knapp">{{ section.settings.knapp_las }}</button>
      </div>
    {%- endform -%}
    <p class="sk-skrap__finstilt">
      {{ section.settings.finstilt_mejl }}
      <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ section.settings.integritet }}</a>
    </p>
  </div>

  <div class="sk-skrap__steg" data-sk-steg="klar" hidden>
    <h2 class="sk-skrap__rubrik">{{ section.settings.rubrik_klar }}</h2>
    <p class="sk-skrap__under">{{ section.settings.under_klar }}</p>
    <p class="sk-skrap__kod">{{ section.settings.rabattkod }}</p>
    <a class="sk-skrap__knapp sk-skrap__knapp--bred" href="/discount/{{ section.settings.rabattkod }}?redirect=/">
      {{ section.settings.knapp_handla }}
    </a>
    <p class="sk-skrap__finstilt">{{ section.settings.finstilt_klar }}</p>
  </div>
</dialog>
<style>
  /* Litar inte på att temat sätter border-box — utan den läggs paddingen
     utanpå 100vw och allt skjuts åt höger och klipps. */
  .sk-skrap, .sk-skrap *, .sk-skrap *::before, .sk-skrap *::after { box-sizing: border-box; }
  /* Fullskärm i butikens färg. Guldkortet är det enda att interagera med;
     krysset är medvetet lågmält men 44 px stort och alltid klickbart. */
  .sk-skrap {
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 24px;
    width: 100vw;
    height: 100vh;
    width: 100dvw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #FFFFFF;
    /* Gradient ur EN bakgrundsfärg: ljusare topp, mörkare botten. */
    background: #000000;
    background: linear-gradient(160deg,
      color-mix(in srgb, #000000 82%, white) 0%,
      #000000 55%,
      color-mix(in srgb, #000000 78%, black) 100%);
  }
  /* Entrén: snabb och mjuk — fade + litet lyft. Varje steg gör samma lilla
     resa när det visas, så även bytet skrapa → mejl glider. */
  @keyframes sk-skrap-in {
    from { opacity: 0; transform: translateY(14px) scale(.98); }
    to { opacity: 1; transform: none; }
  }
  .sk-skrap[open] { display: flex; animation: sk-skrap-in .28s cubic-bezier(.22, .9, .36, 1) both; }
  .sk-skrap[open] .sk-skrap__steg:not([hidden]) {
    animation: sk-skrap-in .34s cubic-bezier(.22, .9, .36, 1) both;
  }
  /* Vinsten gör en liten pop när guldet släpper. */
  @keyframes sk-skrap-pop {
    0% { transform: scale(.92); }
    55% { transform: scale(1.05); }
    100% { transform: none; }
  }
  .sk-skrap__kort[data-avslojad] .sk-skrap__vinst {
    animation: sk-skrap-pop .5s cubic-bezier(.22, .9, .36, 1) .2s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-skrap[open],
    .sk-skrap[open] .sk-skrap__steg:not([hidden]),
    .sk-skrap__kort[data-avslojad] .sk-skrap__vinst { animation: none; }
  }
  .sk-skrap::backdrop { background: rgba(0, 0, 0, .45); }
  /* Rubriken mäts mot RUTAN, inte skärmen — därför container-enheter. */
  .sk-skrap__steg { max-width: 520px; width: 100%; container-type: inline-size; }
  .sk-skrap__stang {
    position: fixed;
    top: 14px;
    right: 16px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    font-size: 30px;
    line-height: 1;
    color: #FFFFFF;
    opacity: .55;
    cursor: pointer;
    transition: opacity .15s ease;
  }
  .sk-skrap__stang:hover, .sk-skrap__stang:focus-visible { opacity: 1; }
  /* Många temans fokusring gör krysset till en vit låda — egen diskret ring. */
  .sk-skrap__stang:focus, .sk-skrap__stang:focus-visible, .sk-skrap__stang.focused {
    box-shadow: none;
    outline: 2px solid color-mix(in srgb, #FFFFFF 70%, transparent);
    outline-offset: 2px;
    border-radius: 8px;
  }
  .sk-skrap:focus, .sk-skrap:focus-visible { outline: none; box-shadow: none; }
  .sk-skrap__rubrik {
    margin: 0 0 8px;
    /* cqw = procent av rutans bredd. Med vw räknade rubriken på skärmen och
       tog ingen hänsyn till att rutan är smalare — då sprack långa ord. */
    font-size: clamp(1.35em, 7.6cqw, 2.5em);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .02em;
    /* Temat sätter word-break: break-word på rubriker. Det kapar långa ord
       mitt itu så sista bokstaven hamnar ensam på egen rad
       ("VÄLKOMSTRABAT / T"). Ord bryts aldrig — de får hellre krympa. */
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
    text-wrap: balance;
    color: #FFFFFF;
  }
  .sk-skrap__under { margin: 0 0 22px; color: #FFFFFF; opacity: .85; font-size: 1em; }
  .sk-skrap__kort {
    position: relative;
    width: min(84vw, 420px);
    aspect-ratio: 28 / 15;
    margin: 0 auto;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 0, 0, .35), 0 2px 8px rgba(0, 0, 0, .25);
  }
  .sk-skrap__vinst {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    background: #FFFFFF;
  }
  .sk-skrap__procent { font-size: 2.6em; font-weight: 800; color: #C9A227; }
  .sk-skrap__vinsttext { color: #5f5a52; }
  .sk-skrap__folie {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: crosshair;
    transition: opacity .5s ease;
  }
  .sk-skrap__folie[data-borta] { opacity: 0; pointer-events: none; }
  .sk-skrap__ledtext { margin: 16px 0 0; color: #FFFFFF; opacity: .75; font-size: .9em; }
  .sk-skrap__falt { display: flex; gap: 8px; }
  .sk-skrap__falt .sk-skrap__knapp { white-space: nowrap; }
  .sk-skrap__falt input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 13px 14px;
    border: 0;
    border-radius: 12px;
    font: inherit;
    background: #FFFFFF;
    color: #111111;
  }
  .sk-skrap__knapp {
    display: inline-block;
    padding: 13px 18px;
    border: 0;
    border-radius: 12px;
    /* Guldknapp som matchar kortet. */
    background: linear-gradient(180deg, #F2D879 0%, #DDB94B 55%, #C9A227 100%);
    color: #4A3506;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(0, 0, 0, .3);
    transition: filter .15s ease, transform .15s ease;
  }
  .sk-skrap__knapp:hover { filter: brightness(1.05); transform: translateY(-1px); }
  .sk-skrap__knapp--bred { display: block; }
  .sk-skrap__kod {
    margin: 0 auto 18px;
    padding: 12px;
    max-width: 300px;
    border: 2px dashed #F2D879;
    border-radius: 12px;
    background: color-mix(in srgb, #FFFFFF 12%, transparent);
    color: #FFFFFF;
    font-size: 1.4em;
    font-weight: 800;
    letter-spacing: .1em;
    user-select: all;
  }
  .sk-skrap__fel {
    margin: 0 0 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #FFFFFF;
    color: #b3261e;
    font-size: .9em;
  }
  .sk-skrap__finstilt { margin: 14px 0 0; font-size: .78em; color: #FFFFFF; opacity: .7; }
  .sk-skrap__finstilt a { color: inherit; }
</style>
<script>
  (function () {
    'use strict';
    var ruta = document.getElementById('sk-skrap');
    if (!ruta || !ruta.showModal) return;

    var NYCKEL = 'sk-skrapkort';
    var BESOK = 'sk-skrapkort-besok';
    var VILA_MS = Number(ruta.dataset.vilodagar || 3) * 86400000;
    function minns() { try { return localStorage.getItem(NYCKEL) || ''; } catch (e) { return ''; } }
    function spara(v) { try { localStorage.setItem(NYCKEL, v); } catch (e) { /* privat läge */ } }

    // Besöksspärren lever i sessionStorage: den följer med mellan sidbyten
    // i samma flik men nollas när kunden kommer tillbaka en annan gång.
    function visadIBesoket() { try { return sessionStorage.getItem(BESOK) === '1'; } catch (e) { return false; } }
    function markeraBesok() { try { sessionStorage.setItem(BESOK, '1'); } catch (e) { /* privat läge */ } }

    function steg(namn) {
      ruta.querySelectorAll('[data-sk-steg]').forEach(function (el) {
        el.hidden = el.dataset.skSteg !== namn;
      });
      passaRubrik();
    }

    // Sista skyddet mot fula radbrytningar: ord får aldrig kapas mitt itu
    // (det sköter CSS), men ett riktigt långt ord i ett brett typsnitt kan
    // ändå bli bredare än rutan. Då krymps rubriken tills den ryms, i stället
    // för att svämma över kanten. Max sex steg — sen är det texten som är fel.
    var passar = false, passningar = 0;
    function passaRubrik() {
      // Stängd dialog har bredden noll — mäter man då krymper rubriken i
      // onödan innan den ens visats. Taket är en spärr mot evighetsloopar
      // i teman vi aldrig sett.
      if (!ruta.open || passar || passningar > 30) return;
      var h = ruta.querySelector('[data-sk-steg]:not([hidden]) .sk-skrap__rubrik');
      if (!h) return;
      passar = true;
      passningar++;
      h.style.fontSize = '';
      for (var i = 0; i < 6 && h.scrollWidth > h.clientWidth + 1; i++) {
        h.style.fontSize = (parseFloat(getComputedStyle(h).fontSize) * 0.92) + 'px';
      }
      passar = false;
    }
    window.addEventListener('resize', passaRubrik);
    // Butikens typsnitt laddas asynkront och är ofta bredare än reservtypsnittet.
    // Slår det in efter att vi mätt växer texten och svämmar över kanten.
    // ResizeObserver duger inte: rubriken är alltid 100 % bred, så dess EGEN
    // storlek ändras aldrig — bara textens. Därför några efterkontroller.
    function passaSnart() {
      passaRubrik();
      [150, 600, 1500].forEach(function (ms) { setTimeout(passaRubrik, ms); });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(passaRubrik);
    }

    /* --- skrapfoliet ---------------------------------------------------- */
    var canvas = ruta.querySelector('.sk-skrap__folie');
    var ctx = canvas.getContext('2d');
    var skrapklar = false;

    function malaFolie() {
      // Guldfolie: gradient i guldtoner, sneda glansband, svaga skrapmärken
      // och präglad text — ljus kant ovanför, mörk under, som tryckt i guldet.
      var b = canvas.width, h = canvas.height;
      ctx.globalCompositeOperation = 'source-over';

      var g = ctx.createLinearGradient(0, 0, b, h);
      g.addColorStop(0, '#F1D77E');
      g.addColorStop(.35, '#E3BE55');
      g.addColorStop(.62, '#C9A227');
      g.addColorStop(1, '#E8C863');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, b, h);

      // Två sneda glansband.
      ctx.fillStyle = 'rgba(255, 250, 235, .28)';
      ctx.beginPath();
      ctx.moveTo(b * .12, 0); ctx.lineTo(b * .30, 0);
      ctx.lineTo(b * .06, h); ctx.lineTo(-b * .12, h);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = 'rgba(255, 250, 235, .16)';
      ctx.beginPath();
      ctx.moveTo(b * .78, 0); ctx.lineTo(b * .86, 0);
      ctx.lineTo(b * .62, h); ctx.lineTo(-b * .54 + b, h);
      ctx.closePath(); ctx.fill();

      // Svaga skrapmärken som bjuder in fingret.
      ctx.strokeStyle = 'rgba(140, 110, 20, .18)';
      ctx.lineCap = 'round';
      ctx.lineWidth = 16;
      [[.16, .30, .30, .22], [.20, .42, .36, .34], [.68, .68, .84, .60], [.72, .80, .86, .74]]
        .forEach(function (m) {
          ctx.beginPath();
          ctx.moveTo(b * m[0], h * m[1]);
          ctx.lineTo(b * m[2], h * m[3]);
          ctx.stroke();
        });

      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '800 64px sans-serif';
      // Präglingen: ljus kant snett ovanför, mörk text ovanpå.
      var skrapText = ruta.dataset.skrapaText || 'SKRAPA HÄR';
      ctx.fillStyle = 'rgba(255, 250, 235, .55)';
      ctx.fillText(skrapText, b / 2, h / 2 - 2);
      ctx.fillStyle = '#8A6A14';
      ctx.fillText(skrapText, b / 2, h / 2 + 2);
    }

    function andelBorta() {
      // Var 16:e pixel räcker som stickprov — exakthet spelar ingen roll här.
      var data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      var borta = 0, alla = 0;
      for (var i = 3; i < data.length; i += 64) {
        alla++;
        if (data[i] === 0) borta++;
      }
      return alla ? borta / alla : 0;
    }

    function skrapa(ev) {
      if (skrapklar) return;
      var rekt = canvas.getBoundingClientRect();
      var x = (ev.clientX - rekt.left) * (canvas.width / rekt.width);
      var y = (ev.clientY - rekt.top) * (canvas.height / rekt.height);
      ctx.globalCompositeOperation = 'destination-out';
      ctx.beginPath();
      ctx.arc(x, y, 50, 0, Math.PI * 2);
      ctx.fill();
      if (andelBorta() > 0.4) {
        skrapklar = true;
        canvas.setAttribute('data-borta', '');
        canvas.parentNode.setAttribute('data-avslojad', '');
        spara('skrapad');
        // Låt vinsten sjunka in innan mejlsteget glider fram — foliet tonar
        // på 0,5 s och kunden ska hinna LÄSA vad den skrapat fram.
        setTimeout(function () { steg('mejl'); }, 1600);
      }
    }

    var drar = false;
    canvas.addEventListener('pointerdown', function (ev) {
      drar = true;
      canvas.setPointerCapture(ev.pointerId);
      skrapa(ev);
    });
    canvas.addEventListener('pointermove', function (ev) { if (drar) skrapa(ev); });
    canvas.addEventListener('pointerup', function () { drar = false; });

    /* --- öppna/stäng ----------------------------------------------------- */
    function oppna(stegnamn) {
      steg(stegnamn);
      if (stegnamn !== 'skrapa') canvas.setAttribute('data-borta', '');
      else malaFolie();
      ruta.showModal();
      // showModal fokuserar annars stängkrysset — då lyser temats fokusring
      // upp krysset som det första man ser. Dialogen tar fokuset i stället.
      ruta.focus();
      passaSnart();
      // Minnet skrivs HÄR, i samma stund som kunden får se popupen — inte
      // först när den stängs. Kunden som bara klickar vidare till nästa sida
      // stänger aldrig något, och utan den här raden mötte samma popup hen
      // på varje ny sida i butiken.
      markeraBesok();
      var f = minns();
      if (f !== 'klar' && f !== 'skrapad' && f.indexOf('vila:') !== 0) spara('visad:' + Date.now());
    }

    // Stängning utan medlemskap = vila. Klart läge förblir klart.
    function vilaEllerKlar() {
      if (minns() === 'klar') return;
      if (minns() === 'skrapad') return; // mejlsteget återkommer nästa besök
      spara('vila:' + Date.now());
    }
    ruta.querySelector('[data-sk-stang]').addEventListener('click', function () { ruta.close(); });
    ruta.addEventListener('close', vilaEllerKlar);
    ruta.addEventListener('click', function (ev) {
      // Klick med target = dialogen är två olika saker: bakgrunden ELLER
      // dialogens egen padding. Bara äkta bakgrundsklick får stänga —
      // annars kan ivriga skrapfingrar stänga popupen på paddingen precis
      // när mejlsteget kommer fram. I fullskärm finns ingen bakgrund, så
      // kollen är vilande — men den skyddar om dialogen görs mindre.
      if (ev.target !== ruta) return;
      var r = ruta.getBoundingClientRect();
      if (ev.clientX < r.left || ev.clientX > r.right || ev.clientY < r.top || ev.clientY > r.bottom) {
        ruta.close();
      }
    });

    /* --- vad ska hända vid sidladdning? ---------------------------------- */
    var lage = minns();

    // Mejlen skickades nyss: Shopify har laddat om sidan, flaggan finns bara
    // om det var VÅRT formulär som postade.
    if (ruta.querySelector('[data-sk-postad]')) {
      spara('klar');
      oppna('klar');
      return;
    }
    if (ruta.querySelector('[data-sk-fel]')) {
      oppna('mejl');
      return;
    }

    // Sedd en gång under besöket = klart för i dag. Gäller ALLA lägen, så
    // popupen aldrig möter samma kund två gånger på en shoppingrunda.
    if (visadIBesoket()) return;

    if (lage === 'klar') return;
    if (lage.indexOf('vila:') === 0) {
      var sedan = Number(lage.slice(5));
      if (Date.now() - sedan < VILA_MS) return;
    }
    // Sedd men obesvarad i ett tidigare besök: vila lika länge som ett nej.
    if (lage.indexOf('visad:') === 0) {
      var sett = Number(lage.slice(6));
      if (Date.now() - sett < VILA_MS) return;
    }

    setTimeout(function () {
      oppna(lage === 'skrapad' ? 'mejl' : 'skrapa');
    }, Number(ruta.dataset.fordrojning || 7) * 1000);
  })();
</script>

{% schema %}
{
  "name": "Skrapkort",
  "settings": [
    {
      "type": "range",
      "id": "fordrojning",
      "label": "Sekunder innan popupen visas",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "vilodagar",
      "label": "Vilodagar efter nej/obesvarad",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "rabattkod",
      "label": "Rabattkod",
      "default": "VELKOMMEN10"
    },
    {
      "type": "text",
      "id": "procent",
      "label": "Procenttext på kortet",
      "default": "10 %"
    },
    {
      "type": "text",
      "id": "rubrik_skrapa",
      "label": "Rubrik – skrapa",
      "default": "Skrab din velkomstrabat frem"
    },
    {
      "type": "text",
      "id": "under_skrapa",
      "label": "Undertext – skrapa",
      "default": "Alle vinder – guldet skjuler din rabat."
    },
    {
      "type": "text",
      "id": "vinsttext",
      "label": "Text under procenten",
      "default": "rabat på dit køb"
    },
    {
      "type": "text",
      "id": "ledtext",
      "label": "Ledtext under kortet",
      "default": "Træk fingeren hen over guldet"
    },
    {
      "type": "text",
      "id": "skrapa_text",
      "label": "Text på guldytan (VERSALER)",
      "default": "SKRAB HER"
    },
    {
      "type": "text",
      "id": "rubrik_mejl",
      "label": "Rubrik – mejlsteg",
      "default": "Du skrabede 10&nbsp;% frem! 🎉"
    },
    {
      "type": "text",
      "id": "under_mejl",
      "label": "Undertext – mejlsteg",
      "default": "Angiv din mail, så låser du op for koden — den virker med det samme."
    },
    {
      "type": "text",
      "id": "mejl_platshallare",
      "label": "Platshållare i mejlfältet",
      "default": "din@email.dk"
    },
    {
      "type": "text",
      "id": "knapp_las",
      "label": "Knapp – lås upp",
      "default": "Lås koden op"
    },
    {
