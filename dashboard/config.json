{
  "timezone": "Europe/Stockholm",

  "workday": {
    "start": "09:00",
    "end": "17:00",
    "lunchMinutes": 60,
    "days": [1, 2, 3, 4, 5]
  },

  "holidays": [
    "2026-01-01", "2026-01-06", "2026-04-03", "2026-04-06",
