    "brief": { "label": "Otydlig eller felaktig brief", "attributable": false },
    "scope-change": { "label": "Vi ändrade oss", "attributable": false },
    "preference": { "label": "Smakändring från beställare", "attributable": false }
  },

  "slack": {
    "channel": "#redigering",
    "dmNudges": true,
    "overdueHours": 0,
    "revisionWaitingHours": 8,
    "stalledHours": 16
